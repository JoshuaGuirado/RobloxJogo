  <Item class="ServerScriptService" referent="3">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Dados</string>
        <string name="Source"><![CDATA[--[[
	ROUBE UM HERÓI - Salvamento de dados (DataStore) e ranking global

	Onde colocar: ServerScriptService -> ModuleScript (nome: Dados)

	IMPORTANTE: para salvar no Studio, publique o jogo e ative
	Configurações do jogo > Segurança > "Permitir acesso do Studio aos serviços de API".
	Sem isso o jogo funciona normalmente, só não salva o progresso.
]]

local DataStoreService = game:GetService("DataStoreService")

local Dados = {}
Dados.desativado = false
Dados.motivo = ""

local loja = nil
local ordenados = {}

local CATEGORIAS = { "Dinheiro", "Roubos", "Renascimentos" }

function Dados.padrao()
	return {
		versao = 1,
		dinheiro = 0,
		totalGanho = 0,
		renascimentos = 0,
		roubos = 0,
		niveis = { Velocidade = 0, Pedestais = 0, Tranca = 0, Coletor = 0 },
		herois = {}, -- { {slot = 1, id = "FormigaAtomica", mut = "Normal"}, ... }
		descobertos = {}, -- [id] = true
		luvas = { Basica = true }, -- [id] = true
		luvaEquipada = "Basica",
		ultimaRoleta = 0,
		ultimaDiaria = 0,
		sequenciaDiaria = 0,
		ultimoLogin = 0,
		tutorial = false,
		config = { musica = true, sons = true },
	}
end

local function copiar(valor)
	if type(valor) ~= "table" then
		return valor
	end
	local copia = {}
	for chave, item in valor do
		copia[chave] = copiar(item)
	end
	return copia
end

-- Completa campos que não existiam em saves antigos
local function reconciliar(dados, padrao)
	for chave, valor in padrao do
		if dados[chave] == nil then
			dados[chave] = copiar(valor)
		elseif type(valor) == "table" and type(dados[chave]) == "table" and next(valor) ~= nil and #valor == 0 then
			reconciliar(dados[chave], valor)
		end
	end
end

local function erroSemAcesso(mensagem)
	mensagem = tostring(mensagem)
	return mensagem:find("403") ~= nil
		or mensagem:find("StudioAccessToApisNotAllowed") ~= nil
		or mensagem:find("publish") ~= nil
		or mensagem:find("API Services") ~= nil
end

local function desativar(motivo)
	if not Dados.desativado then
		warn("[Dados] Salvamento desativado: " .. tostring(motivo))
	end
	Dados.desativado = true
	Dados.motivo = tostring(motivo)
end

function Dados.iniciar(Config)
	if not Config.Geral.SalvarDados then
		desativar("SalvarDados = false no ConfigHerois")
		return
	end
	local ok, resultado = pcall(function()
		return DataStoreService:GetDataStore(Config.Geral.NomeDataStore)
	end)
	if not ok then
		desativar(resultado)
		return
	end
	loja = resultado
	for _, categoria in CATEGORIAS do
		local ok2, ordenado = pcall(function()
			return DataStoreService:GetOrderedDataStore(Config.Geral.NomeDataStore .. "_Rank_" .. categoria)
		end)
		if ok2 then
			ordenados[categoria] = ordenado
		end
	end
end

local function chave(userId)
	return "Jogador_" .. tostring(userId)
end

-- Retorna (dados, conseguiuCarregar). Se não conseguir, o jogo não salva por cima.
function Dados.carregar(userId)
	local padrao = Dados.padrao()
	if Dados.desativado or not loja then
		return padrao, false
	end
	for tentativa = 1, 3 do
		local ok, resultado = pcall(function()
			return loja:GetAsync(chave(userId))
		end)
		if ok then
			if type(resultado) == "table" then
				reconciliar(resultado, padrao)
				return resultado, true
			end
			return padrao, true -- jogador novo
		end
		warn(string.format("[Dados] Erro ao carregar %s (tentativa %d): %s", tostring(userId), tentativa, tostring(resultado)))
		if erroSemAcesso(resultado) then
			desativar(resultado)
			break
		end
		task.wait(1.5)
	end
	return padrao, false
end

function Dados.salvar(userId, dados)
	if Dados.desativado or not loja then
		return false
	end
	for tentativa = 1, 3 do
		local ok, erro = pcall(function()
			loja:UpdateAsync(chave(userId), function()
				return dados
			end)
		end)
		if ok then
			return true
		end
		warn(string.format("[Dados] Erro ao salvar %s (tentativa %d): %s", tostring(userId), tentativa, tostring(erro)))
		if erroSemAcesso(erro) then
			desativar(erro)
			return false
		end
		task.wait(1.5)
	end
	return false
end

-- valores = { Dinheiro = n, Roubos = n, Renascimentos = n }
function Dados.atualizarRanking(userId, valores)
	if Dados.desativado or userId <= 0 then
		return
	end
	for categoria, valor in valores do
		local ordenado = ordenados[categoria]
		if ordenado and valor > 0 then
			local inteiro = math.floor(math.min(valor, 9e15))
			pcall(function()
				ordenado:SetAsync(tostring(userId), inteiro)
			end)
		end
	end
end

-- Retorna lista { {userId = n, valor = n}, ... } ou nil se indisponível
function Dados.obterTop(categoria, quantidade)
	if Dados.desativado then
		return nil
	end
	local ordenado = ordenados[categoria]
	if not ordenado then
		return nil
	end
	local ok, pagina = pcall(function()
		return ordenado:GetSortedAsync(false, quantidade):GetCurrentPage()
	end)
	if not ok then
		warn("[Dados] Erro no ranking " .. categoria .. ": " .. tostring(pagina))
		return nil
	end
	local lista = {}
	for _, item in pagina do
		table.insert(lista, { userId = tonumber(item.key) or 0, valor = item.value })
	end
	return lista
end

return Dados
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">JogoHerois</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	ROUBE UM HERÓI - Script principal do servidor

	Onde colocar: ServerScriptService -> Script (nome: JogoHerois)
	Precisa também de: ServerScriptService/Mapa, ServerScriptService/Dados,
	ServerScriptService/ModelosHerois e ReplicatedStorage/ConfigHerois (ModuleScripts).

	Cuida de toda a lógica do jogo:
	  - heróis saindo do portal e andando pela passarela (com mutações)
	  - compra, renda por segundo, coleta nos pedestais, venda
	  - roubo (segurar E), carregar o herói até a sua base, Luva Heroica (5 níveis)
	  - bases de 3 andares com elevador, tenda da Loja e Roleta da Sorte
	  - tranca da base, melhorias, renascimento, recompensa diária
	  - eventos, ciclo dia/noite, coroa do mais rico
	  - salvamento (DataStore), ranking global e compras com Robux
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPack = game:GetService("StarterPack")
local MarketplaceService = game:GetService("MarketplaceService")
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("ConfigHerois"))
local Mapa = require(script.Parent:WaitForChild("Mapa"))
local Dados = require(script.Parent:WaitForChild("Dados"))
local Modelos = require(script.Parent:WaitForChild("ModelosHerois"))

local G = Config.Geral
local formatar = Config.formatar

local NOME_LUVA = "Luva Heroica"

local function ordemRaridade(id)
	local raridade = Config.RaridadePorId[id] or Config.Raridades[#Config.Raridades]
	return raridade.ordem
end
local ORDEM_ANUNCIO_SPAWN = ordemRaridade(G.AnunciarSpawnAPartirDe)
local ORDEM_ANUNCIO_COMPRA = ordemRaridade(G.AnunciarCompraAPartirDe)
local ORDEM_ANUNCIO_ROUBO = ordemRaridade(G.AnunciarRouboAPartirDe)
local ORDEM_LENDARIO = ordemRaridade("Lendario")

--------------------------------------------------------------------------
-- COMUNICAÇÃO COM OS JOGADORES (RemoteEvents)
--------------------------------------------------------------------------
local antigos = ReplicatedStorage:FindFirstChild("RemotesHerois")
if antigos then
	antigos:Destroy()
end
local remotes = Instance.new("Folder")
remotes.Name = "RemotesHerois"
local function criarRemoto(classe, nome)
	local remoto = Instance.new(classe)
	remoto.Name = nome
	remoto.Parent = remotes
	return remoto
end
local Notificar = criarRemoto("RemoteEvent", "Notificar")
local Anuncio = criarRemoto("RemoteEvent", "Anuncio")
local Efeito = criarRemoto("RemoteEvent", "Efeito")
local Empurrao = criarRemoto("RemoteEvent", "Empurrao")
local Acao = criarRemoto("RemoteFunction", "Acao")
local ObterRanking = criarRemoto("RemoteFunction", "ObterRanking")
local AbrirLoja = criarRemoto("RemoteEvent", "AbrirLoja")
local RoletaGiro = criarRemoto("RemoteEvent", "RoletaGiro")
remotes.Parent = ReplicatedStorage

--------------------------------------------------------------------------
-- MAPA E ESTADO
--------------------------------------------------------------------------
Dados.iniciar(Config)
local mapa = Mapa.construir(Config, Modelos)
local bases = mapa.bases

local sessoes = {} -- [jogador] = sessão (dados salvos + base + controles)
local herois = {} -- [modelo] = herói
local carregando = {} -- [jogador] = herói que ele está roubando
local eventoAtual = nil
local tokenEvento = 0
local rankingGlobal = { disponivel = false, Dinheiro = {}, Roubos = {}, Renascimentos = {} }

--------------------------------------------------------------------------
-- AJUDANTES
--------------------------------------------------------------------------
local function notificar(jogador, mensagem, tipo)
	if jogador and jogador.Parent then
		Notificar:FireClient(jogador, mensagem, tipo or "info")
	end
end

local function anunciar(mensagem, cor)
	Anuncio:FireAllClients(mensagem, cor or Color3.fromRGB(255, 200, 40))
end

local function efeito(jogador, tipo, ...)
	if jogador and jogador.Parent then
		Efeito:FireClient(jogador, tipo, ...)
	end
end

local function multEvento(campo)
	if eventoAtual and eventoAtual[campo] then
		return eventoAtual[campo]
	end
	return 1
end

local function humanoidDe(jogador)
	local personagem = jogador.Character
	return personagem and personagem:FindFirstChildOfClass("Humanoid")
end

local function raizDe(jogador)
	local personagem = jogador.Character
	local raiz = personagem and personagem:FindFirstChild("HumanoidRootPart")
	if raiz and raiz:IsA("BasePart") then
		return raiz
	end
	return nil
end

local function dentroDaBase(base, posicao)
	local local_ = base.cframe:PointToObjectSpace(posicao)
	return math.abs(local_.X) <= Mapa.METADE_BASE and math.abs(local_.Z) <= Mapa.METADE_BASE
end

--------------------------------------------------------------------------
-- DINHEIRO E ATRIBUTOS DO JOGADOR
--------------------------------------------------------------------------
local function nivel(jogador, id)
	local sessao = sessoes[jogador]
	return sessao and (sessao.dados.niveis[id] or 0) or 0
end

local function velocidadeJogador(jogador)
	local velocidade = Config.velocidadeDoNivel(nivel(jogador, "Velocidade"))
	local sessao = sessoes[jogador]
	if sessao and os.time() < (sessao.boostVelocidadeAte or 0) then
		velocidade *= 1.5
	end
	return velocidade
end

-- Aplica velocidade e pulo (Mola Turbo, bônus da roleta e peso do herói roubado)
local function aplicarMovimento(jogador)
	local humanoid = humanoidDe(jogador)
	if not humanoid then
		return
	end
	local velocidade = velocidadeJogador(jogador)
	if carregando[jogador] then
		velocidade *= G.MultiplicadorCarregando
	end
	humanoid.WalkSpeed = velocidade
	local pulo = Config.puloDoNivel(nivel(jogador, "Velocidade"))
	humanoid.JumpHeight = pulo
	humanoid.JumpPower = math.sqrt(2 * workspace.Gravity * pulo)
end

local function pedestaisJogador(jogador)
	return Config.pedestaisDoNivel(nivel(jogador, "Pedestais"))
end

local function multiplicadorJogador(jogador)
	local sessao = sessoes[jogador]
	if not sessao then
		return 1
	end
	local multiplicador = Config.multiplicadorRenascimento(sessao.dados.renascimentos)
	if sessao.passeDobro then
		multiplicador *= 2
	end
	if os.time() < (sessao.boostRendaAte or 0) then
		multiplicador *= 2
	end
	return multiplicador
end

local function atualizarDinheiro(jogador)
	local sessao = sessoes[jogador]
	if not sessao then
		return
	end
	jogador:SetAttribute("Dinheiro", sessao.dados.dinheiro)
	sessao.statDinheiro.Value = math.floor(math.min(sessao.dados.dinheiro, 9e18))
end

local function atualizarAtributos(jogador)
	local sessao = sessoes[jogador]
	if not sessao then
		return
	end
	local d = sessao.dados
	atualizarDinheiro(jogador)
	jogador:SetAttribute("Renascimentos", d.renascimentos)
	jogador:SetAttribute("Multiplicador", multiplicadorJogador(jogador))
	jogador:SetAttribute("Roubos", d.roubos)
	for id, valor in d.niveis do
		jogador:SetAttribute("Nivel" .. id, valor)
	end
	jogador:SetAttribute("UltimaDiaria", d.ultimaDiaria)
	jogador:SetAttribute("SequenciaDiaria", d.sequenciaDiaria)
	jogador:SetAttribute("TutorialFeito", d.tutorial)
	jogador:SetAttribute("Musica", d.config.musica)
	jogador:SetAttribute("Sons", d.config.sons)
	jogador:SetAttribute("PasseDobro", sessao.passeDobro == true)
	jogador:SetAttribute("BaseIndice", sessao.base and sessao.base.indice or 0)
	local descobertos = {}
	for id in d.descobertos do
		table.insert(descobertos, id)
	end
	jogador:SetAttribute("Descobertos", HttpService:JSONEncode(descobertos))
	local luvas = {}
	for id in d.luvas do
		table.insert(luvas, id)
	end
	jogador:SetAttribute("Luvas", HttpService:JSONEncode(luvas))
	jogador:SetAttribute("LuvaEquipada", d.luvaEquipada)
	jogador:SetAttribute("UltimaRoleta", d.ultimaRoleta)
	jogador:SetAttribute("BoostRenda", sessao.boostRendaAte or 0)
	jogador:SetAttribute("BoostVelocidade", sessao.boostVelocidadeAte or 0)
	sessao.statRoubos.Value = d.roubos
	sessao.statRenascimentos.Value = d.renascimentos
end

local function ganhar(jogador, valor)
	local sessao = sessoes[jogador]
	if not sessao or valor <= 0 then
		return
	end
	sessao.dados.dinheiro += valor
	sessao.dados.totalGanho += valor
	atualizarDinheiro(jogador)
end

local function gastar(jogador, valor)
	local sessao = sessoes[jogador]
	if not sessao or sessao.dados.dinheiro < valor then
		return false
	end
	sessao.dados.dinheiro -= valor
	atualizarDinheiro(jogador)
	return true
end

local function descobrir(jogador, def)
	local sessao = sessoes[jogador]
	if sessao and not sessao.dados.descobertos[def.id] then
		sessao.dados.descobertos[def.id] = true
		atualizarAtributos(jogador)
		notificar(jogador, "📖 Novo herói no Índice: " .. def.nome .. "!", "especial")
	end
end

--------------------------------------------------------------------------
-- HERÓIS: CRIAR, REMOVER, BOTÕES (ProximityPrompt)
--------------------------------------------------------------------------
local function valorHeroi(h)
	return h.def.preco * h.mutacao.multiplicador
end

local function rendaHeroi(h)
	return h.def.renda * h.mutacao.multiplicador
end

local function nomeCompleto(h)
	if h.mutacao.id ~= "Normal" then
		return h.def.nome .. " " .. h.mutacao.nome
	end
	return h.def.nome
end

local function novoHeroi(def, mutacaoId)
	local mutacao = Config.MutacaoPorId[mutacaoId] or Config.MutacaoPorId.Normal
	local modelo, raiz = Modelos.heroi(def, mutacao, Config)
	modelo.Parent = mapa.pastaHerois
	local raridade = Config.RaridadePorId[def.raridade]
	local h = {
		modelo = modelo,
		raiz = raiz,
		def = def,
		mutacao = mutacao,
		raridade = raridade,
		altura = 2.03 * raridade.escala, -- distância do tronco até a sola da bota
		estado = "novo", -- novo | andando | indo | base | carregado | removido
		distancia = 0,
	}
	herois[modelo] = h
	return h
end

local function removerHeroi(h)
	h.estado = "removido"
	herois[h.modelo] = nil
	h.modelo:Destroy()
end

local function limparPrompts(h)
	for _, filho in h.raiz:GetChildren() do
		if filho:IsA("ProximityPrompt") then
			filho:Destroy()
		end
	end
end

local function criarPrompt(h, nome, acao, objeto, tecla, segurar, aoAtivar)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = nome
	prompt.ActionText = acao
	prompt.ObjectText = objeto
	prompt.KeyboardKeyCode = tecla
	prompt.HoldDuration = segurar
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = h.raiz
	prompt.Triggered:Connect(function(jogador)
		aoAtivar(h, jogador)
	end)
	return prompt
end

--------------------------------------------------------------------------
-- BASES: PEDESTAIS, COLETA E TRANCA
--------------------------------------------------------------------------
local function slotLivre(base, quantidade)
	for i = 1, math.min(quantidade, #base.slots) do
		local slot = base.slots[i]
		if not slot.heroi then
			return slot
		end
	end
	return nil
end

local function atualizarPad(slot)
	if slot.acumulado >= 1 then
		slot.guiPad.Enabled = true
		slot.textoPad.Text = "💰 " .. formatar(slot.acumulado)
	else
		slot.guiPad.Enabled = false
	end
end

local function atualizarSlots(base)
	local dono = base.dono
	local liberados = dono and pedestaisJogador(dono) or #base.slots
	for i, slot in base.slots do
		local liberado = i <= liberados
		slot.pedestal.Transparency = liberado and 0 or 0.65
		slot.anel.Color = liberado and base.cor or Color3.fromRGB(90, 90, 100)
		slot.pad.Transparency = liberado and 0 or 1
		slot.guiCadeado.Enabled = dono ~= nil and not liberado
	end
end

local function atualizarBarreira(base)
	local trancada = os.clock() < base.trancadaAte
	base.barreira.CanCollide = trancada
	base.barreira.Transparency = trancada and 0.45 or 1
end

local function trancarBase(base, jogador)
	local agora = os.clock()
	if agora < base.recargaAte then
		return
	end
	local duracao = Config.trancaDoNivel(nivel(jogador, "Tranca"))
	base.trancadaAte = agora + duracao
	base.recargaAte = base.trancadaAte + G.RecargaTranca
	atualizarBarreira(base)

	-- Quem estava dentro é jogado para fora
	for _, outro in Players:GetPlayers() do
		local raiz = raizDe(outro)
		if outro ~= jogador and raiz and outro.Character and dentroDaBase(base, raiz.Position) then
			outro.Character:PivotTo(base.saida)
			notificar(outro, "🔒 A base foi trancada e você foi expulso!", "aviso")
		end
	end
	notificar(jogador, "🔒 Base trancada por " .. duracao .. " segundos!", "sucesso")
	efeito(jogador, "som", "compra")
end

-- Tira todos os heróis de uma base (quando o dono sai ou renasce)
local function limparHeroisDaBase(base)
	for _, slot in base.slots do
		local h = slot.heroi
		if h then
			if h.estado == "carregado" then
				if h.slot == slot then
					-- alguém está roubando: o ladrão continua com ele
					slot.heroi = nil
					h.base = nil
					h.slot = nil
				end
			else
				slot.heroi = nil
				removerHeroi(h)
			end
		end
		slot.acumulado = 0
		atualizarPad(slot)
	end
end

--------------------------------------------------------------------------
-- COLOCAR NA BASE, ROUBAR, DEVOLVER, ENTREGAR
--------------------------------------------------------------------------
local aoRoubar, aoVender -- definidas mais abaixo

local function colocarNaBase(h, base, slot, animar)
	limparPrompts(h)
	slot.heroi = h
	h.base = base
	h.slot = slot
	h.modelo:SetAttribute("DonoId", base.dono and base.dono.UserId or 0)
	h.raiz.Anchored = true

	local destino = slot.topo * CFrame.new(0, h.altura, 0)
	local valorVenda = math.floor(valorHeroi(h) * G.PorcentagemVenda)

	local function finalizar()
		h.estado = "base"
		h.raiz.CFrame = destino
		criarPrompt(h, "PromptRoubar", "Roubar", nomeCompleto(h), Enum.KeyCode.E, G.TempoParaRoubar, aoRoubar)
		criarPrompt(h, "PromptVender", "Vender por " .. formatar(valorVenda), nomeCompleto(h), Enum.KeyCode.F, 0.6, aoVender)
	end

	if animar then
		h.estado = "indo"
		local tween = TweenService:Create(h.raiz, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { CFrame = destino })
		tween.Completed:Connect(function()
			if h.estado == "indo" and h.slot == slot then
				finalizar()
			end
		end)
		tween:Play()
	else
		finalizar()
	end
end

local function marcarLadrao(jogador, ligar)
	local personagem = jogador.Character
	if not personagem then
		return
	end
	local marca = personagem:FindFirstChild("MarcaLadrao")
	if ligar and not marca then
		local destaque = Instance.new("Highlight")
		destaque.Name = "MarcaLadrao"
		destaque.FillColor = Color3.fromRGB(255, 40, 40)
		destaque.FillTransparency = 0.75
		destaque.OutlineColor = Color3.fromRGB(255, 60, 60)
		destaque.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		destaque.Parent = personagem
	elseif not ligar and marca then
		marca:Destroy()
	end
end

-- Solta o herói das costas do ladrão. Retorna o pedestal que estava reservado na base do ladrão.
local function terminarCarregar(h)
	local ladrao = h.ladrao
	if h.conexaoMorte then
		h.conexaoMorte:Disconnect()
		h.conexaoMorte = nil
	end
	h.raiz.Anchored = true
	local solda = h.raiz:FindFirstChild("SoldaRoubo")
	if solda then
		solda:Destroy()
	end
	if ladrao then
		carregando[ladrao] = nil
		marcarLadrao(ladrao, false)
		ladrao:SetAttribute("Carregando", nil)
		aplicarMovimento(ladrao)
	end
	h.ladrao = nil
	local slotDestino = h.slotDestino
	h.slotDestino = nil
	return slotDestino
end

-- O roubo falhou: o herói volta para o pedestal de onde saiu
local function devolver(h, motivo)
	if h.estado ~= "carregado" then
		return
	end
	local ladrao = h.ladrao
	local slotDestino = terminarCarregar(h)
	if slotDestino and slotDestino.heroi == h then
		slotDestino.heroi = nil
	end
	if not h.base or not h.base.dono or not h.slot then
		removerHeroi(h) -- o dono saiu ou renasceu
		return
	end
	colocarNaBase(h, h.base, h.slot, false)
	if motivo and ladrao then
		notificar(ladrao, motivo, "erro")
	end
	notificar(h.base.dono, "🛡️ Seu " .. nomeCompleto(h) .. " voltou para a base!", "sucesso")
end

-- O ladrão chegou na própria base: o herói agora é dele
local function entregar(h)
	local ladrao = h.ladrao
	local donoAntigo = h.base and h.base.dono
	local slotDestino = terminarCarregar(h)
	if h.slot and h.slot.heroi == h then
		h.slot.heroi = nil
	end
	colocarNaBase(h, slotDestino.base, slotDestino, false)

	local sessao = sessoes[ladrao]
	if sessao then
		sessao.dados.roubos += 1
		atualizarAtributos(ladrao)
	end
	descobrir(ladrao, h.def)
	notificar(ladrao, "🦹 Você roubou " .. nomeCompleto(h) .. "!", "sucesso")
	efeito(ladrao, "som", "compra")
	if donoAntigo then
		notificar(donoAntigo, "😱 " .. ladrao.DisplayName .. " roubou seu " .. nomeCompleto(h) .. "!", "erro")
	end
	if h.raridade.ordem >= ORDEM_ANUNCIO_ROUBO then
		anunciar("🦹 " .. ladrao.DisplayName .. " roubou " .. nomeCompleto(h) .. " (" .. h.raridade.nome .. ")!", h.raridade.cor)
	end
end

local function verificarCarregado(h)
	local ladrao = h.ladrao
	local raiz = ladrao and raizDe(ladrao)
	if not raiz or not h.slotDestino then
		devolver(h, "Você perdeu o herói!")
		return
	end
	if dentroDaBase(h.slotDestino.base, raiz.Position) then
		entregar(h)
		return
	end
	if G.RecuperarEncostando then
		local dono = h.base and h.base.dono
		local raizDono = dono and raizDe(dono)
		if raizDono and (raizDono.Position - raiz.Position).Magnitude < 6 then
			devolver(h, dono.DisplayName .. " pegou o herói de volta!")
		end
	end
end

function aoRoubar(h, ladrao)
	if h.estado ~= "base" then
		return
	end
	local base = h.base
	if not base or base.dono == ladrao then
		return
	end
	local sessao = sessoes[ladrao]
	if not sessao or not sessao.base then
		notificar(ladrao, "Você precisa de uma base para roubar.", "erro")
		return
	end
	if carregando[ladrao] then
		notificar(ladrao, "Você já está carregando um herói!", "aviso")
		return
	end
	if os.clock() < base.trancadaAte then
		notificar(ladrao, "🔒 Esta base está trancada!", "erro")
		return
	end
	local slotDestino = slotLivre(sessao.base, pedestaisJogador(ladrao))
	if not slotDestino then
		notificar(ladrao, "Sua base está cheia! Venda um herói ou compre mais pedestais.", "aviso")
		return
	end
	local raiz = raizDe(ladrao)
	local humanoid = humanoidDe(ladrao)
	if not raiz or not humanoid or humanoid.Health <= 0 then
		return
	end

	limparPrompts(h)
	slotDestino.heroi = h -- reserva o pedestal na base do ladrão
	h.slotDestino = slotDestino
	h.estado = "carregado"
	h.ladrao = ladrao
	carregando[ladrao] = h

	-- Gruda o herói em cima da cabeça do ladrão
	h.raiz.CFrame = raiz.CFrame * CFrame.new(0, 3.2 + h.altura, 0)
	local solda = Instance.new("WeldConstraint")
	solda.Name = "SoldaRoubo"
	solda.Part0 = raiz
	solda.Part1 = h.raiz
	solda.Parent = h.raiz
	h.raiz.Anchored = false

	aplicarMovimento(ladrao)
	h.conexaoMorte = humanoid.Died:Connect(function()
		devolver(h, "💀 Você caiu e perdeu o herói!")
	end)
	marcarLadrao(ladrao, true)
	ladrao:SetAttribute("Carregando", nomeCompleto(h))

	notificar(ladrao, "🏃 Corra para a sua base!", "aviso")
	if base.dono then
		efeito(base.dono, "alarme", ladrao.DisplayName, nomeCompleto(h))
	end
end

function aoVender(h, jogador)
	if h.estado ~= "base" or not h.base or h.base.dono ~= jogador then
		return
	end
	local valor = math.floor(valorHeroi(h) * G.PorcentagemVenda)
	h.slot.heroi = nil
	removerHeroi(h)
	ganhar(jogador, valor)
	notificar(jogador, "💵 Vendido por " .. formatar(valor) .. "!", "sucesso")
	efeito(jogador, "som", "moeda")
end

local function aoComprar(h, jogador)
	if h.estado ~= "andando" then
		return
	end
	local sessao = sessoes[jogador]
	if not sessao or not sessao.base then
		notificar(jogador, "Você precisa de uma base para comprar.", "erro")
		return
	end
	local preco = valorHeroi(h)
	if sessao.dados.dinheiro < preco then
		notificar(jogador, "💸 Dinheiro insuficiente! Custa " .. formatar(preco), "erro")
		return
	end
	local slot = slotLivre(sessao.base, pedestaisJogador(jogador))
	if not slot then
		notificar(jogador, "Sua base está cheia! Venda um herói ou compre mais pedestais na Loja.", "aviso")
		return
	end
	gastar(jogador, preco)
	colocarNaBase(h, sessao.base, slot, true)
	descobrir(jogador, h.def)
	notificar(jogador, "✅ Você comprou " .. nomeCompleto(h) .. "!", "sucesso")
	efeito(jogador, "som", "compra")
	if h.raridade.ordem >= ORDEM_ANUNCIO_COMPRA then
		anunciar("🤑 " .. jogador.DisplayName .. " comprou " .. nomeCompleto(h) .. " (" .. h.raridade.nome .. ")!", h.raridade.cor)
	end
end

--------------------------------------------------------------------------
-- PASSARELA
--------------------------------------------------------------------------
local function colocarNaPassarela(h)
	h.estado = "andando"
	h.distancia = 0
	local posicao = mapa.inicio + Vector3.new(0, h.altura, 0)
	h.raiz.CFrame = CFrame.lookAt(posicao, posicao + Vector3.xAxis)
	criarPrompt(h, "PromptComprar", "Comprar por " .. formatar(valorHeroi(h)), nomeCompleto(h), Enum.KeyCode.E, 0, aoComprar)
end

local function sortearHeroi()
	local multRaros = multEvento("multRaros")
	local pesos = {}
	local total = 0
	for i, def in Config.Herois do
		local raridade = Config.RaridadePorId[def.raridade]
		local peso = raridade.chance / raridade.quantidade
		if raridade.ordem >= ORDEM_LENDARIO then
			peso *= multRaros
		end
		pesos[i] = peso
		total += peso
	end
	local sorteio = math.random() * total
	for i, def in Config.Herois do
		sorteio -= pesos[i]
		if sorteio <= 0 then
			return def
		end
	end
	return Config.Herois[1]
end

local function sortearMutacao()
	local mult = multEvento("multMutacao")
	local sorteio = math.random()
	local acumulado = 0
	for _, mutacao in Config.Mutacoes do
		if mutacao.chance > 0 then
			acumulado += mutacao.chance * mult
			if sorteio < acumulado then
				return mutacao.id
			end
		end
	end
	return "Normal"
end

--------------------------------------------------------------------------
-- LUVA HEROICA (soco). O modelo 3D da luva é colocado na mão quando equipa.
--------------------------------------------------------------------------
local function luvaDoJogador(jogador)
	local sessao = sessoes[jogador]
	local id = sessao and sessao.dados.luvaEquipada or "Basica"
	return Config.LuvaPorId[id] or Config.Luvas[1]
end

local function criarLuva()
	local existente = StarterPack:FindFirstChild(NOME_LUVA)
	if existente then
		existente:Destroy()
	end
	local luva = Instance.new("Tool")
	luva.Name = NOME_LUVA
	luva.CanBeDropped = false
	luva.ToolTip = "Clique para socar! Ladrões socados derrubam o herói."

	-- A alça é invisível: o que aparece é a luva 3D colocada na mão
	local alca = Instance.new("Part")
	alca.Name = "Handle"
	alca.Size = Vector3.new(0.4, 0.4, 0.4)
	alca.Transparency = 1
	alca.CanCollide = false
	alca.CanTouch = false
	alca.Massless = true
	alca.Parent = luva

	local som = Instance.new("Sound")
	som.Name = "SomSoco"
	som.SoundId = Config.Sons.Soco
	som.Volume = 0.8
	som.Parent = alca

	luva.Parent = StarterPack
end
criarLuva()

local function tirarLuvaVisual(personagem)
	local antiga = personagem:FindFirstChild("LuvaVisual")
	if antiga then
		antiga:Destroy()
	end
end

local function vestirLuva(jogador)
	local personagem = jogador.Character
	if not personagem then
		return
	end
	tirarLuvaVisual(personagem)
	if not personagem:FindFirstChild(NOME_LUVA) then
		return -- só aparece com a luva equipada
	end
	local mao = personagem:FindFirstChild("RightHand") or personagem:FindFirstChild("Right Arm")
	if not mao or not mao:IsA("BasePart") then
		return
	end
	local modelo, raiz = Modelos.luva(luvaDoJogador(jogador), 1.4)
	modelo.Name = "LuvaVisual"
	local alvo = mao.CFrame * (mao.Name == "RightHand" and CFrame.new(0, -0.15, 0) or CFrame.new(0, -0.95, 0))
	for _, parte in modelo:GetDescendants() do
		if parte:IsA("BasePart") then
			parte.CFrame = alvo * parte.CFrame
			parte.Anchored = false
			parte.Massless = true
			parte.CanCollide = false
			parte.CanTouch = false
			parte.CanQuery = false
		end
	end
	modelo.Parent = personagem
	local solda = Instance.new("WeldConstraint")
	solda.Part0 = mao
	solda.Part1 = raiz
	solda.Parent = raiz
end

local function socar(jogador, luva)
	local sessao = sessoes[jogador]
	if not sessao then
		return
	end
	local def = luvaDoJogador(jogador)
	local agora = os.clock()
	if agora - sessao.ultimoSoco < def.recarga then
		return
	end
	sessao.ultimoSoco = agora
	local raiz = raizDe(jogador)
	if not raiz then
		return
	end

	-- Animação padrão de ataque do Roblox
	local animacao = Instance.new("StringValue")
	animacao.Name = "toolanim"
	animacao.Value = "Slash"
	animacao.Parent = luva
	Debris:AddItem(animacao, 1)
	local alca = luva:FindFirstChild("Handle")
	local som = alca and alca:FindFirstChild("SomSoco")
	if som and som:IsA("Sound") then
		som:Play()
	end

	for _, outro in Players:GetPlayers() do
		local raizOutro = raizDe(outro)
		local humanoidOutro = humanoidDe(outro)
		if outro ~= jogador and raizOutro and humanoidOutro and humanoidOutro.Health > 0 then
			local delta = raizOutro.Position - raiz.Position
			if delta.Magnitude <= def.alcance then
				local plano = Vector3.new(delta.X, 0, delta.Z)
				local direcao = plano.Magnitude > 0.1 and plano.Unit or raiz.CFrame.LookVector
				if raiz.CFrame.LookVector:Dot(direcao) > 0.2 then
					Empurrao:FireClient(outro, direcao * def.forca + Vector3.new(0, 35, 0), def.atordoar)
					local h = carregando[outro]
					if h then
						devolver(h, "🥊 " .. jogador.DisplayName .. " te deu um soco e você derrubou o herói!")
						notificar(jogador, "🥊 Você fez " .. outro.DisplayName .. " derrubar o herói!", "sucesso")
					end
				end
			end
		end
	end
end

local luvasConectadas = setmetatable({}, { __mode = "k" })
local function conectarLuva(jogador, objeto)
	if objeto:IsA("Tool") and objeto.Name == NOME_LUVA then
		if not luvasConectadas[objeto] then
			luvasConectadas[objeto] = true
			objeto.Activated:Connect(function()
				socar(jogador, objeto)
			end)
		end
		vestirLuva(jogador)
	end
end

--------------------------------------------------------------------------
-- EVENTOS
--------------------------------------------------------------------------
local function terminarEvento()
	if not eventoAtual then
		return
	end
	anunciar("O evento " .. eventoAtual.nome .. " acabou!", Color3.fromRGB(200, 200, 210))
	eventoAtual = nil
	workspace:SetAttribute("EventoId", nil)
	workspace:SetAttribute("EventoFim", nil)
	TweenService:Create(mapa.correcaoCor, TweenInfo.new(3), { TintColor = Color3.new(1, 1, 1) }):Play()
end

local function iniciarEvento(evento)
	tokenEvento += 1
	local meuToken = tokenEvento
	local duracao = G.DuracaoEventoMinutos * 60
	eventoAtual = evento
	workspace:SetAttribute("EventoId", evento.id)
	workspace:SetAttribute("EventoFim", workspace:GetServerTimeNow() + duracao)
	anunciar(evento.icone .. " " .. evento.nome .. "! " .. evento.descricao, evento.cor)
	TweenService:Create(mapa.correcaoCor, TweenInfo.new(3), { TintColor = Color3.new(1, 1, 1):Lerp(evento.cor, 0.25) }):Play()
	task.delay(duracao, function()
		if tokenEvento == meuToken then
			terminarEvento()
		end
	end)
end

--------------------------------------------------------------------------
-- AÇÕES PEDIDAS PELA INTERFACE (Loja, Renascer, Diária...)
--------------------------------------------------------------------------
local MENSAGEM_LOJA = "🎪 Vá até a tenda da Loja (no meio do mapa) para comprar!"

local function pertoDaLoja(jogador)
	local raiz = raizDe(jogador)
	return raiz ~= nil and (raiz.Position - mapa.loja.centro).Magnitude <= G.DistanciaLoja
end

local function comprarMelhoria(jogador, id)
	local melhoria = type(id) == "string" and Config.MelhoriaPorId[id]
	if not melhoria then
		return false, "Melhoria inválida"
	end
	if not pertoDaLoja(jogador) then
		return false, MENSAGEM_LOJA
	end
	local sessao = sessoes[jogador]
	local atual = sessao.dados.niveis[id] or 0
	if atual >= #melhoria.precos then
		return false, "Nível máximo!"
	end
	local preco = melhoria.precos[atual + 1]
	if not gastar(jogador, preco) then
		return false, "Dinheiro insuficiente! Custa " .. formatar(preco)
	end
	sessao.dados.niveis[id] = atual + 1

	if id == "Velocidade" then
		aplicarMovimento(jogador)
	elseif id == "Pedestais" and sessao.base then
		atualizarSlots(sessao.base)
	end
	atualizarAtributos(jogador)
	efeito(jogador, "som", "compra")
	return true, melhoria.icone .. " " .. melhoria.nome .. " agora é nível " .. (atual + 1) .. "!"
end

local function comprarLuva(jogador, id)
	local def = type(id) == "string" and Config.LuvaPorId[id]
	if not def then
		return false, "Luva inválida"
	end
	local d = sessoes[jogador].dados
	if d.luvas[id] then
		d.luvaEquipada = id
		vestirLuva(jogador)
		atualizarAtributos(jogador)
		return true, def.icone .. " " .. def.nome .. " equipada!"
	end
	if not pertoDaLoja(jogador) then
		return false, MENSAGEM_LOJA
	end
	if not gastar(jogador, def.preco) then
		return false, "Dinheiro insuficiente! Custa " .. formatar(def.preco)
	end
	d.luvas[id] = true
	d.luvaEquipada = id
	vestirLuva(jogador)
	atualizarAtributos(jogador)
	efeito(jogador, "som", "compra")
	return true, def.icone .. " Você comprou a " .. def.nome .. "! Equipe a luva (tecla 1) e soque os ladrões."
end

local function renascer(jogador)
	local sessao = sessoes[jogador]
	local d = sessao.dados
	local custo = Config.custoRenascimento(d.renascimentos)
	if d.dinheiro < custo then
		return false, "Você precisa de " .. formatar(custo) .. " para renascer."
	end
	local h = carregando[jogador]
	if h then
		devolver(h, nil)
	end
	if sessao.base then
		limparHeroisDaBase(sessao.base)
	end
	d.renascimentos += 1
	d.dinheiro = Config.dinheiroInicial(d.renascimentos)
	atualizarAtributos(jogador)
	efeito(jogador, "renascer")
	anunciar("♻️ " .. jogador.DisplayName .. " RENASCEU! (" .. d.renascimentos .. "x)", Color3.fromRGB(170, 90, 255))
	return true, "♻️ Você renasceu! Sua renda agora é x" .. multiplicadorJogador(jogador)
end

local function resgatarDiaria(jogador)
	local d = sessoes[jogador].dados
	local agora = os.time()
	local intervalo = Config.Diaria.IntervaloHoras * 3600
	if agora < d.ultimaDiaria + intervalo then
		return false, "Volte em " .. Config.formatarTempo(d.ultimaDiaria + intervalo - agora)
	end
	if d.ultimaDiaria > 0 and agora - d.ultimaDiaria <= Config.Diaria.PerdeSequenciaHoras * 3600 then
		d.sequenciaDiaria += 1
	else
		d.sequenciaDiaria = 1
	end
	local dia = (d.sequenciaDiaria - 1) % 7 + 1
	local valor = Config.recompensaDiaria(dia, d.renascimentos)
	d.ultimaDiaria = agora
	ganhar(jogador, valor)
	atualizarAtributos(jogador)
	efeito(jogador, "som", "moeda")
	return true, "🎁 Dia " .. dia .. ": você ganhou " .. formatar(valor) .. "!"
end

Acao.OnServerInvoke = function(jogador, acao, argumento)
	local sessao = sessoes[jogador]
	if not sessao then
		return false, "Carregando seus dados..."
	end
	local agora = os.clock()
	if agora - sessao.ultimaAcao < 0.25 then
		return false, "Calma! 😅"
	end
	sessao.ultimaAcao = agora

	if acao == "Melhoria" then
		return comprarMelhoria(jogador, argumento)
	elseif acao == "Luva" then
		return comprarLuva(jogador, argumento)
	elseif acao == "Renascer" then
		return renascer(jogador)
	elseif acao == "Diaria" then
		return resgatarDiaria(jogador)
	elseif acao == "Tutorial" then
		sessao.dados.tutorial = true
		atualizarAtributos(jogador)
		return true, ""
	elseif acao == "Config" and type(argumento) == "table" then
		sessao.dados.config.musica = argumento.musica == true
		sessao.dados.config.sons = argumento.sons == true
		atualizarAtributos(jogador)
		return true, ""
	end
	return false, "Ação desconhecida"
end

ObterRanking.OnServerInvoke = function()
	return rankingGlobal
end

--------------------------------------------------------------------------
-- SALVAMENTO
--------------------------------------------------------------------------
local function montarSave(jogador)
	local sessao = sessoes[jogador]
	local d = sessao.dados
	local lista = {}
	if sessao.base then
		for i, slot in sessao.base.slots do
			local h = slot.heroi
			if h and h.base == sessao.base and h.slot == slot and h.estado ~= "removido" then
				table.insert(lista, { slot = i, id = h.def.id, mut = h.mutacao.id })
			end
		end
	end
	d.herois = lista
	d.ultimoLogin = os.time()
	return d
end

local function salvarJogador(jogador)
	local sessao = sessoes[jogador]
	if sessao and sessao.podeSalvar then
		Dados.salvar(jogador.UserId, montarSave(jogador))
	end
end

--------------------------------------------------------------------------
-- ENTRADA E SAÍDA DE JOGADORES
--------------------------------------------------------------------------
local function aoNascer(jogador, personagem)
	local sessao = sessoes[jogador]
	if not sessao then
		return
	end
	local humanoid = personagem:WaitForChild("Humanoid", 10)
	local raiz = personagem:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not raiz or not humanoid:IsA("Humanoid") then
		return
	end
	aplicarMovimento(jogador)

	if sessao.base then
		-- Deixa o dono atravessar a barreira da própria base
		local grupo = sessao.base.grupoDono
		for _, parte in personagem:GetDescendants() do
			if parte:IsA("BasePart") then
				parte.CollisionGroup = grupo
			end
		end
		personagem.DescendantAdded:Connect(function(parte)
			if parte:IsA("BasePart") then
				parte.CollisionGroup = grupo
			end
		end)
	end

	personagem.ChildAdded:Connect(function(objeto)
		conectarLuva(jogador, objeto)
	end)
	personagem.ChildRemoved:Connect(function(objeto)
		if objeto:IsA("Tool") and objeto.Name == NOME_LUVA then
			tirarLuvaVisual(personagem)
		end
	end)
	for _, objeto in personagem:GetChildren() do
		conectarLuva(jogador, objeto)
	end

	if sessao.base then
		task.wait(0.2)
		if personagem.Parent then
			personagem:PivotTo(sessao.base.spawn)
		end
	end
end

local function criarLeaderstats(jogador)
	local pasta = Instance.new("Folder")
	pasta.Name = "leaderstats"
	local dinheiro = Instance.new("IntValue")
	dinheiro.Name = "Dinheiro"
	dinheiro.Parent = pasta
	local roubos = Instance.new("IntValue")
	roubos.Name = "Roubos"
	roubos.Parent = pasta
	local renascimentos = Instance.new("IntValue")
	renascimentos.Name = "Renasc."
	renascimentos.Parent = pasta
	pasta.Parent = jogador
	return dinheiro, roubos, renascimentos
end

local function aoEntrar(jogador)
	local statDinheiro, statRoubos, statRenascimentos = criarLeaderstats(jogador)
	local dados, carregou = Dados.carregar(jogador.UserId)
	if not jogador.Parent then
		return
	end
	if dados.ultimoLogin == 0 and dados.dinheiro == 0 then
		dados.dinheiro = Config.dinheiroInicial(0)
	end
	-- Heróis da versão antiga viram os novos
	for _, salvo in dados.herois do
		salvo.id = Config.IdsAntigos[salvo.id] or salvo.id
	end
	local descobertos = {}
	for id in dados.descobertos do
		descobertos[Config.IdsAntigos[id] or id] = true
	end
	dados.descobertos = descobertos
	dados.luvas.Basica = true
	if not Config.LuvaPorId[dados.luvaEquipada] or not dados.luvas[dados.luvaEquipada] then
		dados.luvaEquipada = "Basica"
	end

	local sessao = {
		dados = dados,
		podeSalvar = carregou,
		statDinheiro = statDinheiro,
		statRoubos = statRoubos,
		statRenascimentos = statRenascimentos,
		ultimaAcao = 0,
		ultimoSoco = 0,
		passeDobro = false,
		base = nil,
	}
	sessoes[jogador] = sessao

	if Config.Robux.PasseDinheiroDobrado ~= 0 then
		local ok, tem = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(jogador.UserId, Config.Robux.PasseDinheiroDobrado)
		end)
		sessao.passeDobro = ok and tem == true
	end

	for _, base in bases do
		if not base.dono then
			base.dono = jogador
			sessao.base = base
			break
		end
	end

	local offline = nil
	if sessao.base then
		local base = sessao.base
		atualizarSlots(base)
		local liberados = pedestaisJogador(jogador)
		for _, salvo in dados.herois do
			local def = Config.HeroiPorId[salvo.id]
			local slot = base.slots[salvo.slot]
			if def and slot and salvo.slot <= liberados and not slot.heroi then
				colocarNaBase(novoHeroi(def, salvo.mut or "Normal"), base, slot, false)
			end
		end

		-- Renda enquanto o jogador estava fora
		if dados.ultimoLogin > 0 then
			local segundos = math.clamp(os.time() - dados.ultimoLogin, 0, G.HorasOfflineMaximo * 3600)
			if segundos >= 60 then
				local mult = multiplicadorJogador(jogador) * G.PorcentagemOffline
				local total = 0
				for _, slot in base.slots do
					local h = slot.heroi
					if h and h.estado == "base" then
						local valor = rendaHeroi(h) * mult * segundos
						slot.acumulado += valor
						total += valor
						atualizarPad(slot)
					end
				end
				if total >= 1 then
					offline = { total, segundos }
				end
			end
		end
	end
	dados.ultimoLogin = os.time()
	atualizarAtributos(jogador)

	jogador.CharacterAdded:Connect(function(personagem)
		aoNascer(jogador, personagem)
	end)
	if jogador.Character then
		task.spawn(aoNascer, jogador, jogador.Character)
	end

	-- Avisos depois que a interface do jogador carregar
	task.delay(4, function()
		if not jogador.Parent then
			return
		end
		if not sessao.base then
			notificar(jogador, "😢 Servidor cheio: todas as bases estão ocupadas.", "erro")
		end
		if not carregou then
			local motivo = Dados.desativado and "publique o jogo e ative o acesso às APIs" or "erro ao carregar seus dados"
			notificar(jogador, "⚠️ Seu progresso NÃO será salvo (" .. motivo .. ")", "aviso")
		end
		if offline then
			efeito(jogador, "offline", offline[1], offline[2])
		end
	end)
end

local function aoSair(jogador)
	local h = carregando[jogador]
	if h then
		devolver(h, nil)
	end
	local sessao = sessoes[jogador]
	if not sessao then
		return
	end
	local base = sessao.base
	if base then
		-- Coleta automaticamente o que ficou nos pedestais
		for _, slot in base.slots do
			if slot.acumulado >= 1 then
				ganhar(jogador, math.floor(slot.acumulado))
			end
		end
	end
	local dadosFinais = sessao.podeSalvar and montarSave(jogador) or nil
	if base then
		limparHeroisDaBase(base)
		base.dono = nil
		base.trancadaAte = 0
		base.recargaAte = 0
		atualizarBarreira(base)
		atualizarSlots(base)
	end
	sessoes[jogador] = nil
	if dadosFinais then
		Dados.salvar(jogador.UserId, dadosFinais)
		Dados.atualizarRanking(jogador.UserId, {
			Dinheiro = dadosFinais.totalGanho,
			Roubos = dadosFinais.roubos,
			Renascimentos = dadosFinais.renascimentos,
		})
	end
end

--------------------------------------------------------------------------
-- COMANDOS DE TESTE (no chat: !dinheiro 1000000 | !evento | !heroi HeroiSupremo Cosmico | !roleta)
--------------------------------------------------------------------------
local function processarComando(jogador, mensagem)
	if not G.ComandosDeTeste or not (RunService:IsStudio() or jogador.UserId == game.CreatorId) then
		return
	end
	local partes = string.split(mensagem, " ")
	local comando = string.lower(partes[1] or "")
	if comando == "!dinheiro" then
		local valor = tonumber(partes[2]) or 1000000
		ganhar(jogador, valor)
		notificar(jogador, "💰 +" .. formatar(valor), "sucesso")
	elseif comando == "!evento" then
		local evento = Config.EventoPorId[partes[2] or ""] or Config.Eventos[math.random(#Config.Eventos)]
		iniciarEvento(evento)
	elseif comando == "!roleta" then
		local sessao = sessoes[jogador]
		if sessao then
			sessao.dados.ultimaRoleta = 0
			atualizarAtributos(jogador)
			notificar(jogador, "🎡 Roleta liberada!", "sucesso")
		end
	elseif comando == "!heroi" then
		local def = Config.HeroiPorId[partes[2] or ""]
		if not def then
			notificar(jogador, "Use: !heroi IdDoHeroi [Mutacao]  (ex: !heroi AranhaEscarlate Ouro)", "aviso")
			return
		end
		local mutacao = Config.MutacaoPorId[partes[3] or ""] and partes[3] or "Normal"
		colocarNaPassarela(novoHeroi(def, mutacao))
		notificar(jogador, "🌀 " .. def.nome .. " saiu do portal!", "sucesso")
	end
end

Players.PlayerAdded:Connect(function(jogador)
	jogador.Chatted:Connect(function(mensagem)
		processarComando(jogador, mensagem)
	end)
	aoEntrar(jogador)
end)
for _, jogador in Players:GetPlayers() do
	jogador.Chatted:Connect(function(mensagem)
		processarComando(jogador, mensagem)
	end)
	task.spawn(aoEntrar, jogador)
end
Players.PlayerRemoving:Connect(aoSair)

game:BindToClose(function()
	if Dados.desativado then
		return
	end
	local pendentes = 0
	for jogador, sessao in sessoes do
		if sessao.podeSalvar then
			pendentes += 1
			task.spawn(function()
				salvarJogador(jogador)
				pendentes -= 1
			end)
		end
	end
	local inicio = os.clock()
	while pendentes > 0 and os.clock() - inicio < 25 do
		task.wait(0.5)
	end
end)

--------------------------------------------------------------------------
-- ROBUX
--------------------------------------------------------------------------
if Config.Robux.PasseDinheiroDobrado ~= 0 then
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(jogador, passeId, comprou)
		local sessao = sessoes[jogador]
		if comprou and passeId == Config.Robux.PasseDinheiroDobrado and sessao then
			sessao.passeDobro = true
			atualizarAtributos(jogador)
			notificar(jogador, "💎 Dinheiro em Dobro ativado! Obrigado!", "especial")
		end
	end)
end

local temProdutos = false
for _, produto in Config.Robux.Produtos do
	if produto.id ~= 0 then
		temProdutos = true
	end
end
if temProdutos then
	MarketplaceService.ProcessReceipt = function(recibo)
		local jogador = Players:GetPlayerByUserId(recibo.PlayerId)
		local sessao = jogador and sessoes[jogador]
		if not sessao then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		for _, produto in Config.Robux.Produtos do
			if produto.id ~= 0 and produto.id == recibo.ProductId then
				local valor = Config.valorProduto(produto, sessao.dados.renascimentos)
				ganhar(jogador, valor)
				notificar(jogador, produto.icone .. " " .. produto.nome .. ": +" .. formatar(valor) .. "!", "especial")
				task.spawn(salvarJogador, jogador)
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
end

--------------------------------------------------------------------------
-- LIGAR BOTÕES DAS BASES
--------------------------------------------------------------------------
for _, base in bases do
	base.dono = nil
	base.trancadaAte = 0
	base.recargaAte = 0

	base.botao.Touched:Connect(function(parteTocada)
		local jogador = Players:GetPlayerFromCharacter(parteTocada.Parent)
		if jogador and jogador == base.dono then
			trancarBase(base, jogador)
		end
	end)

	for _, slot in base.slots do
		slot.pad.Touched:Connect(function(parteTocada)
			local dono = base.dono
			if not dono or slot.acumulado < 1 then
				return
			end
			if Players:GetPlayerFromCharacter(parteTocada.Parent) ~= dono then
				return
			end
			local valor = math.floor(slot.acumulado)
			slot.acumulado -= valor
			ganhar(dono, valor)
			atualizarPad(slot)
			efeito(dono, "coleta", valor, slot.pad.Position)
		end)
	end
	-- Elevador: subir e descer entre os andares
	for _, elevador in base.elevadores do
		local function botaoElevador(nome, texto, tecla, destino)
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = nome
			prompt.ActionText = texto
			prompt.ObjectText = "Elevador"
			prompt.KeyboardKeyCode = tecla
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 7
			prompt.RequiresLineOfSight = false
			prompt.Parent = elevador.plataforma
			prompt.Triggered:Connect(function(jogador)
				local personagem = jogador.Character
				if personagem then
					personagem:PivotTo(base.elevadores[destino].saida)
				end
			end)
		end
		if elevador.andar < #base.elevadores then
			botaoElevador("Subir", "⬆ Subir para o " .. (elevador.andar + 1) .. "º", Enum.KeyCode.E, elevador.andar + 1)
		end
		if elevador.andar > 1 then
			botaoElevador("Descer", "⬇ Descer para o " .. (elevador.andar - 1) .. "º", Enum.KeyCode.R, elevador.andar - 1)
		end
	end
	atualizarSlots(base)
	atualizarBarreira(base)
end

--------------------------------------------------------------------------
-- TENDA DA LOJA
--------------------------------------------------------------------------
do
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "AbrirLoja"
	prompt.ActionText = "Abrir loja"
	prompt.ObjectText = "Loja dos Heróis"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = mapa.loja.balcao
	prompt.Triggered:Connect(function(jogador)
		AbrirLoja:FireClient(jogador)
	end)
end

--------------------------------------------------------------------------
-- ROLETA DA SORTE (a cada 12 horas)
--------------------------------------------------------------------------
local roletaGirando = false
local anguloRoleta = 0

local function sortearPremio()
	local total = 0
	for _, premio in Config.Roleta.Premios do
		total += premio.peso
	end
	local sorteio = math.random() * total
	for _, premio in Config.Roleta.Premios do
		sorteio -= premio.peso
		if sorteio <= 0 then
			return premio
		end
	end
	return Config.Roleta.Premios[1]
end

local function darPremio(jogador, premio)
	local sessao = sessoes[jogador]
	if not sessao then
		return ""
	end
	local d = sessao.dados
	if premio.tipo == "dinheiro" then
		local renda = jogador:GetAttribute("RendaPorSegundo") or 0
		local valor = math.max(premio.minimo * (1 + d.renascimentos), renda * 60 * premio.minutos)
		ganhar(jogador, valor)
		return premio.icone .. " " .. premio.nome .. ": +" .. formatar(valor) .. "!"
	elseif premio.tipo == "boostRenda" then
		sessao.boostRendaAte = math.max(os.time(), sessao.boostRendaAte or 0) + premio.minutos * 60
		atualizarAtributos(jogador)
		return "⚡ Sua renda está em DOBRO por " .. premio.minutos .. " minutos!"
	elseif premio.tipo == "boostVelocidade" then
		sessao.boostVelocidadeAte = math.max(os.time(), sessao.boostVelocidadeAte or 0) + premio.minutos * 60
		aplicarMovimento(jogador)
		atualizarAtributos(jogador)
		task.delay(premio.minutos * 60 + 1, function()
			if jogador.Parent then
				aplicarMovimento(jogador)
			end
		end)
		return "🌀 Super velocidade por " .. premio.minutos .. " minutos!"
	elseif premio.tipo == "heroi" then
		local opcoes = {}
		for _, def in Config.Herois do
			if def.raridade == premio.raridade then
				table.insert(opcoes, def)
			end
		end
		local def = opcoes[math.random(#opcoes)]
		local slot = sessao.base and slotLivre(sessao.base, pedestaisJogador(jogador))
		if slot then
			colocarNaBase(novoHeroi(def, "Normal"), sessao.base, slot, false)
			descobrir(jogador, def)
			return "🦸 Você ganhou " .. def.nome .. "! Ele já está na sua base."
		end
		ganhar(jogador, def.preco)
		return "🦸 Sua base estava cheia: você ganhou " .. formatar(def.preco) .. " no lugar de " .. def.nome .. "!"
	elseif premio.tipo == "girarDeNovo" then
		d.ultimaRoleta = 0
		atualizarAtributos(jogador)
		return "🔁 Você pode girar a roleta de novo agora!"
	end
	return ""
end

local function girarRoleta(jogador)
	local sessao = sessoes[jogador]
	if not sessao then
		return
	end
	local d = sessao.dados
	local agora = os.time()
	local proxima = d.ultimaRoleta + Config.Roleta.IntervaloHoras * 3600
	if agora < proxima then
		notificar(jogador, "🎡 A roleta libera de novo em " .. Config.formatarTempo(proxima - agora), "aviso")
		return
	end
	if roletaGirando then
		notificar(jogador, "🎡 A roleta está girando, espere um pouquinho!", "aviso")
		return
	end
	roletaGirando = true
	d.ultimaRoleta = agora
	atualizarAtributos(jogador)

	local premio = sortearPremio()
	local volta = math.pi * 2
	local alvo = (premio.indice - 1) * (volta / #Config.Roleta.Premios)
	local final = anguloRoleta - (anguloRoleta % volta) + 5 * volta + alvo
	local duracao = Config.Roleta.DuracaoGiro
	RoletaGiro:FireAllClients(mapa.roleta.cf0, anguloRoleta, final, duracao)
	notificar(jogador, "🎡 Girando a roleta...", "info")

	task.delay(duracao, function()
		anguloRoleta = final
		mapa.roleta.eixo.CFrame = mapa.roleta.cf0 * CFrame.Angles(0, 0, final % volta)
		roletaGirando = false
		if not jogador.Parent then
			return
		end
		local mensagem = darPremio(jogador, premio)
		efeito(jogador, "premio", premio.icone, mensagem)
		if (premio.tipo == "heroi" and premio.raridade == "Lendario") or premio.id == "MoedasG" then
			anunciar("🎡 " .. jogador.DisplayName .. " ganhou " .. premio.nome .. " na Roleta da Sorte!", premio.cor)
		end
	end)
end

do
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "GirarRoleta"
	prompt.ActionText = "Girar a roleta"
	prompt.ObjectText = "Roleta da Sorte"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = mapa.roleta.botao
	prompt.Triggered:Connect(girarRoleta)
end

--------------------------------------------------------------------------
-- RANKING
--------------------------------------------------------------------------
local nomesCache = {}
local function nomeDoUsuario(userId)
	if nomesCache[userId] then
		return nomesCache[userId]
	end
	local jogador = Players:GetPlayerByUserId(userId)
	local nome
	if jogador then
		nome = jogador.DisplayName
	else
		local ok, resultado = pcall(function()
			return Players:GetNameFromUserIdAsync(userId)
		end)
		nome = ok and resultado or ("Jogador " .. userId)
	end
	nomesCache[userId] = nome
	return nome
end

local function valorRanking(categoria, d)
	if categoria == "Dinheiro" then
		return d.totalGanho
	elseif categoria == "Roubos" then
		return d.roubos
	end
	return d.renascimentos
end

local function atualizarRanking()
	for jogador, sessao in sessoes do
		if sessao.podeSalvar then
			Dados.atualizarRanking(jogador.UserId, {
				Dinheiro = sessao.dados.totalGanho,
				Roubos = sessao.dados.roubos,
				Renascimentos = sessao.dados.renascimentos,
			})
		end
	end

	local algumGlobal = false
	for _, categoria in Mapa.CATEGORIAS_RANKING do
		local lista = Dados.obterTop(categoria.id, 10)
		local resultado = {}
		if lista then
			algumGlobal = true
			for i, item in lista do
				resultado[i] = { nome = nomeDoUsuario(item.userId), valor = item.valor }
			end
		else
			-- Sem DataStore (Studio): mostra o ranking do servidor
			for jogador, sessao in sessoes do
				table.insert(resultado, { nome = jogador.DisplayName, valor = valorRanking(categoria.id, sessao.dados) })
			end
			table.sort(resultado, function(a, b)
				return a.valor > b.valor
			end)
		end
		rankingGlobal[categoria.id] = resultado

		local quadro = mapa.quadros[categoria.id]
		for i, linha in quadro.linhas do
			local item = resultado[i]
			linha.nome.Text = item and item.nome or "—"
			if item then
				linha.valor.Text = categoria.id == "Dinheiro" and formatar(item.valor) or Config.formatarNumero(item.valor)
			else
				linha.valor.Text = ""
			end
		end
		quadro.rodape.Text = lista and ("🌎 Ranking global • atualiza a cada " .. math.floor(G.IntervaloRanking / 60) .. " min")
			or "Ranking do servidor (o global aparece quando o jogo for publicado)"
	end
	rankingGlobal.disponivel = algumGlobal
end

--------------------------------------------------------------------------
-- LOOPS DO JOGO
--------------------------------------------------------------------------

-- Todo frame: move os heróis da passarela e confere os roubos
RunService.Heartbeat:Connect(function(dt)
	for _, h in herois do
		if h.estado == "andando" then
			h.distancia += G.VelocidadePassarela * dt
			if h.distancia >= mapa.comprimento then
				removerHeroi(h)
			else
				local pulo = math.abs(math.sin(h.distancia * 0.9)) * 0.5
				local posicao = mapa.inicio + Vector3.new(h.distancia, h.altura + pulo, 0)
				h.raiz.CFrame = CFrame.lookAt(posicao, posicao + Vector3.xAxis)
			end
		elseif h.estado == "carregado" then
			verificarCarregado(h)
		end
	end
end)

-- Todo segundo: renda, placas, botões de tranca
task.spawn(function()
	while true do
		task.wait(1)
		local agora = os.clock()
		local multRenda = multEvento("multRenda")
		for _, base in bases do
			local dono = base.dono
			local sessao = dono and sessoes[dono]
			if sessao then
				local mult = multiplicadorJogador(dono) * multRenda
				local coletorAutomatico = (sessao.dados.niveis.Coletor or 0) > 0
				local rendaTotal = 0
				local direto = 0
				for _, slot in base.slots do
					local h = slot.heroi
					if h and h.estado == "base" and h.base == base and h.slot == slot then
						local renda = rendaHeroi(h) * mult
						rendaTotal += renda
						slot.acumulado += renda
					end
					if coletorAutomatico and slot.acumulado > 0 then
						direto += slot.acumulado
						slot.acumulado = 0
					end
					atualizarPad(slot)
				end
				if direto > 0 then
					ganhar(dono, direto)
				end
				dono:SetAttribute("RendaPorSegundo", rendaTotal)
				dono:SetAttribute("Multiplicador", multiplicadorJogador(dono))
				base.textoPlaca.Text = "BASE DE " .. string.upper(dono.DisplayName)
				base.textoRenda.Text = "+" .. formatar(rendaTotal) .. "/s"
			else
				base.textoPlaca.Text = "BASE LIVRE"
				base.textoRenda.Text = ""
			end

			atualizarBarreira(base)
			if agora < base.trancadaAte then
				base.textoBotao.Text = "🔒 TRANCADA " .. math.ceil(base.trancadaAte - agora) .. "s"
				base.textoBotao.TextColor3 = Color3.fromRGB(255, 80, 80)
			elseif agora < base.recargaAte then
				base.textoBotao.Text = "⏳ RECARGA " .. math.ceil(base.recargaAte - agora) .. "s"
				base.textoBotao.TextColor3 = Color3.fromRGB(255, 210, 60)
			else
				base.textoBotao.Text = "🔒 TRANCAR BASE"
				base.textoBotao.TextColor3 = Color3.fromRGB(110, 255, 130)
			end
		end
	end
end)

-- Heróis saindo do portal
task.spawn(function()
	while true do
		local h = novoHeroi(sortearHeroi(), sortearMutacao())
		colocarNaPassarela(h)
		if h.raridade.ordem >= ORDEM_ANUNCIO_SPAWN or h.mutacao.multiplicador >= 5 then
			anunciar("🌀 Um herói " .. string.upper(h.raridade.nome) .. " saiu do portal: " .. nomeCompleto(h) .. "!", h.raridade.cor)
		end
		task.wait(G.IntervaloSpawn / multEvento("multSpawn"))
	end
end)

-- Eventos automáticos
task.spawn(function()
	while true do
		task.wait(G.IntervaloEventoMinutos * 60)
		if not eventoAtual then
			iniciarEvento(Config.Eventos[math.random(#Config.Eventos)])
		end
	end
end)

-- Ciclo de dia e noite (a noite passa mais rápido)
if G.CicloDiaNoite then
	task.spawn(function()
		local passo = 24 / (G.DuracaoDiaMinutos * 60) * 0.5
		while true do
			task.wait(0.5)
			local hora = Lighting.ClockTime
			local noite = hora >= 19 or hora < 5.5
			Lighting.ClockTime = (hora + passo * (noite and 2 or 1)) % 24
		end
	end)
end

-- Coroa para o jogador mais rico do servidor
task.spawn(function()
	while true do
		task.wait(3)
		local maisRico, maior = nil, -1
		for jogador, sessao in sessoes do
			if sessao.dados.dinheiro > maior then
				maior = sessao.dados.dinheiro
				maisRico = jogador
			end
		end
		local variosJogadores = #Players:GetPlayers() > 1
		for jogador in sessoes do
			local cabeca = jogador.Character and jogador.Character:FindFirstChild("Head")
			if cabeca then
				local coroa = cabeca:FindFirstChild("CoroaRei")
				if jogador == maisRico and variosJogadores then
					if not coroa then
						local gui = Instance.new("BillboardGui")
						gui.Name = "CoroaRei"
						gui.Size = UDim2.fromOffset(60, 60)
						gui.StudsOffset = Vector3.new(0, 2.8, 0)
						gui.MaxDistance = 120
						local rotulo = Instance.new("TextLabel")
						rotulo.BackgroundTransparency = 1
						rotulo.Size = UDim2.fromScale(1, 1)
						rotulo.Text = "👑"
						rotulo.TextScaled = true
						rotulo.Parent = gui
						gui.Parent = cabeca
					end
				elseif coroa then
					coroa:Destroy()
				end
			end
		end
	end
end)

-- Salvamento automático
task.spawn(function()
	while true do
		task.wait(G.IntervaloAutoSave)
		for jogador in sessoes do
			task.spawn(salvarJogador, jogador)
		end
	end
end)

-- Ranking (global com DataStore, ou do servidor no Studio)
task.spawn(function()
	task.wait(5)
	while true do
		atualizarRanking()
		task.wait(Dados.desativado and 10 or G.IntervaloRanking)
	end
end)

print("[Roube um Herói] Servidor pronto! Salvamento: " .. (Dados.desativado and ("DESATIVADO - " .. Dados.motivo) or "ativo"))
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">Mapa</string>
        <string name="Source"><![CDATA[--[[
	ROUBE UM HERÓI - Construtor do mapa

	Onde colocar: ServerScriptService -> ModuleScript (nome: Mapa)

	Monta todo o cenário por código: chão, praça, ruas, cidade com prédios
	neon, árvores, postes, passarela com portais, letreiro, quadros de
	ranking e as 8 bases dos jogadores. Também configura a iluminação.
]]

local Lighting = game:GetService("Lighting")
local PhysicsService = game:GetService("PhysicsService")

local Mapa = {}

local CHAO = 0.1 -- altura do topo da praça
local ALTURA_PISO = 0.5 -- piso das bases e passarela ficam 0.5 acima da praça
local TAMANHO_BASE = 48
Mapa.METADE_BASE = TAMANHO_BASE / 2

local CORES_BASES = {
	Color3.fromRGB(70, 130, 255),
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(70, 200, 100),
	Color3.fromRGB(255, 190, 50),
	Color3.fromRGB(170, 90, 255),
	Color3.fromRGB(40, 200, 210),
	Color3.fromRGB(255, 120, 200),
	Color3.fromRGB(255, 140, 40),
}

local CORES_NEON = {
	Color3.fromRGB(0, 220, 255),
	Color3.fromRGB(255, 60, 200),
	Color3.fromRGB(255, 210, 60),
	Color3.fromRGB(120, 255, 140),
	Color3.fromRGB(180, 120, 255),
}

--------------------------------------------------------------------------
-- AJUDANTES
--------------------------------------------------------------------------
local function parte(propriedades)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for nome, valor in propriedades do
		if nome ~= "Parent" then
			(p :: any)[nome] = valor
		end
	end
	p.Parent = propriedades.Parent
	return p
end

local function enfeite(propriedades)
	-- peças só de decoração: não fazem sombra nem atrapalham cliques
	propriedades.CastShadow = false
	propriedades.CanQuery = false
	propriedades.CanTouch = false
	return parte(propriedades)
end

local function pastaNova(nome, pai)
	local f = Instance.new("Folder")
	f.Name = nome
	f.Parent = pai
	return f
end

local function texto(pai, propriedades)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0
	t.Size = UDim2.fromScale(1, 1)
	for nome, valor in propriedades do
		(t :: any)[nome] = valor
	end
	t.Parent = pai
	return t
end

local function superficie(alvo, face, pixelsPorStud)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPorStud
	gui.LightInfluence = 0
	gui.Parent = alvo
	return gui
end

local function billboard(alvo, largura, altura, deslocamento, distancia)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(largura, altura)
	gui.StudsOffset = deslocamento
	gui.MaxDistance = distancia
	gui.LightInfluence = 0
	gui.Parent = alvo
	return gui
end

local function cilindroEmPe(propriedades, cf)
	-- o eixo do cilindro no Roblox é o X; giramos para ficar em pé
	propriedades.Shape = Enum.PartType.Cylinder
	propriedades.CFrame = cf * CFrame.Angles(0, 0, math.rad(90))
	return parte(propriedades)
end

--------------------------------------------------------------------------
-- ILUMINAÇÃO
--------------------------------------------------------------------------
local function configurarIluminacao(horaInicial)
	for _, objeto in Lighting:GetChildren() do
		if objeto:IsA("PostEffect") or objeto:IsA("Atmosphere") or objeto:IsA("Sky") then
			objeto:Destroy()
		end
	end

	Lighting.ClockTime = horaInicial
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(70, 70, 95)
	Lighting.OutdoorAmbient = Color3.fromRGB(125, 115, 145)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true

	local ceu = Instance.new("Sky")
	ceu.StarCount = 3000
	ceu.Parent = Lighting

	local atmosfera = Instance.new("Atmosphere")
	atmosfera.Density = 0.3
	atmosfera.Offset = 0.25
	atmosfera.Color = Color3.fromRGB(200, 170, 150)
	atmosfera.Decay = Color3.fromRGB(110, 100, 140)
	atmosfera.Glare = 0.4
	atmosfera.Haze = 1.4
	atmosfera.Parent = Lighting

	local brilho = Instance.new("BloomEffect")
	brilho.Intensity = 0.7
	brilho.Size = 28
	brilho.Threshold = 1.2
	brilho.Parent = Lighting

	local raios = Instance.new("SunRaysEffect")
	raios.Intensity = 0.06
	raios.Spread = 0.7
	raios.Parent = Lighting

	local correcao = Instance.new("ColorCorrectionEffect")
	correcao.Saturation = 0.15
	correcao.Contrast = 0.08
	correcao.Parent = Lighting

	local terreno = workspace:FindFirstChildOfClass("Terrain")
	if terreno then
		local nuvens = terreno:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		nuvens.Cover = 0.55
		nuvens.Density = 0.6
		nuvens.Parent = terreno
	end

	return correcao
end

--------------------------------------------------------------------------
-- CHÃO, PRAÇA E RUAS
--------------------------------------------------------------------------
local function construirChao(pasta)
	parte({
		Name = "Grama",
		Size = Vector3.new(1400, 2, 1400),
		CFrame = CFrame.new(0, CHAO - 1.3, 0),
		Color = Color3.fromRGB(70, 140, 60),
		Material = Enum.Material.Grass,
		Parent = pasta,
	})
	parte({
		Name = "Praca",
		Size = Vector3.new(440, 1, 220),
		CFrame = CFrame.new(0, CHAO - 0.5, 0),
		Color = Color3.fromRGB(120, 120, 130),
		Material = Enum.Material.Pavement,
		Parent = pasta,
	})

	-- Rua em volta da praça
	local asfalto = Color3.fromRGB(45, 45, 50)
	local ruas = {
		{ Vector3.new(540, 0.4, 26), Vector3.new(0, 0, 138) },
		{ Vector3.new(540, 0.4, 26), Vector3.new(0, 0, -138) },
		{ Vector3.new(26, 0.4, 250), Vector3.new(257, 0, 0) },
		{ Vector3.new(26, 0.4, 250), Vector3.new(-257, 0, 0) },
	}
	for _, rua in ruas do
		enfeite({
			Name = "Rua",
			Size = rua[1],
			CFrame = CFrame.new(rua[2] + Vector3.new(0, CHAO - 0.35, 0)),
			Color = asfalto,
			Material = Enum.Material.Asphalt,
			Parent = pasta,
		})
	end
	-- Faixas amarelas tracejadas
	for x = -250, 250, 20 do
		for _, z in { 138, -138 } do
			enfeite({
				Name = "Faixa",
				Size = Vector3.new(8, 0.1, 0.8),
				CFrame = CFrame.new(x, CHAO - 0.12, z),
				Color = Color3.fromRGB(255, 210, 60),
				Material = Enum.Material.SmoothPlastic,
				Parent = pasta,
			})
		end
	end
end

--------------------------------------------------------------------------
-- PASSARELA E PORTAIS
--------------------------------------------------------------------------
local function construirPortal(pasta, x, cor, nome)
	local modelo = Instance.new("Model")
	modelo.Name = nome
	modelo.Parent = pasta
	local base = CHAO + ALTURA_PISO

	local topo = enfeite({ Name = "Topo", Size = Vector3.new(2.5, 2.5, 21), CFrame = CFrame.new(x, base + 17.25, 0),
		Color = cor, Material = Enum.Material.Neon, Parent = modelo })
	for _, z in { -9.5, 9.5 } do
		parte({ Name = "Coluna", Size = Vector3.new(2.5, 18, 2.5), CFrame = CFrame.new(x, base + 9, z),
			Color = Color3.fromRGB(35, 35, 45), Material = Enum.Material.Metal, Parent = modelo })
		enfeite({ Name = "Faixa", Size = Vector3.new(2.7, 18, 0.6), CFrame = CFrame.new(x, base + 9, z),
			Color = cor, Material = Enum.Material.Neon, Parent = modelo })
	end

	local disco = enfeite({
		Name = "Energia",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 16, 16),
		CFrame = CFrame.new(x, base + 8, 0),
		Color = cor,
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
		Parent = modelo,
	})
	local particulas = Instance.new("ParticleEmitter")
	particulas.Color = ColorSequence.new(cor)
	particulas.LightEmission = 1
	particulas.Rate = 25
	particulas.Lifetime = NumberRange.new(1, 2)
	particulas.Speed = NumberRange.new(2, 5)
	particulas.SpreadAngle = Vector2.new(180, 180)
	particulas.Size = NumberSequence.new(0.6, 0)
	particulas.Parent = disco

	local luz = Instance.new("PointLight")
	luz.Color = cor
	luz.Range = 30
	luz.Brightness = 3
	luz.Parent = disco

	local placa = billboard(topo, 320, 60, Vector3.new(0, 4, 0), 220)
	texto(placa, { Text = "🌀 PORTAL DOS HERÓIS", TextColor3 = cor })
end

local function construirPassarela(pasta, comprimento)
	local metade = comprimento / 2
	parte({
		Name = "Passarela",
		Size = Vector3.new(comprimento + 6, ALTURA_PISO, 14),
		CFrame = CFrame.new(0, CHAO + ALTURA_PISO / 2, 0),
		Color = Color3.fromRGB(180, 25, 45),
		Material = Enum.Material.Fabric,
		Parent = pasta,
	})
	for _, z in { -7.4, 7.4 } do
		enfeite({
			Name = "BordaDourada",
			Size = Vector3.new(comprimento + 6, ALTURA_PISO + 0.15, 0.8),
			CFrame = CFrame.new(0, CHAO + (ALTURA_PISO + 0.15) / 2, z),
			Color = Color3.fromRGB(255, 200, 40),
			Material = Enum.Material.Neon,
			Parent = pasta,
		})
	end

	construirPortal(pasta, -metade - 1, Color3.fromRGB(0, 220, 255), "PortalEntrada")
	construirPortal(pasta, metade + 1, Color3.fromRGB(190, 80, 255), "PortalSaida")

	return Vector3.new(-metade, CHAO + ALTURA_PISO, 0)
end

local function construirPostes(pasta, comprimento)
	local metade = comprimento / 2
	for x = -metade, metade, 30 do
		for _, z in { -20, 20 } do
			if x == 0 then
				continue -- deixa livre a frente da loja e da roleta
			end
			enfeite({ Name = "Poste", Size = Vector3.new(0.6, 12, 0.6), CFrame = CFrame.new(x, CHAO + 6, z),
				Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = pasta })
			local lampada = enfeite({ Name = "Lampada", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 1.8, 1.8),
				CFrame = CFrame.new(x, CHAO + 12.4, z), Color = Color3.fromRGB(255, 230, 180),
				Material = Enum.Material.Neon, Parent = pasta })
			local luz = Instance.new("PointLight")
			luz.Color = Color3.fromRGB(255, 220, 170)
			luz.Range = 24
			luz.Brightness = 1.3
			luz.Parent = lampada
		end
	end
end

--------------------------------------------------------------------------
-- CIDADE DE FUNDO, ÁRVORES E LETREIRO
--------------------------------------------------------------------------
local function construirCidade(pasta)
	local aleatorio = Random.new(2024)
	local coresPredio = {
		Color3.fromRGB(35, 40, 60),
		Color3.fromRGB(50, 55, 75),
		Color3.fromRGB(30, 30, 40),
		Color3.fromRGB(60, 50, 80),
		Color3.fromRGB(40, 60, 80),
	}
	local quantidade = 70
	for i = 1, quantidade do
		local angulo = (i / quantidade) * math.pi * 2 + aleatorio:NextNumber(-0.03, 0.03)
		local raio = aleatorio:NextNumber(330, 470)
		local largura = aleatorio:NextNumber(30, 55)
		local profundidade = aleatorio:NextNumber(30, 55)
		local altura = aleatorio:NextNumber(60, 240)
		local centro = Vector3.new(math.cos(angulo) * raio, CHAO + altura / 2 - 0.3, math.sin(angulo) * raio)
		local cf = CFrame.lookAt(centro, Vector3.new(0, centro.Y, 0))
		local corNeon = CORES_NEON[aleatorio:NextInteger(1, #CORES_NEON)]

		local predio = Instance.new("Model")
		predio.Name = "Predio"
		predio.Parent = pasta
		enfeite({ Name = "Corpo", Size = Vector3.new(largura, altura, profundidade), CFrame = cf,
			Color = coresPredio[aleatorio:NextInteger(1, #coresPredio)], Material = Enum.Material.SmoothPlastic,
			Reflectance = 0.05, Parent = predio })

		-- Quinas neon
		for _, canto in { Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1) } do
			enfeite({ Name = "Quina", Size = Vector3.new(0.7, altura, 0.7),
				CFrame = cf * CFrame.new(canto.X * largura / 2, 0, canto.Z * profundidade / 2),
				Color = corNeon, Material = Enum.Material.Neon, Parent = predio })
		end

		-- Faixas de janelas acesas na frente
		for y = -altura / 2 + 10, altura / 2 - 6, 16 do
			enfeite({ Name = "Janelas", Size = Vector3.new(largura * 0.8, 2, 0.3),
				CFrame = cf * CFrame.new(0, y, -profundidade / 2 - 0.1),
				Color = Color3.fromRGB(255, 230, 160), Material = Enum.Material.Neon, Transparency = 0.25,
				Parent = predio })
		end

		-- Antena com luz vermelha
		if aleatorio:NextNumber() < 0.5 then
			enfeite({ Name = "Antena", Size = Vector3.new(0.6, 14, 0.6), CFrame = cf * CFrame.new(0, altura / 2 + 7, 0),
				Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal, Parent = predio })
			enfeite({ Name = "LuzAntena", Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2),
				CFrame = cf * CFrame.new(0, altura / 2 + 14.5, 0), Color = Color3.fromRGB(255, 40, 40),
				Material = Enum.Material.Neon, Parent = predio })
		end
	end
end

local function construirArvores(pasta)
	local aleatorio = Random.new(77)
	for i = 1, 60 do
		local angulo = (i / 60) * math.pi * 2 + aleatorio:NextNumber(-0.04, 0.04)
		local raio = aleatorio:NextNumber(285, 315)
		local x, z = math.cos(angulo) * raio, math.sin(angulo) * raio
		local altura = aleatorio:NextNumber(7, 11)
		enfeite({ Name = "Tronco", Size = Vector3.new(1.4, altura, 1.4), CFrame = CFrame.new(x, CHAO + altura / 2 - 0.3, z),
			Color = Color3.fromRGB(100, 70, 45), Material = Enum.Material.Wood, Parent = pasta })
		local tamanho = aleatorio:NextNumber(8, 12)
		enfeite({ Name = "Copa", Shape = Enum.PartType.Ball, Size = Vector3.new(tamanho, tamanho, tamanho),
			CFrame = CFrame.new(x, CHAO + altura + tamanho * 0.25, z),
			Color = Color3.fromRGB(50, aleatorio:NextInteger(120, 160), 60), Material = Enum.Material.Grass, Parent = pasta })
	end
end

local function construirLetreiro(pasta)
	local placa = parte({
		Name = "Letreiro",
		Size = Vector3.new(100, 18, 2),
		CFrame = CFrame.new(0, CHAO + 50, 0),
		Color = Color3.fromRGB(20, 20, 30),
		Material = Enum.Material.SmoothPlastic,
		CastShadow = false,
		Parent = pasta,
	})
	for _, info in {
		{ Vector3.new(102, 1, 2.4), Vector3.new(0, 9.5, 0) },
		{ Vector3.new(102, 1, 2.4), Vector3.new(0, -9.5, 0) },
		{ Vector3.new(1, 20, 2.4), Vector3.new(50.5, 0, 0) },
		{ Vector3.new(1, 20, 2.4), Vector3.new(-50.5, 0, 0) },
	} do
		enfeite({ Name = "Moldura", Size = info[1], CFrame = placa.CFrame + info[2],
			Color = Color3.fromRGB(255, 200, 40), Material = Enum.Material.Neon, Parent = pasta })
	end

	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = superficie(placa, face, 20)
		local titulo = texto(gui, {
			Text = "ROUBE UM HERÓI",
			Size = UDim2.fromScale(0.94, 0.66),
			Position = UDim2.fromScale(0.03, 0.04),
			TextStrokeTransparency = 1,
		})
		local gradiente = Instance.new("UIGradient")
		gradiente.Color = ColorSequence.new(Color3.fromRGB(255, 240, 120), Color3.fromRGB(255, 120, 30))
		gradiente.Rotation = 90
		gradiente.Parent = titulo
		local contorno = Instance.new("UIStroke")
		contorno.Thickness = 8
		contorno.Color = Color3.fromRGB(90, 20, 0)
		contorno.Parent = titulo
		texto(gui, {
			Text = "🦸 Compre • Colete • Roube 🦹",
			Size = UDim2.fromScale(0.9, 0.24),
			Position = UDim2.fromScale(0.05, 0.72),
			TextColor3 = Color3.fromRGB(255, 255, 255),
		})
	end
end

--------------------------------------------------------------------------
-- QUADROS DE RANKING
--------------------------------------------------------------------------
local CATEGORIAS_RANKING = {
	{ id = "Dinheiro", titulo = "🏆 MAIS RICOS", subtitulo = "Total de dinheiro ganho", cor = Color3.fromRGB(255, 190, 40), z = -50 },
	{ id = "Roubos", titulo = "🦹 MAIORES LADRÕES", subtitulo = "Heróis roubados", cor = Color3.fromRGB(255, 70, 70), z = 0 },
	{ id = "Renascimentos", titulo = "♻️ RENASCIMENTOS", subtitulo = "Vezes que renasceu", cor = Color3.fromRGB(170, 90, 255), z = 50 },
}
Mapa.CATEGORIAS_RANKING = CATEGORIAS_RANKING

local function construirQuadro(pasta, categoria)
	local posicao = Vector3.new(205, CHAO + 23, categoria.z)
	local cf = CFrame.lookAt(posicao, Vector3.new(0, posicao.Y, categoria.z))
	local quadro = parte({
		Name = "Ranking" .. categoria.id,
		Size = Vector3.new(30, 40, 1),
		CFrame = cf,
		Color = Color3.fromRGB(20, 22, 32),
		Material = Enum.Material.SmoothPlastic,
		Parent = pasta,
	})
	parte({ Name = "Suporte", Size = Vector3.new(32, 3, 4), CFrame = cf * CFrame.new(0, -21.5, 0),
		Color = Color3.fromRGB(40, 40, 50), Material = Enum.Material.Metal, Parent = pasta })
	enfeite({ Name = "Moldura", Size = Vector3.new(31, 41, 0.6), CFrame = cf * CFrame.new(0, 0, 0.5),
		Color = categoria.cor, Material = Enum.Material.Neon, Parent = pasta })

	local gui = superficie(quadro, Enum.NormalId.Front, 20)
	local cabecalho = Instance.new("Frame")
	cabecalho.Size = UDim2.fromScale(1, 0.12)
	cabecalho.BackgroundColor3 = categoria.cor
	cabecalho.BorderSizePixel = 0
	cabecalho.Parent = gui
	texto(cabecalho, { Text = categoria.titulo, Size = UDim2.fromScale(0.94, 0.8), Position = UDim2.fromScale(0.03, 0.1) })
	texto(gui, {
		Text = categoria.subtitulo,
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromRGB(200, 200, 210),
		Size = UDim2.fromScale(0.9, 0.04),
		Position = UDim2.fromScale(0.05, 0.135),
	})

	local lista = Instance.new("Frame")
	lista.BackgroundTransparency = 1
	lista.Size = UDim2.fromScale(0.94, 0.75)
	lista.Position = UDim2.fromScale(0.03, 0.19)
	lista.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0.008, 0)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = lista

	local medalhas = { Color3.fromRGB(255, 200, 40), Color3.fromRGB(200, 200, 215), Color3.fromRGB(205, 130, 70) }
	local linhas = {}
	for i = 1, 10 do
		local linha = Instance.new("Frame")
		linha.LayoutOrder = i
		linha.Size = UDim2.fromScale(1, 0.092)
		linha.BackgroundColor3 = i % 2 == 0 and Color3.fromRGB(34, 37, 52) or Color3.fromRGB(42, 46, 64)
		linha.BorderSizePixel = 0
		linha.Parent = lista
		local canto = Instance.new("UICorner")
		canto.CornerRadius = UDim.new(0.2, 0)
		canto.Parent = linha
		local posicaoTexto = texto(linha, { Text = "#" .. i, TextColor3 = medalhas[i] or Color3.fromRGB(255, 255, 255),
			Size = UDim2.fromScale(0.14, 0.8), Position = UDim2.fromScale(0.02, 0.1) })
		local nome = texto(linha, { Text = "—", Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.fromScale(0.5, 0.7), Position = UDim2.fromScale(0.18, 0.15) })
		local valor = texto(linha, { Text = "", TextColor3 = categoria.cor, TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromScale(0.3, 0.7), Position = UDim2.fromScale(0.68, 0.15) })
		linhas[i] = { posicao = posicaoTexto, nome = nome, valor = valor }
	end

	local rodape = texto(gui, {
		Text = "Carregando ranking...",
		Font = Enum.Font.GothamBold,
		TextColor3 = Color3.fromRGB(170, 170, 185),
		Size = UDim2.fromScale(0.9, 0.035),
		Position = UDim2.fromScale(0.05, 0.955),
	})

	return { linhas = linhas, rodape = rodape }
end

--------------------------------------------------------------------------
-- BASES (prédio de 3 andares com elevador)
--------------------------------------------------------------------------
local ALTURA_ANDAR = 14
local ANDARES = 3
Mapa.ALTURA_ANDAR = ALTURA_ANDAR
Mapa.ANDARES = ANDARES

-- Coloca um modelo montado na origem no lugar certo (antes de entrar no workspace)
local function colocarModelo(modelo, cf, pai)
	for _, p in modelo:GetDescendants() do
		if p:IsA("BasePart") then
			p.CFrame = cf * p.CFrame
			p.Anchored = true
		end
	end
	modelo.Parent = pai
end
Mapa.colocarModelo = colocarModelo

local function construirBase(pasta, indice, centro, cor)
	-- A frente da base (eixo -Z local) aponta para a passarela (z = 0).
	-- Bases do lado negativo giram 180 graus para olhar para +Z.
	local cf = CFrame.new(centro)
	if centro.Z < 0 then
		cf *= CFrame.Angles(0, math.pi, 0)
	end
	local P = ALTURA_PISO
	local corParede = Color3.fromRGB(45, 48, 62)
	local corPiso = cor:Lerp(Color3.fromRGB(40, 40, 50), 0.55)
	local metade = TAMANHO_BASE / 2
	local alturaTotal = ALTURA_ANDAR * ANDARES

	local modelo = Instance.new("Model")
	modelo.Name = "Base" .. indice
	modelo.Parent = pasta

	-- Piso térreo e bordas neon
	parte({ Name = "Piso", Size = Vector3.new(TAMANHO_BASE, 1, TAMANHO_BASE), CFrame = cf * CFrame.new(0, P - 0.5, 0),
		Color = corPiso, Material = Enum.Material.SmoothPlastic, Parent = modelo })
	for _, info in {
		{ Vector3.new(TAMANHO_BASE, 0.15, 0.8), Vector3.new(0, 0, -metade + 0.4) },
		{ Vector3.new(0.8, 0.15, TAMANHO_BASE), Vector3.new(metade - 0.4, 0, 0) },
		{ Vector3.new(0.8, 0.15, TAMANHO_BASE), Vector3.new(-metade + 0.4, 0, 0) },
	} do
		enfeite({ Name = "BordaPiso", Size = info[1], CFrame = cf * CFrame.new(info[2] + Vector3.new(0, P + 0.03, 0)),
			Color = cor, Material = Enum.Material.Neon, Parent = modelo })
	end

	-- Lajes dos andares de cima e o teto
	for andar = 2, ANDARES + 1 do
		local y = P + ALTURA_ANDAR * (andar - 1)
		local teto = andar > ANDARES
		parte({ Name = teto and "Teto" or ("Laje" .. andar), Size = Vector3.new(TAMANHO_BASE, 1, TAMANHO_BASE),
			CFrame = cf * CFrame.new(0, y - 0.5, 0), Color = teto and corParede or corPiso, Material = Enum.Material.SmoothPlastic, Parent = modelo })
		enfeite({ Name = "BordaLaje", Size = Vector3.new(TAMANHO_BASE + 0.4, 0.5, 0.6), CFrame = cf * CFrame.new(0, y - 0.25, -metade - 0.05),
			Color = cor, Material = Enum.Material.Neon, Parent = modelo })
		-- Luzes no teto do andar de baixo
		for _, x in { -12, 12 } do
			enfeite({ Name = "LuzTeto", Size = Vector3.new(2, 0.15, 30), CFrame = cf * CFrame.new(x, y - 1.08, 2),
				Color = Color3.fromRGB(255, 245, 225), Material = Enum.Material.Neon, Parent = modelo })
		end
		local luz = Instance.new("PointLight")
		luz.Range = 26
		luz.Brightness = 0.9
		luz.Color = Color3.fromRGB(255, 240, 220)
		luz.Parent = modelo:FindFirstChild(teto and "Teto" or ("Laje" .. andar))
	end

	-- Paredes do prédio
	local paredes = {
		{ "ParedeFundo", Vector3.new(TAMANHO_BASE, alturaTotal, 1), Vector3.new(0, P + alturaTotal / 2, metade - 0.5) },
		{ "ParedeEsquerda", Vector3.new(1, alturaTotal, TAMANHO_BASE), Vector3.new(-metade + 0.5, P + alturaTotal / 2, 0) },
		{ "ParedeDireita", Vector3.new(1, alturaTotal, TAMANHO_BASE), Vector3.new(metade - 0.5, P + alturaTotal / 2, 0) },
	}
	for _, info in paredes do
		parte({ Name = info[1], Size = info[2], CFrame = cf * CFrame.new(info[3]), Color = corParede,
			Material = Enum.Material.SmoothPlastic, Parent = modelo })
	end
	-- Janelas de vidro do lado de fora, uma faixa por andar
	for andar = 1, ANDARES do
		local y0 = P + ALTURA_ANDAR * (andar - 1)
		for _, lado in { -1, 1 } do
			enfeite({ Name = "Janela", Size = Vector3.new(0.4, 6, 34), CFrame = cf * CFrame.new(lado * (metade + 0.15), y0 + 7.5, 0),
				Color = Color3.fromRGB(150, 205, 255), Material = Enum.Material.Glass, Transparency = 0.25, Parent = modelo })
			for _, dy in { 4.35, 10.65 } do
				enfeite({ Name = "MolduraJanela", Size = Vector3.new(0.6, 0.3, 34.4), CFrame = cf * CFrame.new(lado * (metade + 0.2), y0 + dy, 0),
					Color = cor, Material = Enum.Material.Neon, Parent = modelo })
			end
		end
		-- placa do andar na parede do fundo
		local placaAndar = parte({ Name = "PlacaAndar", Size = Vector3.new(12, 2.6, 0.3), CFrame = cf * CFrame.new(0, y0 + 10.5, metade - 1.2),
			Color = Color3.fromRGB(20, 22, 30), Parent = modelo })
		local gui = superficie(placaAndar, Enum.NormalId.Front, 25)
		texto(gui, { Text = andar .. "º ANDAR", TextColor3 = cor })
	end
	for _, info in {
		{ Vector3.new(TAMANHO_BASE + 0.6, 0.8, 1.6), Vector3.new(0, P + alturaTotal + 0.4, metade - 0.5) },
		{ Vector3.new(1.6, 0.8, TAMANHO_BASE + 0.6), Vector3.new(-metade + 0.5, P + alturaTotal + 0.4, 0) },
		{ Vector3.new(1.6, 0.8, TAMANHO_BASE + 0.6), Vector3.new(metade - 0.5, P + alturaTotal + 0.4, 0) },
	} do
		enfeite({ Name = "Friso", Size = info[1], CFrame = cf * CFrame.new(info[2]), Color = cor, Material = Enum.Material.Neon, Parent = modelo })
	end

	-- Pilares da frente
	for _, x in { -metade + 0.5, metade - 0.5 } do
		parte({ Name = "Pilar", Size = Vector3.new(2.4, alturaTotal + 2, 2.4), CFrame = cf * CFrame.new(x, P + (alturaTotal + 2) / 2, -metade + 0.5),
			Color = corParede, Material = Enum.Material.SmoothPlastic, Parent = modelo })
		enfeite({ Name = "TopoPilar", Size = Vector3.new(3, 1, 3), CFrame = cf * CFrame.new(x, P + alturaTotal + 2.5, -metade + 0.5),
			Color = cor, Material = Enum.Material.Neon, Parent = modelo })
	end

	-- Guarda-corpo de vidro na frente dos andares de cima
	for andar = 2, ANDARES do
		local y0 = P + ALTURA_ANDAR * (andar - 1)
		parte({ Name = "GuardaCorpo", Size = Vector3.new(TAMANHO_BASE - 2, 3.5, 0.3), CFrame = cf * CFrame.new(0, y0 + 1.75, -metade + 0.3),
			Color = Color3.fromRGB(170, 220, 255), Material = Enum.Material.Glass, Transparency = 0.5, Parent = modelo })
		enfeite({ Name = "Corrimao", Size = Vector3.new(TAMANHO_BASE - 2, 0.3, 0.45), CFrame = cf * CFrame.new(0, y0 + 3.6, -metade + 0.3),
			Color = cor, Material = Enum.Material.Neon, Parent = modelo })
	end

	-- Barreira laser na entrada do térreo (só aparece quando a base está trancada)
	local barreira = parte({
		Name = "Barreira",
		Size = Vector3.new(TAMANHO_BASE - 1.5, ALTURA_ANDAR - 1, 0.4),
		CFrame = cf * CFrame.new(0, P + (ALTURA_ANDAR - 1) / 2, -metade + 0.4),
		Color = Color3.fromRGB(255, 40, 40),
		Material = Enum.Material.Neon,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CastShadow = false,
		Parent = modelo,
	})
	local grupoBarreira = "Barreira" .. indice
	local grupoDono = "Dono" .. indice
	for _, grupo in { grupoBarreira, grupoDono } do
		if not PhysicsService:IsCollisionGroupRegistered(grupo) then
			PhysicsService:RegisterCollisionGroup(grupo)
		end
	end
	PhysicsService:CollisionGroupSetCollidable(grupoBarreira, grupoDono, false)
	barreira.CollisionGroup = grupoBarreira

	-- Placa com o nome do dono no alto do prédio, virada para a passarela
	local yTeto = P + alturaTotal
	for _, x in { -12, 12 } do
		parte({ Name = "SuportePlaca", Size = Vector3.new(0.8, 3, 0.8), CFrame = cf * CFrame.new(x, yTeto + 1.5, -metade + 3),
			Color = corParede, Parent = modelo })
	end
	local placa = parte({ Name = "Placa", Size = Vector3.new(34, 7, 0.8), CFrame = cf * CFrame.new(0, yTeto + 6, -metade + 3),
		Color = Color3.fromRGB(20, 22, 30), Material = Enum.Material.SmoothPlastic, Parent = modelo })
	enfeite({ Name = "MolduraPlaca", Size = Vector3.new(35, 8, 0.4), CFrame = cf * CFrame.new(0, yTeto + 6, -metade + 3.5),
		Color = cor, Material = Enum.Material.Neon, Parent = modelo })
	local guiPlaca = superficie(placa, Enum.NormalId.Front, 25)
	local textoPlaca = texto(guiPlaca, { Text = "BASE LIVRE", Size = UDim2.fromScale(0.95, 0.6), Position = UDim2.fromScale(0.025, 0.05) })
	local textoRenda = texto(guiPlaca, { Text = "", TextColor3 = Color3.fromRGB(80, 255, 120),
		Size = UDim2.fromScale(0.9, 0.32), Position = UDim2.fromScale(0.05, 0.65) })

	-- Botão de trancar (térreo, canto direito da entrada)
	local botao = cilindroEmPe({ Name = "BotaoTrancar", Size = Vector3.new(0.5, 6, 6), Color = Color3.fromRGB(60, 220, 90),
		Material = Enum.Material.Neon, Parent = modelo }, cf * CFrame.new(16, P + 0.25, -17))
	local guiBotao = billboard(botao, 200, 50, Vector3.new(0, 3.5, 0), 70)
	local textoBotao = texto(guiBotao, { Text = "🔒 TRANCAR BASE" })

	-- Elevador de vidro no canto esquerdo da entrada
	cilindroEmPe({ Name = "PocoElevador", Size = Vector3.new(alturaTotal, 6.2, 6.2), Color = Color3.fromRGB(170, 230, 255),
		Material = Enum.Material.Glass, Transparency = 0.75, CanCollide = false, CanQuery = false, CastShadow = false, Parent = modelo },
		cf * CFrame.new(-17, P + alturaTotal / 2, -16))
	local elevadores = {}
	for andar = 1, ANDARES do
		local y0 = P + ALTURA_ANDAR * (andar - 1)
		local plataforma = cilindroEmPe({ Name = "Elevador" .. andar, Size = Vector3.new(0.3, 5, 5), Color = Color3.fromRGB(80, 230, 255),
			Material = Enum.Material.Neon, Parent = modelo }, cf * CFrame.new(-17, y0 + 0.15, -16))
		cilindroEmPe({ Name = "AnelElevador", Size = Vector3.new(0.4, 6.4, 6.4), Color = cor, Material = Enum.Material.Neon,
			CanCollide = false, Parent = modelo }, cf * CFrame.new(-17, y0 + ALTURA_ANDAR - 1.4, -16))
		local gui = billboard(plataforma, 180, 44, Vector3.new(0, 4.5, 0), 45)
		texto(gui, { Text = "🛗 ELEVADOR • " .. andar .. "º" })
		elevadores[andar] = {
			plataforma = plataforma,
			andar = andar,
			saida = cf * CFrame.new(-17, y0 + 3.2, -10),
		}
	end

	-- Ponto de entrega (para a seta de "leve até sua base")
	local alvo = parte({ Name = "AlvoEntrega", Size = Vector3.new(1, 1, 1), CFrame = cf * CFrame.new(0, P + 3, -6),
		Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, Parent = modelo })
	local anexo = Instance.new("Attachment")
	anexo.Name = "Alvo"
	anexo.Parent = alvo

	local base = {
		indice = indice,
		cor = cor,
		cframe = cf,
		modelo = modelo,
		barreira = barreira,
		botao = botao,
		textoPlaca = textoPlaca,
		textoRenda = textoRenda,
		textoBotao = textoBotao,
		grupoDono = grupoDono,
		spawn = cf * CFrame.new(0, P + 3.2, -16),
		saida = cf * CFrame.new(0, P + 3.2, -metade - 8),
		elevadores = elevadores,
		slots = {},
	}

	-- 8 pedestais por andar (2 fileiras de 4). A ordem é: térreo, 2º andar, 3º andar.
	for andar = 1, ANDARES do
		local y0 = P + ALTURA_ANDAR * (andar - 1)
		for _, z in { 0, 12 } do
			for _, x in { -15, -5, 5, 15 } do
				local pedestal = cilindroEmPe({ Name = "Pedestal", Size = Vector3.new(1.2, 7, 7), Color = Color3.fromRGB(235, 235, 240),
					Material = Enum.Material.Marble, Parent = modelo }, cf * CFrame.new(x, y0 + 0.6, z))
				local anel = cilindroEmPe({ Name = "Anel", Size = Vector3.new(0.25, 7.8, 7.8), Color = cor,
					Material = Enum.Material.Neon, CastShadow = false, Parent = modelo }, cf * CFrame.new(x, y0 + 0.125, z))
				local pad = parte({ Name = "Coletar", Size = Vector3.new(5, 0.3, 2.4), CFrame = cf * CFrame.new(x, y0 + 0.15, z - 5.6),
					Color = Color3.fromRGB(60, 220, 100), Material = Enum.Material.Neon, Parent = modelo })

				local guiPad = billboard(pad, 160, 40, Vector3.new(0, 2.2, 0), 50)
				guiPad.Enabled = false
				local textoPad = texto(guiPad, { Text = "💰 $0", TextColor3 = Color3.fromRGB(120, 255, 140) })

				local guiCadeado = billboard(pedestal, 170, 60, Vector3.new(0, 3, 0), 60)
				guiCadeado.Enabled = false
				texto(guiCadeado, { Text = "🔒\nCompre na Loja", Font = Enum.Font.GothamBold })

				table.insert(base.slots, {
					indice = #base.slots + 1,
					andar = andar,
					base = base,
					topo = cf * CFrame.new(x, y0 + 1.2, z),
					pedestal = pedestal,
					anel = anel,
					pad = pad,
					guiPad = guiPad,
					textoPad = textoPad,
					guiCadeado = guiCadeado,
					acumulado = 0,
					heroi = nil,
				})
			end
		end
	end

	return base
end

--------------------------------------------------------------------------
-- TENDA DA LOJA (fica entre as bases 2 e 3)
--------------------------------------------------------------------------
local function construirLoja(pasta, Config, Modelos)
	local centro = Vector3.new(0, CHAO, -30)
	local cf = CFrame.new(centro) * CFrame.Angles(0, math.pi, 0) -- frente virada para a passarela
	local modelo = Instance.new("Model")
	modelo.Name = "Loja"
	modelo.Parent = pasta
	local vermelho, branco = Color3.fromRGB(215, 35, 45), Color3.fromRGB(250, 245, 235)
	local dourado = Color3.fromRGB(255, 200, 40)

	parte({ Name = "Chao", Size = Vector3.new(18, 0.5, 13), CFrame = cf * CFrame.new(0, 0.25, 0),
		Color = Color3.fromRGB(150, 100, 60), Material = Enum.Material.Wood, Parent = modelo })
	for _, x in { -8.4, 8.4 } do
		for _, z in { -6, 6 } do
			cilindroEmPe({ Name = "Mastro", Size = Vector3.new(8.5, 0.6, 0.6), Color = dourado, Material = Enum.Material.Metal, Parent = modelo },
				cf * CFrame.new(x, 4.75, z))
		end
	end
	-- Telhado listrado com duas águas
	local inclinacao = math.atan(3.5 / 6.6)
	local comprimento = math.sqrt(6.6 ^ 2 + 3.5 ^ 2) + 0.2
	for i = 0, 5 do
		local x = -7.5 + i * 3
		local cor = i % 2 == 0 and vermelho or branco
		parte({ Name = "Telhado", Size = Vector3.new(3, 0.3, comprimento), CFrame = cf * CFrame.new(x, 10.75, -3.3) * CFrame.Angles(-inclinacao, 0, 0),
			Color = cor, Material = Enum.Material.Fabric, Parent = modelo })
		parte({ Name = "Telhado", Size = Vector3.new(3, 0.3, comprimento), CFrame = cf * CFrame.new(x, 10.75, 3.3) * CFrame.Angles(inclinacao, 0, 0),
			Color = cor, Material = Enum.Material.Fabric, Parent = modelo })
	end
	parte({ Name = "Cumeeira", Shape = Enum.PartType.Cylinder, Size = Vector3.new(18.4, 0.6, 0.6), CFrame = cf * CFrame.new(0, 12.55, 0),
		Color = dourado, Material = Enum.Material.Metal, Parent = modelo })
	-- Franja de bolinhas nas bordas do telhado
	for x = -8.5, 8.5, 1 do
		for _, z in { -6.75, 6.75 } do
			enfeite({ Name = "Franja", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = cf * CFrame.new(x, 8.85, z),
				Color = (math.floor(x + 9) % 2 == 0) and vermelho or branco, Parent = modelo })
		end
	end
	enfeite({ Name = "Bandeira", Size = Vector3.new(0.2, 3, 0.2), CFrame = cf * CFrame.new(0, 14.2, 0), Color = dourado, Parent = modelo })
	enfeite({ Name = "Bandeirinha", Size = Vector3.new(2, 1.2, 0.1), CFrame = cf * CFrame.new(1.1, 15, 0), Color = dourado,
		Material = Enum.Material.Neon, Parent = modelo })
	-- Fundo de pano
	parte({ Name = "Fundo", Size = Vector3.new(16.8, 8.5, 0.3), CFrame = cf * CFrame.new(0, 4.75, 6.1), Color = vermelho,
		Material = Enum.Material.Fabric, Parent = modelo })

	-- Balcão com produtos
	local balcao = parte({ Name = "Balcao", Size = Vector3.new(14, 3.2, 2.2), CFrame = cf * CFrame.new(0, 2.1, -4.4),
		Color = Color3.fromRGB(130, 85, 45), Material = Enum.Material.Wood, Parent = modelo })
	parte({ Name = "TampoBalcao", Size = Vector3.new(14.6, 0.3, 2.6), CFrame = cf * CFrame.new(0, 3.85, -4.4),
		Color = Color3.fromRGB(235, 195, 125), Material = Enum.Material.Wood, Parent = modelo })
	local plaquinha = parte({ Name = "PlacaBalcao", Size = Vector3.new(10, 1.8, 0.2), CFrame = cf * CFrame.new(0, 2.3, -5.6),
		Color = Color3.fromRGB(25, 25, 35), Parent = modelo })
	texto(superficie(plaquinha, Enum.NormalId.Front, 30), { Text = "🥊 LUVAS • 🌀 MOLAS • ⬆ MELHORIAS", TextColor3 = dourado })

	for i, luva in Config.Luvas do
		local modeloLuva = Modelos.luva(luva)
		colocarModelo(modeloLuva, cf * CFrame.new(-6.2 + (i - 1) * 2.4, 4.75, -4.4) * CFrame.Angles(0, math.rad(200), 0), modelo)
	end
	local mola = Modelos.mola()
	colocarModelo(mola, cf * CFrame.new(5.8, 4.1, -4.4), modelo)

	-- Vendedor atrás do balcão
	local vendedorDef = {
		id = "Vendedor", nome = "Vendedor", raridade = "Comum", preco = 0, renda = 0,
		visual = { pele = Color3.fromRGB(224, 172, 120), cabelo = Color3.fromRGB(40, 25, 15), camisa = Color3.fromRGB(60, 120, 200),
			calca = Color3.fromRGB(50, 50, 60), cabeca = "bone", cabecaCor = dourado, corpo = { "avental" } },
	}
	parte({ Name = "Degrau", Size = Vector3.new(5, 1.2, 3), CFrame = cf * CFrame.new(0, 1.1, -1.4), Color = Color3.fromRGB(110, 70, 40),
		Material = Enum.Material.Wood, Parent = modelo })
	local vendedor = Modelos.heroi(vendedorDef, Config.MutacaoPorId.Normal, Config, { semPlaca = true, escala = 1.6 })
	colocarModelo(vendedor, cf * CFrame.new(0, 1.7 + 2.03 * 1.6, -1.4), modelo)

	local luz = Instance.new("PointLight")
	luz.Color = Color3.fromRGB(255, 220, 170)
	luz.Range = 22
	luz.Brightness = 1.5
	luz.Parent = modelo:FindFirstChild("Cumeeira")
	local guiTitulo = billboard(modelo:FindFirstChild("Cumeeira"), 340, 90, Vector3.new(0, 5, 0), 260)
	texto(guiTitulo, { Text = "🎪 LOJA DOS HERÓIS", TextColor3 = dourado, Size = UDim2.fromScale(1, 0.6) })
	texto(guiTitulo, { Text = "Luvas • Molas • Melhorias", Font = Enum.Font.GothamBold, Size = UDim2.fromScale(1, 0.35), Position = UDim2.fromScale(0, 0.62) })

	return { modelo = modelo, balcao = balcao, centro = cf.Position }
end

--------------------------------------------------------------------------
-- ROLETA DA SORTE (fica entre as bases 6 e 7)
--------------------------------------------------------------------------
local function construirRoleta(pasta, Config)
	local centro = Vector3.new(0, CHAO, 30)
	local cf = CFrame.new(centro) -- a frente (-Z) já olha para a passarela
	local modelo = Instance.new("Model")
	modelo.Name = "Roleta"
	modelo.Parent = pasta
	local dourado = Color3.fromRGB(255, 200, 40)

	parte({ Name = "Base", Size = Vector3.new(16, 0.6, 9), CFrame = cf * CFrame.new(0, 0.3, 0), Color = Color3.fromRGB(35, 30, 50), Parent = modelo })
	enfeite({ Name = "BordaBase", Size = Vector3.new(16.4, 0.3, 9.4), CFrame = cf * CFrame.new(0, 0.2, 0), Color = Color3.fromRGB(255, 80, 200),
		Material = Enum.Material.Neon, Parent = modelo })
	for _, x in { -7, 7 } do
		parte({ Name = "Coluna", Size = Vector3.new(1.2, 12, 1.2), CFrame = cf * CFrame.new(x, 6.6, 1), Color = dourado,
			Material = Enum.Material.Metal, Parent = modelo })
	end
	parte({ Name = "Travessa", Size = Vector3.new(15.2, 1, 1), CFrame = cf * CFrame.new(0, 11, 1), Color = dourado,
		Material = Enum.Material.Metal, Parent = modelo })

	-- Roda: tudo soldado num eixo invisível que gira
	local cf0 = cf * CFrame.new(0, 11, -0.2)
	local eixo = parte({ Name = "Eixo", Size = Vector3.new(1, 1, 1), CFrame = cf0, Transparency = 1, CanCollide = false,
		CanQuery = false, CanTouch = false, Parent = modelo })
	local function pecaRoda(propriedades, local_)
		propriedades.CFrame = cf0 * local_
		propriedades.Anchored = false
		propriedades.CanCollide = false
		propriedades.Massless = true
		propriedades.CastShadow = false
		propriedades.Parent = modelo
		local p = parte(propriedades)
		local solda = Instance.new("WeldConstraint")
		solda.Part0 = eixo
		solda.Part1 = p
		solda.Parent = p
		return p
	end
	local DE_FRENTE_RODA = CFrame.Angles(0, math.rad(90), 0)
	pecaRoda({ Name = "Aro", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 13.4, 13.4), Color = dourado, Material = Enum.Material.Foil },
		CFrame.new(0, 0, 0.15) * DE_FRENTE_RODA)
	pecaRoda({ Name = "Disco", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 12.4, 12.4), Color = Color3.fromRGB(30, 28, 45) },
		DE_FRENTE_RODA)
	local premios = Config.Roleta.Premios
	for i, premio in premios do
		local angulo = (i - 1) * (math.pi * 2 / #premios)
		local fatia = pecaRoda({ Name = "Fatia" .. i, Size = Vector3.new(3.5, 5.2, 0.12), Color = premio.cor, Material = Enum.Material.SmoothPlastic },
			CFrame.new(math.sin(angulo) * 3.3, math.cos(angulo) * 3.3, -0.36 - (i % 2) * 0.02) * CFrame.Angles(0, 0, -angulo))
		local gui = superficie(fatia, Enum.NormalId.Front, 30)
		texto(gui, { Text = premio.icone, Size = UDim2.fromScale(1, 0.45), Position = UDim2.fromScale(0, 0.08), TextStrokeTransparency = 1 })
		texto(gui, { Text = premio.curto, Size = UDim2.fromScale(0.9, 0.25), Position = UDim2.fromScale(0.05, 0.55) })
	end
	pecaRoda({ Name = "Centro", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 2.2, 2.2), Color = dourado, Material = Enum.Material.Neon },
		CFrame.new(0, 0, -0.5) * DE_FRENTE_RODA)
	for i = 1, 16 do
		local a = (i / 16) * math.pi * 2
		pecaRoda({ Name = "Lampada", Shape = Enum.PartType.Ball, Size = Vector3.new(0.5, 0.5, 0.5),
			Color = i % 2 == 0 and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 80, 200), Material = Enum.Material.Neon },
			CFrame.new(math.sin(a) * 6.35, math.cos(a) * 6.35, -0.35))
	end
	-- Ponteiro fixo no topo
	enfeite({ Name = "Ponteiro", Size = Vector3.new(1.3, 1.3, 0.5), CFrame = cf0 * CFrame.new(0, 7.1, -0.7) * CFrame.Angles(0, 0, math.rad(45)),
		Color = Color3.fromRGB(255, 40, 60), Material = Enum.Material.Neon, Parent = modelo })

	local botao = cilindroEmPe({ Name = "BotaoRoleta", Size = Vector3.new(0.6, 4, 4), Color = Color3.fromRGB(255, 80, 200),
		Material = Enum.Material.Neon, Parent = modelo }, cf * CFrame.new(0, 0.9, -5.6))
	local guiBotao = billboard(botao, 180, 44, Vector3.new(0, 3, 0), 60)
	texto(guiBotao, { Text = "🎡 GIRAR" })
	local guiTitulo = billboard(modelo:FindFirstChild("Travessa"), 340, 90, Vector3.new(0, 6.5, 0), 260)
	texto(guiTitulo, { Text = "🎡 ROLETA DA SORTE", TextColor3 = Color3.fromRGB(255, 120, 220), Size = UDim2.fromScale(1, 0.6) })
	texto(guiTitulo, { Text = "Grátis a cada " .. Config.Roleta.IntervaloHoras .. " horas!", Font = Enum.Font.GothamBold,
		Size = UDim2.fromScale(1, 0.35), Position = UDim2.fromScale(0, 0.62) })

	return { modelo = modelo, eixo = eixo, cf0 = cf0, botao = botao, centro = cf.Position }
end

--------------------------------------------------------------------------
-- MONTAGEM
--------------------------------------------------------------------------
function Mapa.construir(Config, Modelos)
	local G = Config.Geral

	if G.RemoverBaseplate then
		for _, nome in { "Baseplate", "SpawnLocation" } do
			local objeto = workspace:FindFirstChild(nome)
			if objeto then
				objeto:Destroy()
			end
		end
	end
	local antigo = workspace:FindFirstChild("MapaHerois")
	if antigo then
		antigo:Destroy()
	end

	local pasta = pastaNova("MapaHerois", workspace)
	local cenario = pastaNova("Cenario", pasta)
	local pastaBases = pastaNova("Bases", pasta)
	local pastaHerois = pastaNova("Herois", pasta)
	local pastaRanking = pastaNova("Ranking", pasta)

	local correcaoCor = configurarIluminacao(G.HoraInicial)
	construirChao(cenario)
	local inicio = construirPassarela(cenario, G.ComprimentoPassarela)
	construirPostes(cenario, G.ComprimentoPassarela)
	construirLetreiro(cenario)
	construirArvores(cenario)
	construirCidade(cenario)

	local quadros = {}
	for _, categoria in CATEGORIAS_RANKING do
		quadros[categoria.id] = construirQuadro(pastaRanking, categoria)
	end

	-- Lugar onde nasce quem ficou sem base (servidor cheio)
	local spawnLobby = Instance.new("SpawnLocation")
	spawnLobby.Name = "SpawnLobby"
	spawnLobby.Anchored = true
	spawnLobby.Neutral = true
	spawnLobby.Duration = 0
	spawnLobby.Size = Vector3.new(10, 1, 10)
	spawnLobby.CFrame = CFrame.new(182, CHAO + 0.5, 0)
	spawnLobby.Color = Color3.fromRGB(255, 200, 40)
	spawnLobby.Material = Enum.Material.Neon
	spawnLobby.TopSurface = Enum.SurfaceType.Smooth
	spawnLobby.Parent = pasta

	local bases = {}
	for _, z in { -58, 58 } do
		for _, x in { -105, -35, 35, 105 } do
			local indice = #bases + 1
			table.insert(bases, construirBase(pastaBases, indice, Vector3.new(x, CHAO, z), CORES_BASES[indice]))
		end
	end

	local loja = construirLoja(pasta, Config, Modelos)
	local roleta = construirRoleta(pasta, Config)

	return {
		pasta = pasta,
		pastaHerois = pastaHerois,
		bases = bases,
		loja = loja,
		roleta = roleta,
		inicio = inicio,
		comprimento = G.ComprimentoPassarela,
		quadros = quadros,
		correcaoCor = correcaoCor,
	}
end

return Mapa
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="7">
      <Properties>
        <string name="Name">ModelosHerois</string>
        <string name="Source"><![CDATA[--[[
	ROUBE UM HERÓI - Modelos 3D (heróis, luvas, mola e vendedor)

	Onde colocar: ServerScriptService -> ModuleScript (nome: ModelosHerois)

	Cada herói é montado com peças em blocos (estilo Roblox) a partir da
	descrição "visual" que está no ConfigHerois: cores do uniforme, chapéu ou
	capacete, rosto, itens nas mãos, coisas nas costas e emblema no peito.
	Todas as peças ficam soldadas na peça principal (o tronco).
]]

local CollectionService = game:GetService("CollectionService")

local Modelos = {}

local BLOCO, BOLA, CILINDRO = Enum.PartType.Block, Enum.PartType.Ball, Enum.PartType.Cylinder
local LISO = Enum.Material.SmoothPlastic
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local VIDRO = Enum.Material.Glass
local FOLHA = Enum.Material.Foil

local PRETO = Color3.fromRGB(22, 22, 26)
local BRANCO = Color3.fromRGB(245, 245, 245)
local OURO = Color3.fromRGB(255, 200, 40)
local PRATA = Color3.fromRGB(195, 200, 210)
local VERMELHO = Color3.fromRGB(220, 35, 35)
local REFLETIVO = Color3.fromRGB(225, 230, 220)
local CASTANHO_PADRAO = Color3.fromRGB(60, 40, 25)

local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local EM_PE = ANG(0, 0, rad(90)) -- cilindro em pé (o eixo do cilindro no Roblox é o X)
local DE_FRENTE = ANG(0, rad(90), 0) -- cilindro com a face virada para a frente

--------------------------------------------------------------------------
-- Construtor: cria peças soldadas na raiz
--------------------------------------------------------------------------
local function novoConstrutor(modelo, raiz)
	local c = {}
	function c.peca(nome, forma, tamanho, cf, cor, material, opcoes)
		local p = Instance.new("Part")
		p.Name = nome
		p.Shape = forma
		p.Size = tamanho
		p.CFrame = raiz.CFrame * cf
		p.Color = cor
		p.Material = material or LISO
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.Massless = true
		p.Anchored = false
		if opcoes then
			if opcoes.transparencia then
				p.Transparency = opcoes.transparencia
			end
			if opcoes.pintavel then
				p:SetAttribute("Pintavel", true)
			end
		end
		p.Parent = modelo
		local solda = Instance.new("WeldConstraint")
		solda.Part0 = raiz
		solda.Part1 = p
		solda.Parent = p
		return p
	end
	-- Peça arredondada que pode ser achatada (esfera esticada)
	function c.elipse(nome, tamanho, cf, cor, material, opcoes)
		local p = c.peca(nome, BLOCO, tamanho, cf, cor, material, opcoes)
		local malha = Instance.new("SpecialMesh")
		malha.MeshType = Enum.MeshType.Sphere
		malha.Parent = p
		return p
	end
	-- Anel feito de várias peças pequenas (boia, laço)
	function c.anel(nome, raio, quantidade, tamanho, centro, cores, material)
		for i = 1, quantidade do
			local a = (i / quantidade) * math.pi * 2
			c.peca(nome, BLOCO, tamanho, centro * CF(math.cos(a) * raio, math.sin(a) * raio, 0) * ANG(0, 0, a),
				cores[(i - 1) % #cores + 1], material)
		end
	end
	return c
end

local function novaRaiz(modelo, nome, tamanho, cor, material)
	local raiz = Instance.new("Part")
	raiz.Name = nome
	raiz.Size = tamanho
	raiz.CFrame = CFrame.new()
	raiz.Color = cor
	raiz.Material = material or LISO
	raiz.TopSurface = Enum.SurfaceType.Smooth
	raiz.BottomSurface = Enum.SurfaceType.Smooth
	raiz.CanCollide = false
	raiz.CanTouch = false
	raiz.CanQuery = false
	raiz.Massless = true
	raiz.Anchored = true
	raiz.Parent = modelo
	return raiz
end

--------------------------------------------------------------------------
-- ROSTOS (ctx: c, s, yC = altura da cabeça, v = visual)
--------------------------------------------------------------------------
local function olhosEBoca(ctx, corOlhos)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	for _, lado in { -1, 1 } do
		c.peca("Olho", BOLA, V3(0.15, 0.15, 0.15) * s, CF(0.19 * s * lado, yC + 0.08 * s, -0.5 * s), corOlhos or PRETO)
		c.peca("Sobrancelha", BLOCO, V3(0.2, 0.04, 0.04) * s, CF(0.19 * s * lado, yC + 0.22 * s, -0.5 * s) * ANG(0, 0, rad(-8 * lado)),
			ctx.v.cabelo or PRETO)
	end
	c.peca("Boca", BLOCO, V3(0.3, 0.05, 0.05) * s, CF(0, yC - 0.2 * s, -0.51 * s), Color3.fromRGB(120, 40, 40))
end

local ROSTOS = {}
function ROSTOS.oculos(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	for _, lado in { -1, 1 } do
		c.peca("Lente", BLOCO, V3(0.3, 0.22, 0.05) * s, CF(0.2 * s * lado, yC + 0.08 * s, -0.56 * s), Color3.fromRGB(200, 230, 255), VIDRO,
			{ transparencia = 0.3 })
		c.peca("Armacao", BLOCO, V3(0.34, 0.04, 0.06) * s, CF(0.2 * s * lado, yC + 0.2 * s, -0.56 * s), PRETO)
	end
	c.peca("Ponte", BLOCO, V3(0.12, 0.04, 0.05) * s, CF(0, yC + 0.12 * s, -0.57 * s), PRETO)
end
function ROSTOS.oculosSol(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("OculosSol", BLOCO, V3(0.75, 0.2, 0.06) * s, CF(0, yC + 0.08 * s, -0.56 * s), PRETO, VIDRO)
end
function ROSTOS.oculosProtecao(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Faixa", BLOCO, V3(1.14, 0.14, 1.14) * s, CF(0, yC + 0.1 * s, 0), Color3.fromRGB(40, 40, 40))
	c.peca("LenteProtecao", BLOCO, V3(0.8, 0.3, 0.12) * s, CF(0, yC + 0.1 * s, -0.56 * s), Color3.fromRGB(170, 255, 200), VIDRO,
		{ transparencia = 0.25 })
end
function ROSTOS.mascaraCirurgica(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.elipse("Mascara", V3(0.75, 0.4, 0.3) * s, CF(0, yC - 0.17 * s, -0.46 * s), Color3.fromRGB(150, 210, 240))
end
function ROSTOS.mascaraMergulho(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Tira", BLOCO, V3(1.16, 0.14, 1.16) * s, CF(0, yC + 0.1 * s, 0), PRETO)
	c.peca("Moldura", BLOCO, V3(0.85, 0.42, 0.14) * s, CF(0, yC + 0.08 * s, -0.55 * s), PRETO)
	c.peca("Visor", BLOCO, V3(0.72, 0.3, 0.06) * s, CF(0, yC + 0.08 * s, -0.63 * s), Color3.fromRGB(110, 200, 255), VIDRO,
		{ transparencia = 0.2 })
	c.peca("Snorkel", BLOCO, V3(0.1, 0.8, 0.1) * s, CF(0.55 * s, yC + 0.25 * s, -0.1 * s), Color3.fromRGB(255, 200, 0))
end

--------------------------------------------------------------------------
-- CABEÇAS (chapéus, capacetes, máscaras de super-herói)
--------------------------------------------------------------------------
local CABECAS = {}
local CABECAS_SEM_ROSTO = { capaceteAstronauta = true, capuzAranha = true, capuzMorcego = true, capaceteArmadura = true }

local function cabelo(ctx, estilo)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabelo or Color3.fromRGB(60, 40, 25)
	c.elipse("Cabelo", V3(1.16, 0.72, 1.18) * s, CF(0, yC + 0.24 * s, 0.06 * s), cor)
	if estilo == "coque" then
		c.peca("Coque", BOLA, V3(0.45, 0.45, 0.45) * s, CF(0, yC + 0.5 * s, 0.45 * s), cor)
	elseif estilo == "longo" then
		c.peca("CabeloLongo", BLOCO, V3(1.0, 1.15, 0.3) * s, CF(0, yC - 0.3 * s, 0.42 * s), cor)
	elseif estilo == "espetado" then
		for i = -1, 1 do
			c.peca("Mecha", BLOCO, V3(0.22, 0.45, 0.22) * s, CF(i * 0.3 * s, yC + 0.62 * s, 0.05 * s) * ANG(0, 0, rad(-i * 25)), cor)
		end
	elseif estilo == "cacho" then
		c.peca("Cacho", BOLA, V3(0.2, 0.2, 0.2) * s, CF(0.1 * s, yC + 0.4 * s, -0.5 * s), cor)
	end
end

function CABECAS.cabelo(ctx)
	cabelo(ctx, ctx.v.estiloCabelo)
end
function CABECAS.bone(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.elipse("Bone", V3(1.17, 0.62, 1.18) * s, CF(0, yC + 0.28 * s, 0.02 * s), cor)
	c.peca("Aba", BLOCO, V3(0.72, 0.07, 0.5) * s, CF(0, yC + 0.12 * s, -0.66 * s), cor)
end
function CABECAS.quepe(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.peca("Faixa", CILINDRO, V3(0.32, 1.17, 1.17) * s, CF(0, yC + 0.32 * s, 0) * EM_PE, cor)
	c.peca("Topo", CILINDRO, V3(0.14, 1.38, 1.38) * s, CF(0, yC + 0.52 * s, -0.05 * s) * EM_PE, cor)
	c.peca("Aba", BLOCO, V3(0.8, 0.06, 0.45) * s, CF(0, yC + 0.18 * s, -0.66 * s), PRETO)
	c.peca("Insignia", BLOCO, V3(0.2, 0.2, 0.05) * s, CF(0, yC + 0.34 * s, -0.6 * s) * ANG(0, 0, rad(45)), OURO, NEON)
end
function CABECAS.capaceteBombeiro(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.elipse("Capacete", V3(1.3, 0.88, 1.35) * s, CF(0, yC + 0.3 * s, 0), cor, LISO)
	c.peca("Crista", BLOCO, V3(0.14, 0.24, 1.22) * s, CF(0, yC + 0.7 * s, 0.02 * s), cor)
	c.peca("AbaTras", BLOCO, V3(1.3, 0.08, 0.6) * s, CF(0, yC + 0.02 * s, 0.6 * s) * ANG(rad(-15), 0, 0), cor)
	c.peca("Escudo", BLOCO, V3(0.45, 0.42, 0.06) * s, CF(0, yC + 0.5 * s, -0.66 * s), OURO, FOLHA)
end
function CABECAS.toucaMedica(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.elipse("Touca", V3(1.18, 0.72, 1.18) * s, CF(0, yC + 0.27 * s, 0.03 * s), cor)
	c.peca("CruzA", BLOCO, V3(0.08, 0.24, 0.04) * s, CF(0, yC + 0.4 * s, -0.56 * s), VERMELHO)
	c.peca("CruzB", BLOCO, V3(0.24, 0.08, 0.04) * s, CF(0, yC + 0.4 * s, -0.56 * s), VERMELHO)
end
function CABECAS.chapeuAbas(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.peca("Aba", CILINDRO, V3(0.08, 1.95, 1.95) * s, CF(0, yC + 0.36 * s, 0) * EM_PE, cor)
	c.peca("Copa", CILINDRO, V3(0.5, 1.12, 1.12) * s, CF(0, yC + 0.62 * s, 0) * EM_PE, cor)
	c.peca("Fita", CILINDRO, V3(0.12, 1.15, 1.15) * s, CF(0, yC + 0.45 * s, 0) * EM_PE, Color3.fromRGB(80, 55, 30))
end
function CABECAS.capaceteAstronauta(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Capacete", BOLA, V3(1.55, 1.55, 1.55) * s, CF(0, yC + 0.05 * s, 0), BRANCO)
	c.elipse("Visor", V3(1.05, 0.8, 0.55) * s, CF(0, yC + 0.05 * s, -0.55 * s), Color3.fromRGB(255, 185, 60), FOLHA)
	c.peca("Gola", CILINDRO, V3(0.2, 1.3, 1.3) * s, CF(0, yC - 0.72 * s, 0) * EM_PE, PRATA, METAL)
end
function CABECAS.capacetePiloto(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.peca("Capacete", BOLA, V3(1.3, 1.3, 1.3) * s, CF(0, yC + 0.1 * s, 0.02 * s), cor)
	c.elipse("Visor", V3(1.0, 0.45, 0.5) * s, CF(0, yC + 0.12 * s, -0.48 * s), Color3.fromRGB(30, 35, 50), VIDRO)
	c.peca("Faixa", BLOCO, V3(0.18, 0.08, 1.2) * s, CF(0, yC + 0.75 * s, 0.05 * s), VERMELHO)
end
function CABECAS.capuzAranha(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.peca("Mascara", BOLA, V3(1.13, 1.13, 1.13) * s, CF(0, yC, 0), cor)
	for _, lado in { -1, 1 } do
		c.elipse("ContornoOlho", V3(0.42, 0.3, 0.12) * s, CF(0.22 * s * lado, yC + 0.1 * s, -0.52 * s) * ANG(0, 0, rad(28 * lado)), PRETO)
		c.elipse("Olho", V3(0.34, 0.22, 0.1) * s, CF(0.22 * s * lado, yC + 0.1 * s, -0.56 * s) * ANG(0, 0, rad(28 * lado)), BRANCO)
	end
	-- linhas de teia na máscara
	c.peca("TeiaV", BLOCO, V3(0.03, 1.15, 0.03) * s, CF(0, yC, -0.565 * s), PRETO)
	c.peca("TeiaH", BLOCO, V3(1.15, 0.03, 0.03) * s, CF(0, yC - 0.28 * s, -0.47 * s), PRETO)
end
function CABECAS.capuzMorcego(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	local cor = ctx.v.cabecaCor
	c.peca("Capuz", BOLA, V3(1.14, 1.14, 1.14) * s, CF(0, yC, 0), cor)
	for _, lado in { -1, 1 } do
		c.peca("Orelha", BLOCO, V3(0.18, 0.62, 0.18) * s, CF(0.33 * s * lado, yC + 0.72 * s, 0) * ANG(0, 0, rad(-12 * lado)), cor)
		c.peca("Olho", BLOCO, V3(0.26, 0.09, 0.05) * s, CF(0.2 * s * lado, yC + 0.1 * s, -0.56 * s) * ANG(0, 0, rad(10 * lado)),
			Color3.fromRGB(120, 230, 255), NEON)
	end
end
function CABECAS.capaceteEstrela(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.elipse("Capacete", V3(1.17, 0.82, 1.19) * s, CF(0, yC + 0.16 * s, 0.01 * s), cor)
	c.peca("EstrelaA", BLOCO, V3(0.24, 0.24, 0.04) * s, CF(0, yC + 0.42 * s, -0.56 * s), BRANCO)
	c.peca("EstrelaB", BLOCO, V3(0.24, 0.24, 0.04) * s, CF(0, yC + 0.42 * s, -0.565 * s) * ANG(0, 0, rad(45)), BRANCO)
	for _, lado in { -1, 1 } do
		c.peca("Asa", BLOCO, V3(0.06, 0.3, 0.18) * s, CF(0.6 * s * lado, yC + 0.2 * s, -0.05 * s) * ANG(rad(-25), 0, 0), BRANCO)
		c.peca("Olho", BLOCO, V3(0.16, 0.1, 0.05) * s, CF(0.19 * s * lado, yC + 0.08 * s, -0.56 * s), BRANCO)
	end
	c.peca("Boca", BLOCO, V3(0.3, 0.05, 0.05) * s, CF(0, yC - 0.2 * s, -0.51 * s), Color3.fromRGB(120, 40, 40))
	ctx.rostoFeito = true
end
function CABECAS.orelhasRaio(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.elipse("Mascara", V3(1.17, 0.85, 1.19) * s, CF(0, yC + 0.13 * s, 0.01 * s), cor)
	for _, lado in { -1, 1 } do
		c.peca("RaioA", BLOCO, V3(0.07, 0.36, 0.12) * s, CF(0.59 * s * lado, yC + 0.28 * s, 0) * ANG(0, 0, rad(-30 * lado)), OURO, NEON)
		c.peca("RaioB", BLOCO, V3(0.07, 0.3, 0.12) * s, CF(0.64 * s * lado, yC + 0.5 * s, 0.05 * s) * ANG(0, 0, rad(25 * lado)), OURO, NEON)
		c.peca("Olho", BLOCO, V3(0.18, 0.09, 0.05) * s, CF(0.19 * s * lado, yC + 0.08 * s, -0.57 * s), BRANCO)
	end
	c.peca("Boca", BLOCO, V3(0.3, 0.05, 0.05) * s, CF(0, yC - 0.22 * s, -0.51 * s), Color3.fromRGB(120, 40, 40))
	ctx.rostoFeito = true
end
function CABECAS.elmoTrovao(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	cabelo(ctx, "longo")
	c.elipse("Elmo", V3(1.21, 0.68, 1.23) * s, CF(0, yC + 0.32 * s, 0.01 * s), PRATA, METAL)
	for _, lado in { -1, 1 } do
		c.peca("AsaElmo", BLOCO, V3(0.06, 0.55, 0.32) * s, CF(0.62 * s * lado, yC + 0.55 * s, 0.05 * s) * ANG(rad(-20), 0, rad(-20 * lado)), BRANCO)
	end
end
function CABECAS.tiara(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	cabelo(ctx, "longo")
	c.peca("Tiara", CILINDRO, V3(0.12, 1.19, 1.19) * s, CF(0, yC + 0.32 * s, 0) * EM_PE, OURO, FOLHA)
	c.peca("EstrelaTiara", BLOCO, V3(0.18, 0.18, 0.05) * s, CF(0, yC + 0.36 * s, -0.6 * s) * ANG(0, 0, rad(45)), VERMELHO, NEON)
end
function CABECAS.capaceteArmadura(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.peca("Capacete", BOLA, V3(1.16, 1.16, 1.16) * s, CF(0, yC, 0), cor, METAL)
	c.elipse("Placa", V3(0.8, 0.88, 0.38) * s, CF(0, yC - 0.02 * s, -0.42 * s), OURO, FOLHA)
	for _, lado in { -1, 1 } do
		c.peca("Olho", BLOCO, V3(0.22, 0.07, 0.05) * s, CF(0.17 * s * lado, yC + 0.12 * s, -0.6 * s), Color3.fromRGB(200, 250, 255), NEON)
	end
end

function ROSTOS.mascaraDomino(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Domino", BLOCO, V3(0.85, 0.22, 0.08) * s, CF(0, yC + 0.1 * s, -0.53 * s), ctx.v.mascaraCor or PRETO)
	for _, lado in { -1, 1 } do
		c.peca("OlhoMascara", BLOCO, V3(0.16, 0.08, 0.04) * s, CF(0.19 * s * lado, yC + 0.1 * s, -0.575 * s), BRANCO)
	end
end
function ROSTOS.oculosVoo(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Tira", BLOCO, V3(1.15, 0.12, 1.15) * s, CF(0, yC + 0.12 * s, 0), PRETO)
	for _, lado in { -1, 1 } do
		c.elipse("Lente", V3(0.34, 0.28, 0.14) * s, CF(0.2 * s * lado, yC + 0.1 * s, -0.53 * s), Color3.fromRGB(230, 40, 40), VIDRO)
	end
end
function ROSTOS.viseira(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Viseira", BLOCO, V3(1.0, 0.2, 0.12) * s, CF(0, yC + 0.1 * s, -0.53 * s), Color3.fromRGB(255, 30, 30), NEON)
	c.peca("TiraViseira", BLOCO, V3(1.14, 0.14, 1.14) * s, CF(0, yC + 0.1 * s, 0), Color3.fromRGB(255, 200, 0))
end
function ROSTOS.olhosBrancos(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	for _, lado in { -1, 1 } do
		c.peca("OlhoBranco", BOLA, V3(0.17, 0.17, 0.17) * s, CF(0.19 * s * lado, yC + 0.08 * s, -0.505 * s), BRANCO, NEON)
	end
end
function ROSTOS.barba(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.elipse("Barba", V3(0.85, 0.45, 0.45) * s, CF(0, yC - 0.3 * s, -0.33 * s), ctx.v.cabelo or CASTANHO_PADRAO)
	c.peca("Boca", BLOCO, V3(0.26, 0.05, 0.05) * s, CF(0, yC - 0.2 * s, -0.53 * s), Color3.fromRGB(120, 40, 40))
end

function CABECAS.capaceteFormiga(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.peca("Capacete", BOLA, V3(1.2, 1.2, 1.2) * s, CF(0, yC, 0), cor, METAL)
	for _, lado in { -1, 1 } do
		c.elipse("Lente", V3(0.38, 0.32, 0.14) * s, CF(0.22 * s * lado, yC + 0.1 * s, -0.53 * s), Color3.fromRGB(255, 90, 40), VIDRO)
		c.peca("Antena", BLOCO, V3(0.05, 0.6, 0.05) * s, CF(0.25 * s * lado, yC + 0.8 * s, -0.1 * s) * ANG(0, 0, rad(-20 * lado)), PRETO)
		c.peca("Disco", CILINDRO, V3(0.14, 0.4, 0.4) * s, CF(0.62 * s * lado, yC, 0), Color3.fromRGB(190, 30, 30))
	end
	c.peca("Grade", BLOCO, V3(0.5, 0.18, 0.1) * s, CF(0, yC - 0.27 * s, -0.55 * s), PRATA, METAL)
end
function CABECAS.capuzArqueiro(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.elipse("Capuz", V3(1.25, 1.3, 1.3) * s, CF(0, yC + 0.1 * s, 0.22 * s), cor)
	c.peca("PontaCapuz", BLOCO, V3(0.3, 0.3, 0.4) * s, CF(0, yC + 0.55 * s, 0.75 * s) * ANG(rad(35), 0, 0), cor)
end
function CABECAS.magoCabelo(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	cabelo(ctx)
	for _, lado in { -1, 1 } do
		c.peca("Grisalho", BLOCO, V3(0.08, 0.3, 0.3) * s, CF(0.56 * s * lado, yC + 0.15 * s, 0), Color3.fromRGB(220, 220, 225))
	end
	c.peca("Cavanhaque", BLOCO, V3(0.22, 0.22, 0.1) * s, CF(0, yC - 0.38 * s, -0.45 * s), ctx.v.cabelo or PRETO)
end
function CABECAS.capuzPantera(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Mascara", BOLA, V3(1.13, 1.13, 1.13) * s, CF(0, yC, 0), PRETO)
	for _, lado in { -1, 1 } do
		c.peca("Orelha", BLOCO, V3(0.22, 0.24, 0.12) * s, CF(0.33 * s * lado, yC + 0.55 * s, -0.05 * s) * ANG(0, 0, rad(45)), PRETO)
		c.peca("Olho", BLOCO, V3(0.24, 0.08, 0.05) * s, CF(0.19 * s * lado, yC + 0.1 * s, -0.565 * s) * ANG(0, 0, rad(12 * lado)), BRANCO, NEON)
		c.peca("Linha", BLOCO, V3(0.04, 0.5, 0.04) * s, CF(0.12 * s * lado, yC + 0.3 * s, -0.5 * s) * ANG(rad(-25), 0, rad(15 * lado)), PRATA, NEON)
	end
end
function CABECAS.capuzGata(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Mascara", BOLA, V3(1.13, 1.13, 1.13) * s, CF(0, yC, 0), PRETO)
	for _, lado in { -1, 1 } do
		c.peca("Orelha", BLOCO, V3(0.22, 0.26, 0.12) * s, CF(0.3 * s * lado, yC + 0.56 * s, 0) * ANG(0, 0, rad(45)), PRETO)
		c.elipse("Oculos", V3(0.3, 0.22, 0.1) * s, CF(0.2 * s * lado, yC + 0.12 * s, -0.53 * s), Color3.fromRGB(90, 220, 140), VIDRO)
	end
	c.peca("Labios", BLOCO, V3(0.22, 0.06, 0.05) * s, CF(0, yC - 0.25 * s, -0.53 * s), Color3.fromRGB(200, 30, 50))
end
function CABECAS.capuzSimbionte(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Mascara", BOLA, V3(1.16, 1.16, 1.16) * s, CF(0, yC, 0), PRETO)
	for _, lado in { -1, 1 } do
		c.elipse("Olho", V3(0.42, 0.32, 0.1) * s, CF(0.22 * s * lado, yC + 0.12 * s, -0.55 * s) * ANG(0, 0, rad(35 * lado)), BRANCO)
	end
	c.peca("Dentes", BLOCO, V3(0.62, 0.12, 0.06) * s, CF(0, yC - 0.25 * s, -0.54 * s), BRANCO)
	c.peca("Lingua", BLOCO, V3(0.14, 0.3, 0.06) * s, CF(0.05 * s, yC - 0.42 * s, -0.55 * s), Color3.fromRGB(200, 40, 60))
end
function CABECAS.mascaraMercenario(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.peca("Mascara", BOLA, V3(1.13, 1.13, 1.13) * s, CF(0, yC, 0), cor)
	for _, lado in { -1, 1 } do
		c.elipse("Mancha", V3(0.4, 0.36, 0.1) * s, CF(0.21 * s * lado, yC + 0.1 * s, -0.53 * s), PRETO)
		c.elipse("Olho", V3(0.2, 0.14, 0.06) * s, CF(0.21 * s * lado, yC + 0.1 * s, -0.585 * s), BRANCO)
	end
end
function CABECAS.mascaraGarra(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	c.elipse("Mascara", V3(1.17, 0.85, 1.19) * s, CF(0, yC + 0.14 * s, 0.01 * s), cor)
	for _, lado in { -1, 1 } do
		c.elipse("Mancha", V3(0.36, 0.3, 0.1) * s, CF(0.2 * s * lado, yC + 0.12 * s, -0.53 * s) * ANG(0, 0, rad(20 * lado)), PRETO)
		c.peca("Olho", BLOCO, V3(0.18, 0.06, 0.04) * s, CF(0.2 * s * lado, yC + 0.12 * s, -0.585 * s), BRANCO)
		c.peca("Chifre", BLOCO, V3(0.1, 0.55, 0.12) * s, CF(0.42 * s * lado, yC + 0.6 * s, -0.1 * s) * ANG(0, 0, rad(-30 * lado)), PRETO)
	end
	c.peca("Boca", BLOCO, V3(0.3, 0.05, 0.05) * s, CF(0, yC - 0.22 * s, -0.51 * s), Color3.fromRGB(120, 40, 40))
	ctx.rostoFeito = true
end
function CABECAS.capaceteCiborgue(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	cabelo(ctx)
	c.elipse("MetadeMetal", V3(0.62, 1.16, 1.16) * s, CF(0.27 * s, yC, 0), PRATA, METAL)
	c.peca("OlhoRobo", BOLA, V3(0.2, 0.2, 0.2) * s, CF(0.2 * s, yC + 0.08 * s, -0.52 * s), Color3.fromRGB(255, 30, 30), NEON)
end
function CABECAS.cabecaPedra(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	local cor = ctx.v.pele
	c.peca("CabecaPedra", BLOCO, V3(1.2, 1.1, 1.15) * s, CF(0, yC, 0), cor, Enum.Material.Slate)
	c.peca("Testa", BLOCO, V3(1.05, 0.22, 0.25) * s, CF(0, yC + 0.25 * s, -0.55 * s), cor:Lerp(PRETO, 0.2), Enum.Material.Slate)
	for _, lado in { -1, 1 } do
		c.peca("Olho", BLOCO, V3(0.16, 0.1, 0.05) * s, CF(0.22 * s * lado, yC + 0.08 * s, -0.59 * s), Color3.fromRGB(80, 160, 255))
	end
	c.peca("Boca", BLOCO, V3(0.4, 0.06, 0.05) * s, CF(0, yC - 0.25 * s, -0.59 * s), PRETO)
end
function CABECAS.cabecaFogo(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	for i = -2, 2 do
		c.peca("Chama", BLOCO, V3(0.22, 0.5 + (2 - math.abs(i)) * 0.15, 0.22) * s, CF(i * 0.22 * s, yC + 0.6 * s, 0.05 * s) * ANG(0, 0, rad(-i * 12)),
			i % 2 == 0 and Color3.fromRGB(255, 230, 80) or Color3.fromRGB(255, 140, 20), NEON)
	end
end
function CABECAS.androide(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Gema", BLOCO, V3(0.22, 0.22, 0.06) * s, CF(0, yC + 0.32 * s, -0.5 * s) * ANG(0, 0, rad(45)), Color3.fromRGB(255, 220, 60), NEON)
	for _, lado in { -1, 1 } do
		c.peca("Linha", BLOCO, V3(0.04, 0.9, 0.04) * s, CF(0.3 * s * lado, yC + 0.1 * s, -0.42 * s) * ANG(rad(-30), 0, 0), Color3.fromRGB(40, 120, 70))
	end
end
function CABECAS.capuzCorvo(ctx)
	local c, s, yC, cor = ctx.c, ctx.s, ctx.yC, ctx.v.cabecaCor
	cabelo(ctx)
	c.elipse("Capuz", V3(1.3, 1.32, 1.3) * s, CF(0, yC + 0.08 * s, 0.24 * s), cor)
	c.peca("Gema", BOLA, V3(0.12, 0.12, 0.12) * s, CF(0, yC + 0.3 * s, -0.51 * s), Color3.fromRGB(230, 30, 40), NEON)
end
function CABECAS.tiaraBruxa(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	cabelo(ctx, "longo")
	for _, lado in { -1, 1 } do
		c.peca("Tiara", BLOCO, V3(0.08, 0.5, 0.06) * s, CF(0.12 * s * lado, yC + 0.42 * s, -0.5 * s) * ANG(0, 0, rad(30 * lado)), Color3.fromRGB(190, 20, 40))
	end
	c.peca("TiaraCentro", BLOCO, V3(0.5, 0.08, 0.06) * s, CF(0, yC + 0.26 * s, -0.53 * s), Color3.fromRGB(190, 20, 40))
end
function CABECAS.mascaraLorde(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	c.peca("Mascara", BOLA, V3(1.15, 1.15, 1.15) * s, CF(0, yC, 0), Color3.fromRGB(70, 30, 30), METAL)
	for _, lado in { -1, 1 } do
		c.elipse("Olho", V3(0.36, 0.3, 0.12) * s, CF(0.22 * s * lado, yC + 0.1 * s, -0.52 * s), Color3.fromRGB(255, 40, 40), NEON)
		c.peca("Orelha", CILINDRO, V3(0.16, 0.36, 0.36) * s, CF(0.6 * s * lado, yC, 0), PRATA, METAL)
	end
	for k = -1, 1 do
		c.peca("Grade", BLOCO, V3(0.08, 0.22, 0.06) * s, CF(k * 0.14 * s, yC - 0.28 * s, -0.55 * s), PRATA, METAL)
	end
end
function CABECAS.cabeloChamas(ctx)
	local c, s, yC = ctx.c, ctx.s, ctx.yC
	cabelo(ctx, "longo")
	for i = -1, 1 do
		c.peca("ChamaCabelo", BLOCO, V3(0.25, 0.55, 0.25) * s, CF(i * 0.3 * s, yC + 0.65 * s, 0.25 * s) * ANG(rad(-20), 0, rad(-i * 15)),
			Color3.fromRGB(255, 150, 30), NEON)
	end
end
CABECAS_SEM_ROSTO.capaceteFormiga = true
CABECAS_SEM_ROSTO.capuzPantera = true
CABECAS_SEM_ROSTO.capuzGata = true
CABECAS_SEM_ROSTO.capuzSimbionte = true
CABECAS_SEM_ROSTO.mascaraMercenario = true
CABECAS_SEM_ROSTO.cabecaPedra = true
CABECAS_SEM_ROSTO.mascaraLorde = true

--------------------------------------------------------------------------
-- DETALHES DO CORPO
--------------------------------------------------------------------------
local CORPO = {}
function CORPO.faixasRefletivas(ctx)
	local c, s, L = ctx.c, ctx.s, ctx.L
	for _, y in { -0.3, 0.25 } do
		c.peca("Faixa", BLOCO, V3(1.64 * L, 0.13, 0.94) * s, CF(0, y * s, 0), REFLETIVO, NEON)
	end
	for _, lado in { -1, 1 } do
		c.peca("FaixaPerna", BLOCO, V3(0.64 * L, 0.11, 0.64) * s, CF(0.42 * s * L * lado, -1.55 * s, 0), REFLETIVO, NEON)
		c.peca("FaixaBraco", BLOCO, V3(0.49 * L, 0.1, 0.49 * L) * s, CF(1.08 * s * L * lado, -0.3 * s, 0) * ANG(0, 0, rad(8 * lado)), REFLETIVO, NEON)
	end
end
function CORPO.jaleco(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Jaleco", BLOCO, V3(1.66, 1.62, 0.96) * s, CF(0, 0, 0), BRANCO)
	c.peca("CamisaV", BLOCO, V3(0.42, 0.7, 0.05) * s, CF(0, 0.42 * s, -0.48 * s), ctx.v.camisa)
	c.peca("Barra", BLOCO, V3(1.64, 0.85, 0.98) * s, CF(0, -1.2 * s, 0), BRANCO)
	c.peca("Abertura", BLOCO, V3(0.08, 0.85, 0.06) * s, CF(0, -1.2 * s, -0.5 * s), Color3.fromRGB(200, 200, 205))
	for _, lado in { -1, 1 } do
		c.peca("Bolso", BLOCO, V3(0.32, 0.25, 0.04) * s, CF(0.45 * s * lado, -0.35 * s, -0.5 * s), Color3.fromRGB(225, 225, 230))
	end
end
function CORPO.colete(ctx)
	local c, s = ctx.c, ctx.s
	local cor = ctx.v.coleteCor or Color3.fromRGB(255, 130, 0)
	c.peca("Colete", BLOCO, V3(1.66, 1.45, 0.96) * s, CF(0, 0.05 * s, 0), cor)
	c.peca("FaixaColete", BLOCO, V3(1.68, 0.14, 0.98) * s, CF(0, -0.15 * s, 0), REFLETIVO, NEON)
	c.peca("CruzA", BLOCO, V3(0.1, 0.34, 0.04) * s, CF(0.4 * s, 0.38 * s, -0.5 * s), BRANCO)
	c.peca("CruzB", BLOCO, V3(0.34, 0.1, 0.04) * s, CF(0.4 * s, 0.38 * s, -0.5 * s), BRANCO)
end
function CORPO.avental(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Avental", BLOCO, V3(1.2, 1.9, 0.06) * s, CF(0, -0.5 * s, -0.48 * s), Color3.fromRGB(240, 220, 160))
	c.peca("Bolso", BLOCO, V3(0.6, 0.35, 0.04) * s, CF(0, -0.65 * s, -0.52 * s), Color3.fromRGB(220, 190, 120))
end
function CORPO.estetoscopio(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		c.peca("Tubo", BLOCO, V3(0.06, 0.65, 0.06) * s, CF(0.28 * s * lado, 0.38 * s, -0.5 * s) * ANG(0, 0, rad(-10 * lado)), PRETO)
	end
	c.peca("TuboBaixo", BLOCO, V3(0.06, 0.4, 0.06) * s, CF(0.2 * s, -0.12 * s, -0.5 * s), PRETO)
	c.peca("Disco", CILINDRO, V3(0.06, 0.2, 0.2) * s, CF(0.2 * s, -0.36 * s, -0.52 * s) * DE_FRENTE, PRATA, METAL)
end
function CORPO.distintivo(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Distintivo", BLOCO, V3(0.24, 0.24, 0.05) * s, CF(0.45 * s, 0.4 * s, -0.48 * s) * ANG(0, 0, rad(45)), OURO, FOLHA)
	c.peca("Bolso", BLOCO, V3(0.32, 0.22, 0.04) * s, CF(-0.45 * s, 0.35 * s, -0.48 * s), ctx.v.camisa:Lerp(PRETO, 0.25))
end
function CORPO.cintoUtilidade(ctx)
	local c, s, L = ctx.c, ctx.s, ctx.L
	local cor = ctx.v.cintoCor or Color3.fromRGB(255, 200, 40)
	c.peca("Cinto", BLOCO, V3(1.66 * L, 0.22, 0.96) * s, CF(0, -0.68 * s, 0), cor)
	for i = -2, 2 do
		if i ~= 0 then
			c.peca("Bolsinha", BLOCO, V3(0.22, 0.24, 0.12) * s, CF(i * 0.3 * s * L, -0.68 * s, -0.52 * s), cor:Lerp(PRETO, 0.25))
		end
	end
	c.peca("Fivela", BLOCO, V3(0.26, 0.2, 0.08) * s, CF(0, -0.68 * s, -0.52 * s), OURO, NEON)
end
function CORPO.teia(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("TeiaV", BLOCO, V3(0.03, 1.6, 0.03) * s, CF(0, 0, -0.47 * s), PRETO)
	for _, y in { -0.45, 0, 0.45 } do
		c.peca("TeiaH", BLOCO, V3(1.6, 0.03, 0.03) * s, CF(0, y * s, -0.47 * s), PRETO)
	end
	for _, lado in { -1, 1 } do
		c.peca("TeiaD", BLOCO, V3(0.03, 2.1, 0.03) * s, CF(0, 0, -0.47 * s) * ANG(0, 0, rad(40 * lado)), PRETO)
	end
end
function CORPO.listrasPeito(ctx)
	local c, s = ctx.c, ctx.s
	for i = 0, 2 do
		c.peca("Listra", BLOCO, V3(1.62, 0.12, 0.92) * s, CF(0, (-0.35 - i * 0.14) * s, 0), i % 2 == 0 and VERMELHO or BRANCO)
	end
end
function CORPO.discosPeito(ctx)
	local c, s = ctx.c, ctx.s
	for _, x in { -0.4, 0.4 } do
		for _, y in { 0.45, 0.05, -0.35 } do
			c.peca("Disco", CILINDRO, V3(0.06, 0.32, 0.32) * s, CF(x * s, y * s, -0.47 * s) * DE_FRENTE, PRATA, METAL)
		end
	end
end
function CORPO.faixasAmarelas(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		c.peca("Faixa", BLOCO, V3(0.12, 1.62, 0.94) * s, CF(0.72 * s * lado, 0, 0), Color3.fromRGB(255, 210, 0))
	end
end
function CORPO.binoculo(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		c.peca("Lente", CILINDRO, V3(0.3, 0.2, 0.2) * s, CF(0.12 * s * lado, -0.1 * s, -0.55 * s) * DE_FRENTE, PRETO)
	end
	c.peca("Alca", BLOCO, V3(0.05, 0.9, 0.05) * s, CF(0, 0.35 * s, -0.48 * s), Color3.fromRGB(90, 60, 35))
end
function CORPO.armaduraOuro(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Peitoral", BLOCO, V3(1.4, 0.7, 0.08) * s, CF(0, 0.4 * s, -0.47 * s), OURO, FOLHA)
	c.peca("Saia", BLOCO, V3(1.68, 0.5, 0.98) * s, CF(0, -0.95 * s, 0), Color3.fromRGB(30, 60, 160))
	c.peca("Cinto", BLOCO, V3(1.66, 0.16, 0.96) * s, CF(0, -0.68 * s, 0), OURO, FOLHA)
end

--------------------------------------------------------------------------
-- EMBLEMAS NO PEITO
--------------------------------------------------------------------------
local EMBLEMAS = {}
local function emblemaCF(s, y)
	return CF(0, (y or 0.25) * s, -0.47 * s)
end
function EMBLEMAS.cruz(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("CruzFundo", BLOCO, V3(0.42, 0.42, 0.04) * s, CF(-0.42 * s, 0.4 * s, -0.47 * s), BRANCO)
	c.peca("CruzA", BLOCO, V3(0.1, 0.32, 0.05) * s, CF(-0.42 * s, 0.4 * s, -0.49 * s), VERMELHO)
	c.peca("CruzB", BLOCO, V3(0.32, 0.1, 0.05) * s, CF(-0.42 * s, 0.4 * s, -0.49 * s), VERMELHO)
end
function EMBLEMAS.estrela(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Circulo", CILINDRO, V3(0.05, 0.8, 0.8) * s, emblemaCF(s) * DE_FRENTE, Color3.fromRGB(230, 235, 245))
	c.peca("EstrelaA", BLOCO, V3(0.38, 0.38, 0.06) * s, emblemaCF(s) * CF(0, 0, -0.03 * s), Color3.fromRGB(30, 60, 170))
	c.peca("EstrelaB", BLOCO, V3(0.38, 0.38, 0.06) * s, emblemaCF(s) * CF(0, 0, -0.035 * s) * ANG(0, 0, rad(45)), Color3.fromRGB(30, 60, 170))
end
function EMBLEMAS.raio(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Circulo", CILINDRO, V3(0.05, 0.85, 0.85) * s, emblemaCF(s) * DE_FRENTE, BRANCO)
	c.peca("RaioA", BLOCO, V3(0.12, 0.42, 0.05) * s, emblemaCF(s) * CF(0.06 * s, 0.14 * s, -0.04 * s) * ANG(0, 0, rad(-25)), OURO, NEON)
	c.peca("RaioB", BLOCO, V3(0.3, 0.1, 0.05) * s, emblemaCF(s) * CF(0, 0, -0.045 * s) * ANG(0, 0, rad(-15)), OURO, NEON)
	c.peca("RaioC", BLOCO, V3(0.12, 0.42, 0.05) * s, emblemaCF(s) * CF(-0.06 * s, -0.14 * s, -0.04 * s) * ANG(0, 0, rad(-25)), OURO, NEON)
end
function EMBLEMAS.aranha(ctx)
	local c, s = ctx.c, ctx.s
	local cor = ctx.v.emblemaCor or PRETO
	local esc = ctx.v.largo and 1.6 or 1
	c.elipse("Corpo", V3(0.18, 0.3, 0.08) * s * esc, emblemaCF(s, 0.2), cor)
	c.peca("Cabeca", BOLA, V3(0.12, 0.12, 0.12) * s * esc, emblemaCF(s, 0.2 + 0.2 * esc), cor)
	for _, lado in { -1, 1 } do
		for k = 0, 3 do
			local ang = rad(lado * (35 + k * 32))
			c.peca("Perna", BLOCO, V3(0.03, 0.34 * esc, 0.03) * s, emblemaCF(s, 0.22) * ANG(0, 0, ang) * CF(0, 0.17 * s * esc, -0.01 * s), cor)
		end
	end
end
function EMBLEMAS.morcego(ctx)
	-- emblema original: lua crescente com três garras
	local c, s = ctx.c, ctx.s
	c.peca("Lua", CILINDRO, V3(0.05, 0.75, 0.75) * s, emblemaCF(s) * DE_FRENTE, Color3.fromRGB(110, 225, 255), NEON)
	c.peca("Sombra", CILINDRO, V3(0.06, 0.62, 0.62) * s, emblemaCF(s) * CF(0.16 * s, 0.1 * s, -0.01 * s) * DE_FRENTE, ctx.v.camisa)
	for k = -1, 1 do
		c.peca("Garra", BLOCO, V3(0.06, 0.5, 0.05) * s, emblemaCF(s) * CF(k * 0.15 * s, 0, -0.04 * s) * ANG(0, 0, rad(-20)),
			Color3.fromRGB(200, 140, 255), NEON)
	end
end
function EMBLEMAS.reator(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Anel", CILINDRO, V3(0.05, 0.62, 0.62) * s, emblemaCF(s) * DE_FRENTE, PRATA, METAL)
	c.peca("Reator", CILINDRO, V3(0.06, 0.42, 0.42) * s, emblemaCF(s) * CF(0, 0, -0.02 * s) * DE_FRENTE, Color3.fromRGB(140, 240, 255), NEON)
end
function EMBLEMAS.supremo(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Diamante", BLOCO, V3(0.62, 0.62, 0.05) * s, emblemaCF(s) * ANG(0, 0, rad(45)), OURO)
	c.peca("DiamanteInterno", BLOCO, V3(0.44, 0.44, 0.05) * s, emblemaCF(s) * CF(0, 0, -0.02 * s) * ANG(0, 0, rad(45)), VERMELHO)
	c.peca("Brilho", BLOCO, V3(0.14, 0.14, 0.05) * s, emblemaCF(s) * CF(0, 0, -0.04 * s) * ANG(0, 0, rad(45)), OURO, NEON)
end
function EMBLEMAS.bandeira(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Bandeira", BLOCO, V3(0.4, 0.26, 0.04) * s, CF(-0.45 * s, 0.45 * s, -0.47 * s), Color3.fromRGB(0, 140, 70))
	c.peca("Losango", BLOCO, V3(0.16, 0.16, 0.05) * s, CF(-0.45 * s, 0.45 * s, -0.49 * s) * ANG(0, 0, rad(45)), Color3.fromRGB(255, 220, 0))
end

--------------------------------------------------------------------------
-- ITENS NAS MÃOS (mão direita = +X)
--------------------------------------------------------------------------
local MAOS = {}
function MAOS.extintor(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Extintor", CILINDRO, V3(0.95, 0.42, 0.42) * s, CF(hx, hy - 0.2 * s, -0.3 * s) * EM_PE, VERMELHO)
	c.peca("Valvula", BLOCO, V3(0.22, 0.18, 0.22) * s, CF(hx, hy + 0.35 * s, -0.3 * s), PRETO)
	c.peca("Bico", BLOCO, V3(0.08, 0.08, 0.4) * s, CF(hx, hy + 0.38 * s, -0.55 * s), PRETO)
end
function MAOS.machado(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Cabo", BLOCO, V3(0.09, 1.5, 0.09) * s, CF(hx, hy + 0.3 * s, -0.1 * s), Color3.fromRGB(120, 80, 40))
	c.peca("Lamina", BLOCO, V3(0.08, 0.36, 0.5) * s, CF(hx, hy + 0.9 * s, -0.36 * s), VERMELHO)
	c.peca("Fio", BLOCO, V3(0.09, 0.4, 0.06) * s, CF(hx, hy + 0.9 * s, -0.63 * s), PRATA, METAL)
end
function MAOS.vassoura(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Cabo", BLOCO, V3(0.08, 2.3, 0.08) * s, CF(hx, hy - 0.15 * s, -0.15 * s), Color3.fromRGB(255, 200, 40))
	c.peca("Cerdas", BLOCO, V3(0.7, 0.35, 0.22) * s, CF(hx, hy - 1.3 * s, -0.15 * s), Color3.fromRGB(70, 60, 50))
end
function MAOS.livro(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Capa", BLOCO, V3(0.18, 0.62, 0.5) * s, CF(hx + 0.05 * s, hy, -0.15 * s), Color3.fromRGB(40, 90, 200))
	c.peca("Paginas", BLOCO, V3(0.16, 0.56, 0.44) * s, CF(hx + 0.07 * s, hy, -0.17 * s), BRANCO)
end
function MAOS.maleta(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Maleta", BLOCO, V3(0.32, 0.55, 0.75) * s, CF(hx + 0.05 * s, hy - 0.42 * s, 0), BRANCO)
	c.peca("CruzA", BLOCO, V3(0.34, 0.32, 0.1) * s, CF(hx + 0.05 * s, hy - 0.42 * s, 0), VERMELHO)
	c.peca("CruzB", BLOCO, V3(0.34, 0.1, 0.32) * s, CF(hx + 0.05 * s, hy - 0.42 * s, 0), VERMELHO)
	c.peca("Alca", BLOCO, V3(0.08, 0.12, 0.3) * s, CF(hx + 0.05 * s, hy - 0.08 * s, 0), PRETO)
end
function MAOS.frasco(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Frasco", BOLA, V3(0.42, 0.42, 0.42) * s, CF(hx, hy + 0.2 * s, -0.25 * s), Color3.fromRGB(80, 255, 140), NEON, { transparencia = 0.1 })
	c.peca("Gargalo", CILINDRO, V3(0.25, 0.14, 0.14) * s, CF(hx, hy + 0.5 * s, -0.25 * s) * EM_PE, Color3.fromRGB(200, 240, 255), VIDRO)
end
function MAOS.boia(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.anel("Boia", 0.42 * s, 10, V3(0.26, 0.24, 0.2) * s, CF(hx + 0.15 * s, hy - 0.2 * s, -0.15 * s) * ANG(0, rad(90), 0),
		{ VERMELHO, BRANCO })
end
function MAOS.prancheta(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Prancheta", BLOCO, V3(0.08, 0.7, 0.55) * s, CF(hx + 0.1 * s, hy + 0.1 * s, -0.2 * s), Color3.fromRGB(150, 100, 50))
	c.peca("Papel", BLOCO, V3(0.09, 0.58, 0.46) * s, CF(hx + 0.11 * s, hy + 0.06 * s, -0.2 * s), BRANCO)
	c.peca("Clipe", BLOCO, V3(0.1, 0.08, 0.2) * s, CF(hx + 0.12 * s, hy + 0.42 * s, -0.2 * s), PRATA, METAL)
end
function MAOS.lanterna(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Lanterna", CILINDRO, V3(0.6, 0.16, 0.16) * s, CF(hx, hy, -0.35 * s) * DE_FRENTE, PRETO)
	c.peca("Luz", CILINDRO, V3(0.06, 0.2, 0.2) * s, CF(hx, hy, -0.66 * s) * DE_FRENTE, Color3.fromRGB(255, 250, 200), NEON)
end
function MAOS.carta(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Carta", BLOCO, V3(0.06, 0.38, 0.58) * s, CF(hx + 0.08 * s, hy + 0.1 * s, -0.2 * s), BRANCO)
	c.peca("Selo", BLOCO, V3(0.07, 0.1, 0.1) * s, CF(hx + 0.1 * s, hy + 0.18 * s, -0.4 * s), VERMELHO)
end
function MAOS.martelo(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Cabo", BLOCO, V3(0.12, 1.0, 0.12) * s, CF(hx, hy + 0.1 * s, -0.15 * s), Color3.fromRGB(110, 70, 40))
	c.peca("Cabeca", BLOCO, V3(0.45, 0.42, 0.7) * s, CF(hx, hy + 0.72 * s, -0.15 * s), PRATA, METAL)
	c.peca("Brilho", BLOCO, V3(0.47, 0.06, 0.72) * s, CF(hx, hy + 0.72 * s, -0.15 * s), Color3.fromRGB(150, 220, 255), NEON)
end
function MAOS.laco(ctx)
	local c, s = ctx.c, ctx.s
	c.anel("Laco", 0.26 * s, 10, V3(0.1, 0.16, 0.1) * s, CF(0.7 * s, -0.75 * s, -0.25 * s) * ANG(0, rad(70), 0), { OURO }, NEON)
end
local MAOS_ESQUERDA = {}
function MAOS_ESQUERDA.escudo(ctx)
	local c, s = ctx.c, ctx.s
	local base = CF(-1.32 * s * ctx.L, -0.15 * s, -0.25 * s) * ANG(0, rad(-70), 0)
	local aneis = { { 1.35, VERMELHO }, { 1.05, BRANCO }, { 0.75, VERMELHO }, { 0.48, Color3.fromRGB(30, 60, 170) } }
	for i, info in aneis do
		c.peca("Escudo", CILINDRO, V3(0.08, info[1], info[1]) * s, base * CF(0, 0, -0.03 * s * i) * DE_FRENTE, info[2], METAL)
	end
	c.peca("EstrelaA", BLOCO, V3(0.26, 0.26, 0.05) * s, base * CF(0, 0, -0.16 * s), BRANCO, NEON)
	c.peca("EstrelaB", BLOCO, V3(0.26, 0.26, 0.05) * s, base * CF(0, 0, -0.165 * s) * ANG(0, 0, rad(45)), BRANCO, NEON)
end

--------------------------------------------------------------------------
-- COSTAS
--------------------------------------------------------------------------
local COSTAS = {}
function COSTAS.tanque(ctx)
	local c, s = ctx.c, ctx.s
	local cor = ctx.v.tanqueCor or Color3.fromRGB(255, 200, 0)
	for _, lado in { -1, 1 } do
		c.peca("Tanque", CILINDRO, V3(1.2, 0.4, 0.4) * s, CF(0.22 * s * lado, 0.05 * s, 0.68 * s) * EM_PE, cor, METAL)
	end
	c.peca("Valvula", BLOCO, V3(0.5, 0.12, 0.12) * s, CF(0, 0.7 * s, 0.68 * s), PRATA, METAL)
end
function COSTAS.mochilaAstronauta(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Mochila", BLOCO, V3(1.3, 1.35, 0.55) * s, CF(0, 0.1 * s, 0.72 * s), BRANCO)
	c.peca("Painel", BLOCO, V3(0.5, 0.3, 0.05) * s, CF(0.2 * s, 0.4 * s, 1.0 * s), Color3.fromRGB(60, 140, 255), NEON)
end
function COSTAS.bolsaCarteiro(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Bolsa", BLOCO, V3(0.32, 0.6, 0.75) * s, CF(0.98 * s, -0.55 * s, 0.05 * s), Color3.fromRGB(130, 85, 45))
	c.peca("Alca", BLOCO, V3(0.08, 2.1, 0.06) * s, CF(0, 0.05 * s, -0.48 * s) * ANG(0, 0, rad(42)), Color3.fromRGB(110, 70, 35))
end

function CORPO.escamas(ctx)
	local c, s = ctx.c, ctx.s
	for _, y in { 0.45, 0.15, -0.15, -0.45 } do
		for _, x in { -0.4, 0, 0.4 } do
			c.peca("Escama", BLOCO, V3(0.3, 0.05, 0.04) * s, CF((x + (y * 0.3)) * s, y * s, -0.47 * s), Color3.fromRGB(255, 220, 90))
		end
	end
end
function CORPO.linhasPrata(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		c.peca("Linha", BLOCO, V3(0.05, 1.2, 0.04) * s, CF(0.35 * s * lado, 0, -0.47 * s) * ANG(0, 0, rad(20 * lado)), PRATA, NEON)
		c.peca("LinhaPerna", BLOCO, V3(0.04, 1.0, 0.64) * s, CF(0.42 * s * lado, -1.4 * s, 0), PRATA, NEON)
	end
end
function CORPO.colar(ctx)
	local c, s = ctx.c, ctx.s
	for k = -3, 3 do
		c.peca("Dente", BLOCO, V3(0.1, 0.18, 0.05) * s, CF(k * 0.12 * s, (0.62 - math.abs(k) * 0.05) * s, -0.48 * s), PRATA, METAL)
	end
end
function CORPO.robe(ctx)
	local c, s = ctx.c, ctx.s
	local cor = ctx.v.robeCor or Color3.fromRGB(30, 60, 130)
	c.peca("Robe", BLOCO, V3(1.66, 1.62, 0.96) * s, CF(0, 0, 0), cor)
	c.peca("Barra", BLOCO, V3(1.64, 0.9, 0.98) * s, CF(0, -1.2 * s, 0), cor)
	c.peca("Faixa", BLOCO, V3(0.25, 1.62, 0.04) * s, CF(0, 0, -0.49 * s), cor:Lerp(BRANCO, 0.25))
end
function CORPO.amuleto(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Amuleto", CILINDRO, V3(0.06, 0.42, 0.42) * s, CF(0, 0.45 * s, -0.5 * s) * DE_FRENTE, OURO, FOLHA)
	c.elipse("Olho", V3(0.2, 0.12, 0.05) * s, CF(0, 0.45 * s, -0.54 * s), Color3.fromRGB(60, 255, 120), NEON)
end
function CORPO.metadeMetal(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("PlacaMetal", BLOCO, V3(0.85, 1.64, 0.96) * s, CF(0.4 * s, 0, 0), PRATA, METAL)
	c.peca("Luz", CILINDRO, V3(0.06, 0.3, 0.3) * s, CF(0.4 * s, 0.35 * s, -0.5 * s) * DE_FRENTE, Color3.fromRGB(255, 40, 40), NEON)
	c.peca("BracoMetal", BLOCO, V3(0.5, 1.42, 0.5) * s, CF(1.05 * s, 0.05 * s, 0) * ANG(0, 0, rad(8)), PRATA, METAL)
end
function CORPO.faixasPretasLaterais(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		c.peca("FaixaPreta", BLOCO, V3(0.14, 1.62, 0.94) * s, CF(0.73 * s * lado, 0, 0), PRETO)
		c.peca("PontaPreta", BLOCO, V3(0.5, 0.12, 0.06) * s, CF(0.45 * s * lado, 0.55 * s, -0.47 * s) * ANG(0, 0, rad(-35 * lado)), PRETO)
	end
end
function CORPO.chamas(ctx)
	local p = Instance.new("ParticleEmitter")
	p.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80), Color3.fromRGB(255, 60, 0))
	p.LightEmission = 1
	p.Rate = 18
	p.Lifetime = NumberRange.new(0.5, 1)
	p.Speed = NumberRange.new(1.5, 3)
	p.SpreadAngle = Vector2.new(25, 25)
	p.Size = NumberSequence.new(0.6 * ctx.s, 0)
	p.Parent = ctx.raiz
	local luz = Instance.new("PointLight")
	luz.Color = Color3.fromRGB(255, 140, 40)
	luz.Range = 10
	luz.Brightness = 2
	luz.Parent = ctx.raiz
end
function CORPO.corpoPedra(ctx)
	local c, s = ctx.c, ctx.s
	local cor = ctx.v.pele:Lerp(PRETO, 0.25)
	for i, info in { { -0.4, 0.45 }, { 0.35, 0.2 }, { -0.2, -0.15 }, { 0.45, -0.4 }, { 0, 0.55 } } do
		c.peca("Pedra", BLOCO, V3(0.32, 0.26, 0.06) * s, CF(info[1] * s * ctx.L, info[2] * s, -0.47 * s) * ANG(0, 0, rad(i * 17)), cor, Enum.Material.Slate)
	end
end
function CORPO.linhasDouradas(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		c.peca("LinhaDourada", BLOCO, V3(0.06, 1.6, 0.04) * s, CF(0.5 * s * lado, 0, -0.47 * s), OURO)
	end
	c.peca("LinhaCentro", BLOCO, V3(1.0, 0.06, 0.04) * s, CF(0, 0.5 * s, -0.47 * s), OURO)
end
function CORPO.faixaAzul(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Faixa", BLOCO, V3(1.64, 0.7, 0.94) * s, CF(0, -0.45 * s, 0), Color3.fromRGB(30, 50, 140))
	c.peca("FaixaDourada", BLOCO, V3(1.66, 0.08, 0.96) * s, CF(0, -0.08 * s, 0), OURO)
end
function CORPO.casaco(ctx)
	local c, s = ctx.c, ctx.s
	local cor = ctx.v.camisa
	c.peca("Barra", BLOCO, V3(1.64, 1.0, 0.98) * s, CF(0, -1.25 * s, 0), cor)
	c.peca("Abertura", BLOCO, V3(0.1, 1.0, 0.06) * s, CF(0, -1.25 * s, -0.5 * s), PRETO)
	c.peca("Gola", BLOCO, V3(1.2, 0.25, 0.3) * s, CF(0, 0.8 * s, -0.35 * s), cor:Lerp(PRETO, 0.3))
end

function EMBLEMAS.raioPeito(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("RaioA", BLOCO, V3(0.16, 0.6, 0.05) * s, emblemaCF(s) * CF(0.1 * s, 0.2 * s, -0.01 * s) * ANG(0, 0, rad(-28)), OURO, NEON)
	c.peca("RaioB", BLOCO, V3(0.5, 0.13, 0.05) * s, emblemaCF(s) * CF(0, 0, -0.015 * s) * ANG(0, 0, rad(-12)), OURO, NEON)
	c.peca("RaioC", BLOCO, V3(0.16, 0.6, 0.05) * s, emblemaCF(s) * CF(-0.1 * s, -0.22 * s, -0.01 * s) * ANG(0, 0, rad(-28)), OURO, NEON)
end
function EMBLEMAS.estrelaDourada(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("EstrelaA", BLOCO, V3(0.42, 0.42, 0.05) * s, emblemaCF(s), OURO, NEON)
	c.peca("EstrelaB", BLOCO, V3(0.42, 0.42, 0.05) * s, emblemaCF(s) * CF(0, 0, -0.005 * s) * ANG(0, 0, rad(45)), OURO, NEON)
end
function EMBLEMAS.lanterna(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Circulo", CILINDRO, V3(0.05, 0.8, 0.8) * s, emblemaCF(s) * DE_FRENTE, BRANCO)
	c.peca("Anel", CILINDRO, V3(0.06, 0.55, 0.55) * s, emblemaCF(s) * CF(0, 0, -0.02 * s) * DE_FRENTE, Color3.fromRGB(40, 220, 90), NEON)
	c.peca("Miolo", CILINDRO, V3(0.07, 0.34, 0.34) * s, emblemaCF(s) * CF(0, 0, -0.03 * s) * DE_FRENTE, BRANCO)
	for _, y in { 0.38, -0.38 } do
		c.peca("Barra", BLOCO, V3(0.5, 0.08, 0.05) * s, emblemaCF(s) * CF(0, y * s, -0.02 * s), Color3.fromRGB(40, 220, 90), NEON)
	end
end
function EMBLEMAS.fenix(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Corpo", BLOCO, V3(0.22, 0.22, 0.05) * s, emblemaCF(s) * ANG(0, 0, rad(45)), OURO, NEON)
	for _, lado in { -1, 1 } do
		c.peca("Asa", BLOCO, V3(0.5, 0.1, 0.05) * s, emblemaCF(s) * CF(0.28 * s * lado, 0.12 * s, 0) * ANG(0, 0, rad(30 * lado)), OURO, NEON)
	end
	c.peca("Cauda", BLOCO, V3(0.1, 0.4, 0.05) * s, emblemaCF(s) * CF(0, -0.3 * s, 0), OURO, NEON)
end

function MAOS.tridente(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.peca("Haste", BLOCO, V3(0.1, 2.8, 0.1) * s, CF(hx, hy + 0.5 * s, -0.15 * s), OURO, FOLHA)
	c.peca("Travessa", BLOCO, V3(0.6, 0.08, 0.08) * s, CF(hx, hy + 1.85 * s, -0.15 * s), OURO, FOLHA)
	for k = -1, 1 do
		c.peca("Dente", BLOCO, V3(0.07, 0.45, 0.07) * s, CF(hx + k * 0.27 * s, hy + 2.1 * s, -0.15 * s), OURO, FOLHA)
	end
end
function MAOS.garras(ctx)
	local c, s, hy = ctx.c, ctx.s, ctx.hy
	for _, lado in { -1, 1 } do
		for k = -1, 1 do
			c.peca("Garra", BLOCO, V3(0.04, 0.85, 0.06) * s, CF(ctx.hx * lado + k * 0.1 * s, hy - 0.55 * s, -0.25 * s) * ANG(rad(-25), 0, 0),
				PRATA, METAL)
		end
	end
end
function MAOS.blasters(ctx)
	local c, s, hy = ctx.c, ctx.s, ctx.hy
	for _, lado in { -1, 1 } do
		c.peca("Arma", BLOCO, V3(0.22, 0.3, 0.6) * s, CF(ctx.hx * lado, hy, -0.35 * s), Color3.fromRGB(70, 75, 85), METAL)
		c.peca("Cano", CILINDRO, V3(0.4, 0.14, 0.14) * s, CF(ctx.hx * lado, hy + 0.05 * s, -0.75 * s) * DE_FRENTE, PRETO)
		c.peca("LuzArma", BLOCO, V3(0.06, 0.06, 0.3) * s, CF(ctx.hx * lado + 0.12 * s * lado, hy + 0.05 * s, -0.4 * s), Color3.fromRGB(80, 200, 255), NEON)
	end
end
function MAOS.prancha(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.elipse("Prancha", V3(0.22, 3.0, 1.0) * s, CF(hx + 0.35 * s, hy - 0.1 * s, 0.2 * s), PRATA, FOLHA)
end
function MAOS.anelVerde(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	local brilho = c.peca("Energia", BOLA, V3(0.45, 0.45, 0.45) * s, CF(hx, hy - 0.05 * s, -0.3 * s), Color3.fromRGB(60, 255, 120), NEON,
		{ transparencia = 0.2 })
	local luz = Instance.new("PointLight")
	luz.Color = Color3.fromRGB(60, 255, 120)
	luz.Range = 8
	luz.Brightness = 2
	luz.Parent = brilho
end
function MAOS.magia(ctx)
	local c, s, hy = ctx.c, ctx.s, ctx.hy
	for _, lado in { -1, 1 } do
		c.peca("CirculoMagico", CILINDRO, V3(0.04, 0.9, 0.9) * s, CF(ctx.hx * lado, hy, -0.4 * s) * DE_FRENTE, Color3.fromRGB(255, 150, 30), NEON,
			{ transparencia = 0.2 })
	end
end
function MAOS.energiaVermelha(ctx)
	local c, s, hy = ctx.c, ctx.s, ctx.hy
	for _, lado in { -1, 1 } do
		local bola = c.peca("Energia", BOLA, V3(0.5, 0.5, 0.5) * s, CF(ctx.hx * lado, hy - 0.05 * s, -0.3 * s), Color3.fromRGB(255, 30, 70), NEON,
			{ transparencia = 0.25 })
		local p = Instance.new("ParticleEmitter")
		p.Color = ColorSequence.new(Color3.fromRGB(255, 40, 90))
		p.LightEmission = 1
		p.Rate = 10
		p.Lifetime = NumberRange.new(0.4, 0.8)
		p.Speed = NumberRange.new(0.5, 1.5)
		p.Size = NumberSequence.new(0.3 * s, 0)
		p.Parent = bola
	end
end
function MAOS.raios(ctx)
	local c, s, hy = ctx.c, ctx.s, ctx.hy
	for _, lado in { -1, 1 } do
		c.peca("Raio", BOLA, V3(0.45, 0.45, 0.45) * s, CF(ctx.hx * lado, hy - 0.05 * s, -0.3 * s), Color3.fromRGB(220, 240, 255), NEON,
			{ transparencia = 0.15 })
	end
end
function MAOS.punhoEnergia(ctx)
	local c, s, hy = ctx.c, ctx.s, ctx.hy
	for _, lado in { -1, 1 } do
		c.peca("Energia", BOLA, V3(0.55, 0.55, 0.55) * s, CF(ctx.hx * lado, hy - 0.05 * s, -0.05 * s), Color3.fromRGB(255, 200, 60), NEON,
			{ transparencia = 0.35 })
	end
end
function MAOS.chicote(ctx)
	local c, s, hx, hy = ctx.c, ctx.s, ctx.hx, ctx.hy
	c.anel("Chicote", 0.3 * s, 10, V3(0.08, 0.2, 0.08) * s, CF(hx + 0.1 * s, hy - 0.35 * s, -0.2 * s) * ANG(0, rad(90), 0),
		{ Color3.fromRGB(40, 30, 30) })
	c.peca("PontaChicote", BLOCO, V3(0.06, 1.0, 0.06) * s, CF(hx + 0.1 * s, hy - 1.05 * s, -0.2 * s), Color3.fromRGB(40, 30, 30))
end
function MAOS_ESQUERDA.arco(ctx)
	local c, s = ctx.c, ctx.s
	local base = CF(-ctx.hx, ctx.hy + 0.2 * s, -0.3 * s)
	local madeira = Color3.fromRGB(110, 70, 40)
	c.peca("ArcoMeio", BLOCO, V3(0.1, 0.9, 0.12) * s, base, madeira)
	c.peca("ArcoCima", BLOCO, V3(0.1, 0.9, 0.12) * s, base * CF(0, 0.82 * s, 0.18 * s) * ANG(rad(25), 0, 0), madeira)
	c.peca("ArcoBaixo", BLOCO, V3(0.1, 0.9, 0.12) * s, base * CF(0, -0.82 * s, 0.18 * s) * ANG(rad(-25), 0, 0), madeira)
	c.peca("Corda", BLOCO, V3(0.03, 2.3, 0.03) * s, base * CF(0, 0, 0.42 * s), BRANCO)
end

function COSTAS.aljava(ctx)
	local c, s = ctx.c, ctx.s
	c.peca("Aljava", CILINDRO, V3(1.3, 0.4, 0.4) * s, CF(0.3 * s, 0.2 * s, 0.62 * s) * ANG(0, 0, rad(70)), Color3.fromRGB(110, 70, 40))
	for k = -1, 1 do
		c.peca("Flecha", BLOCO, V3(0.05, 0.5, 0.05) * s, CF((0.55 + k * 0.07) * s, 0.95 * s, 0.62 * s) * ANG(0, 0, rad(-20)), Color3.fromRGB(230, 40, 40))
	end
end
function COSTAS.espadas(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		c.peca("Espada", BLOCO, V3(0.1, 2.0, 0.06) * s, CF(0, 0.3 * s, 0.55 * s) * ANG(0, 0, rad(30 * lado)), PRATA, METAL)
		c.peca("Cabo", BLOCO, V3(0.14, 0.45, 0.12) * s, CF(0.55 * s * lado, 1.25 * s, 0.55 * s) * ANG(0, 0, rad(30 * lado)), PRETO)
	end
end
function COSTAS.asasMetal(ctx)
	local c, s = ctx.c, ctx.s
	for _, lado in { -1, 1 } do
		for k = 0, 2 do
			c.peca("Pena", BLOCO, V3(1.6 - k * 0.3, 0.32, 0.08) * s,
				CF((1.0 + k * 0.1) * s * lado, (0.45 - k * 0.35) * s, 0.6 * s) * ANG(0, 0, rad((22 - k * 12) * lado)),
				k == 0 and Color3.fromRGB(200, 40, 40) or PRATA, METAL)
		end
	end
end

local function capa(ctx, cor, material)
	local c, s = ctx.c, ctx.s
	c.peca("Capa", BLOCO, V3(1.5 * ctx.L, 2.35, 0.12) * s, CF(0, -0.3 * s, 0.56 * s) * ANG(rad(10), 0, 0), cor, material)
	c.peca("Gola", BLOCO, V3(1.65 * ctx.L, 0.2, 0.95) * s, CF(0, 0.78 * s, 0), cor, material)
end

--------------------------------------------------------------------------
-- HERÓI COMPLETO
--------------------------------------------------------------------------
-- opcoes: { semPlaca = true, escala = número, formatar = função }
function Modelos.heroi(def, mutacao, Config, opcoes)
	opcoes = opcoes or {}
	local raridade = Config.RaridadePorId[def.raridade]
	local s = opcoes.escala or raridade.escala
	local v = def.visual
	local L = v.largo and 1.25 or 1

	local camisa, calca = v.camisa, v.calca
	local mangas = v.mangas or v.camisa
	local MATERIAIS = { Metal = METAL, Neon = NEON, Concrete = Enum.Material.Slate, Foil = FOLHA }
	local material = MATERIAIS[v.material or ""] or LISO
	local corCapa = v.capa
	if mutacao.id == "Ouro" then
		camisa, calca, mangas, material = mutacao.cor, mutacao.cor, mutacao.cor, FOLHA
	elseif mutacao.id == "Diamante" then
		camisa, calca, mangas, material = mutacao.cor, mutacao.cor:Lerp(BRANCO, 0.3), mutacao.cor, VIDRO
	elseif mutacao.id == "Cosmico" then
		camisa, calca, mangas, material = Color3.fromRGB(50, 0, 110), Color3.fromRGB(30, 0, 70), Color3.fromRGB(50, 0, 110), NEON
		corCapa = corCapa and mutacao.cor
	end
	local vMut = setmetatable({ camisa = camisa }, { __index = v })

	local modelo = Instance.new("Model")
	modelo.Name = def.nome
	modelo:SetAttribute("HeroiId", def.id)
	modelo:SetAttribute("Mutacao", mutacao.id)

	local raiz = novaRaiz(modelo, "Tronco", V3(1.6 * L, 1.6, 0.9) * s, camisa, material)
	raiz:SetAttribute("Pintavel", true)
	local c = novoConstrutor(modelo, raiz)
	local yC = 1.32 * s
	local ctx = { c = c, s = s, L = L, yC = yC, hx = 1.15 * s * L, hy = -0.72 * s, v = vMut, raiz = raiz, rostoFeito = false }

	-- Corpo base
	local pele = v.pele
	local botas = v.botas or PRETO
	local maos = v.maos or pele
	for _, lado in { -1, 1 } do
		c.peca("Perna", BLOCO, V3(0.6 * L, 1.2, 0.6) * s, CF(0.42 * s * L * lado, -1.4 * s, 0), calca, material, { pintavel = true })
		c.peca("Bota", BLOCO, V3(0.68 * L, 0.45, 0.78) * s, CF(0.42 * s * L * lado, -1.8 * s, -0.05 * s), botas)
		c.peca("Braco", BLOCO, V3(0.45 * L, 1.4, 0.45 * L) * s, CF(1.05 * s * L * lado, 0.05 * s, 0) * ANG(0, 0, rad(8 * lado)),
			mangas, material, { pintavel = mangas == camisa })
		c.peca("Mao", BOLA, V3(0.5, 0.5, 0.5) * s * L, CF(1.15 * s * L * lado, -0.72 * s, 0), maos)
	end
	c.peca("Cabeca", BOLA, V3(1.1, 1.1, 1.1) * s, CF(0, yC, 0), pele, v.material == "Neon" and NEON or (v.material == "Foil" and FOLHA or LISO))

	-- Corpo, cabeça, rosto, emblema, mãos e costas
	for _, nome in v.corpo or {} do
		CORPO[nome](ctx)
	end
	if v.emblema then
		EMBLEMAS[v.emblema](ctx)
	end
	if corCapa then
		capa(ctx, corCapa, mutacao.id == "Cosmico" and NEON or LISO)
	end
	if v.cabeca then
		CABECAS[v.cabeca](ctx)
	end
	if not CABECAS_SEM_ROSTO[v.cabeca or ""] and not ctx.rostoFeito then
		olhosEBoca(ctx)
		if v.rosto then
			ROSTOS[v.rosto](ctx)
		end
	end
	if v.mao then
		MAOS[v.mao](ctx)
	end
	if v.maoEsquerda then
		MAOS_ESQUERDA[v.maoEsquerda](ctx)
	end
	if v.costas then
		COSTAS[v.costas](ctx)
	end

	if v.transparencia then
		for _, p in modelo:GetChildren() do
			if p:IsA("BasePart") and (p:GetAttribute("Pintavel") or p.Name == "Cabeca" or p.Name == "Mao" or p.Name == "Bota" or p.Name == "Cabelo") then
				p.Transparency = v.transparencia
			end
		end
	end

	-- Efeitos das raridades altas e mutações
	if raridade.ordem >= Config.RaridadePorId.Lendario.ordem then
		local luz = Instance.new("PointLight")
		luz.Color = raridade.cor
		luz.Range = 10
		luz.Brightness = 1.5
		luz.Parent = raiz
	end
	if def.raridade == "Divino" then
		c.peca("Aureola", CILINDRO, V3(0.12, 1.3, 1.3) * s, CF(0, yC + 1.05 * s, 0) * EM_PE, Color3.fromRGB(255, 240, 150), NEON)
	end
	if def.raridade == "Secreto" or mutacao.id == "Cosmico" then
		local particulas = Instance.new("ParticleEmitter")
		particulas.Color = def.raridade == "Secreto"
				and ColorSequence.new(Color3.fromRGB(0, 0, 0), Color3.fromRGB(0, 255, 200))
			or ColorSequence.new(Color3.fromRGB(150, 70, 255), Color3.fromRGB(255, 120, 255))
		particulas.LightEmission = 0.6
		particulas.Rate = 14
		particulas.Lifetime = NumberRange.new(0.8, 1.6)
		particulas.Speed = NumberRange.new(1, 3)
		particulas.SpreadAngle = Vector2.new(180, 180)
		particulas.Size = NumberSequence.new(0.5 * s, 0)
		particulas.Parent = raiz
	end
	if mutacao.id == "ArcoIris" then
		CollectionService:AddTag(modelo, "HeroiArcoIris")
	end

	if not opcoes.semPlaca then
		local formatar = Config.formatar
		local placa = Instance.new("BillboardGui")
		placa.Name = "Info"
		placa.Size = UDim2.fromOffset(240, 96)
		placa.StudsOffset = Vector3.new(0, 2.9 * s + 1.4, 0)
		placa.MaxDistance = 70
		placa.LightInfluence = 0
		placa.Parent = raiz
		local layout = Instance.new("UIListLayout")
		layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = placa
		local function linha(ordem, texto, cor, fonte)
			local rotulo = Instance.new("TextLabel")
			rotulo.LayoutOrder = ordem
			rotulo.Size = UDim2.new(1, 0, 0, 23)
			rotulo.BackgroundTransparency = 1
			rotulo.Text = texto
			rotulo.TextColor3 = cor
			rotulo.Font = fonte or Enum.Font.FredokaOne
			rotulo.TextScaled = true
			rotulo.TextStrokeTransparency = 0
			rotulo.Parent = placa
			return rotulo
		end
		if mutacao.id ~= "Normal" then
			local rotulo = linha(1, "✦ " .. mutacao.nome .. " ✦", mutacao.cor)
			if mutacao.id == "ArcoIris" then
				rotulo.Name = "TextoArcoIris"
			end
		end
		linha(2, def.nome, Color3.new(1, 1, 1))
		linha(3, raridade.nome, raridade.cor)
		linha(4, formatar(def.preco * mutacao.multiplicador) .. "  •  +" .. formatar(def.renda * mutacao.multiplicador) .. "/s",
			Color3.fromRGB(110, 255, 130), Enum.Font.GothamBold)
	end

	return modelo, raiz
end

--------------------------------------------------------------------------
-- LUVA (estilo luva de boxe). A raiz fica no centro da mão; os dedos
-- apontam para -Y e o punho (pulso) sobe para +Y.
--------------------------------------------------------------------------
function Modelos.luva(def, escala)
	local modelo = Instance.new("Model")
	modelo.Name = "Luva" .. def.id
	local material = def.material == "Metal" and METAL or (def.material == "Neon" and NEON or LISO)
	local raiz = novaRaiz(modelo, "Luva", V3(1.15, 1.35, 1.2), def.cor, material)
	local malha = Instance.new("SpecialMesh")
	malha.MeshType = Enum.MeshType.Sphere
	malha.Parent = raiz
	local c = novoConstrutor(modelo, raiz)
	local escura = def.cor:Lerp(PRETO, 0.25)

	c.elipse("Nos", V3(1.0, 0.62, 0.55), CF(0, -0.38, -0.35), escura, material)
	c.elipse("Polegar", V3(0.42, 0.78, 0.5), CF(-0.52, 0.05, -0.28) * ANG(0, 0, rad(18)), def.cor, material)
	c.peca("Punho", CILINDRO, V3(0.65, 1.0, 1.0), CF(0, 0.78, 0) * EM_PE, def.corPunho or BRANCO)
	c.peca("Faixa", CILINDRO, V3(0.16, 1.05, 1.05), CF(0, 0.6, 0) * EM_PE, def.corDetalhe or VERMELHO, def.neon and NEON or LISO)
	c.peca("FaixaTopo", CILINDRO, V3(0.1, 1.03, 1.03), CF(0, 1.05, 0) * EM_PE, def.corDetalhe or VERMELHO, def.neon and NEON or LISO)
	for k = 0, 2 do
		c.peca("Cadarco", BLOCO, V3(0.42, 0.06, 0.06), CF(0, 0.62 + k * 0.17, 0.52), BRANCO)
	end
	c.peca("Emblema", BLOCO, V3(0.3, 0.3, 0.06), CF(0, -0.05, 0.58) * ANG(0, 0, rad(45)), def.corDetalhe or OURO, NEON)
	if def.particulas then
		local p = Instance.new("ParticleEmitter")
		p.Color = ColorSequence.new(def.particulas)
		p.LightEmission = 1
		p.Rate = 12
		p.Lifetime = NumberRange.new(0.4, 0.8)
		p.Speed = NumberRange.new(0.5, 1.5)
		p.SpreadAngle = Vector2.new(180, 180)
		p.Size = NumberSequence.new(0.35, 0)
		p.Parent = raiz
	end
	if def.neon then
		local luz = Instance.new("PointLight")
		luz.Color = def.corDetalhe or def.cor
		luz.Range = 6
		luz.Brightness = 1.2
		luz.Parent = raiz
	end
	-- Na mão do jogador a luva fica maior, para o punho cobrir o braço
	if escala and escala ~= 1 then
		for _, parte in modelo:GetDescendants() do
			if parte:IsA("BasePart") then
				parte.Size *= escala
				parte.CFrame = CF(parte.CFrame.Position * escala) * parte.CFrame.Rotation
			end
		end
	end
	return modelo, raiz
end

--------------------------------------------------------------------------
-- MOLA (enfeite da loja): espiral de bolinhas metálicas
--------------------------------------------------------------------------
function Modelos.mola()
	local modelo = Instance.new("Model")
	modelo.Name = "Mola"
	local raiz = novaRaiz(modelo, "Base", V3(1.4, 0.2, 1.4), Color3.fromRGB(60, 60, 70), METAL)
	local c = novoConstrutor(modelo, raiz)
	local voltas, pontos = 5, 60
	for i = 0, pontos do
		local t = i / pontos
		local a = t * voltas * math.pi * 2
		c.peca("Espira", BOLA, V3(0.22, 0.22, 0.22), CF(math.cos(a) * 0.5, 0.15 + t * 1.8, math.sin(a) * 0.5),
			Color3.fromRGB(80, 220, 255), METAL)
	end
	c.peca("Topo", CILINDRO, V3(0.12, 1.2, 1.2), CF(0, 2.0, 0) * EM_PE, Color3.fromRGB(255, 200, 40), METAL)
	return modelo, raiz
end

return Modelos
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="8">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="9">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="10">
        <Properties>
          <string name="Name">InterfaceHerois</string>
          <string name="Source"><![CDATA[--[[
	ROUBE UM HERÓI - Interface do jogador

	Onde colocar: StarterPlayer -> StarterPlayerScripts -> LocalScript (nome: InterfaceHerois)

	Cria toda a interface: dinheiro, menus (Loja, Índice, Ranking, Renascer,
	Diário, Configurações), tutorial, notificações, anúncios, alarme de roubo,
	seta até a base, música, sons e efeitos visuais.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local CollectionService = game:GetService("CollectionService")
local MarketplaceService = game:GetService("MarketplaceService")
local HttpService = game:GetService("HttpService")
local Debris = game:GetService("Debris")

local jogador = Players.LocalPlayer
local playerGui = jogador:WaitForChild("PlayerGui")
local Config = require(ReplicatedStorage:WaitForChild("ConfigHerois"))
local remotes = ReplicatedStorage:WaitForChild("RemotesHerois")
local Notificar = remotes:WaitForChild("Notificar")
local Anuncio = remotes:WaitForChild("Anuncio")
local Efeito = remotes:WaitForChild("Efeito")
local Empurrao = remotes:WaitForChild("Empurrao")
local Acao = remotes:WaitForChild("Acao")
local ObterRanking = remotes:WaitForChild("ObterRanking")
local AbrirLoja = remotes:WaitForChild("AbrirLoja")
local RoletaGiro = remotes:WaitForChild("RoletaGiro")

local formatar = Config.formatar

--------------------------------------------------------------------------
-- ESTILO
--------------------------------------------------------------------------
local COR = {
	fundo = Color3.fromRGB(26, 28, 42),
	fundo2 = Color3.fromRGB(40, 44, 64),
	fundo3 = Color3.fromRGB(52, 57, 82),
	texto = Color3.fromRGB(255, 255, 255),
	cinza = Color3.fromRGB(170, 175, 195),
	desligado = Color3.fromRGB(95, 100, 120),
	amarelo = Color3.fromRGB(255, 196, 0),
	laranja = Color3.fromRGB(255, 130, 30),
	verde = Color3.fromRGB(60, 210, 100),
	vermelho = Color3.fromRGB(235, 70, 70),
	azul = Color3.fromRGB(70, 150, 255),
	roxo = Color3.fromRGB(150, 90, 255),
	rosa = Color3.fromRGB(255, 100, 180),
	ciano = Color3.fromRGB(40, 200, 220),
}
local FONTE_TITULO = Enum.Font.FredokaOne
local FONTE = Enum.Font.GothamBold
local FONTE_TEXTO = Enum.Font.GothamMedium
local MEDALHAS = { Color3.fromRGB(255, 200, 40), Color3.fromRGB(205, 205, 220), Color3.fromRGB(215, 135, 70) }

local function criar(classe, propriedades, filhos)
	local objeto = Instance.new(classe)
	local pai = nil
	for nome, valor in propriedades or {} do
		if nome == "Parent" then
			pai = valor
		else
			(objeto :: any)[nome] = valor
		end
	end
	for _, filho in filhos or {} do
		filho.Parent = objeto
	end
	if pai then
		objeto.Parent = pai
	end
	return objeto
end

local function canto(raio)
	return criar("UICorner", { CornerRadius = UDim.new(0, raio or 12) })
end

local function borda(cor, espessura, transparencia)
	return criar("UIStroke", {
		Color = cor,
		Thickness = espessura or 2,
		Transparency = transparencia or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function contornoTexto(espessura)
	return criar("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = espessura or 2, Transparency = 0.15 })
end

local function gradiente(cor1, cor2, rotacao)
	return criar("UIGradient", { Color = ColorSequence.new(cor1, cor2), Rotation = rotacao or 90 })
end

local function sombreado()
	return gradiente(Color3.new(1, 1, 1), Color3.fromRGB(175, 175, 190), 90)
end

local function limiteTexto(maximo)
	return criar("UITextSizeConstraint", { MaxTextSize = maximo })
end

local function rotulo(propriedades, filhos)
	local base = {
		BackgroundTransparency = 1,
		Font = FONTE,
		TextColor3 = COR.texto,
		TextScaled = true,
		Size = UDim2.fromScale(1, 1),
	}
	for nome, valor in propriedades do
		base[nome] = valor
	end
	return criar("TextLabel", base, filhos)
end

--------------------------------------------------------------------------
-- SONS E MÚSICA
--------------------------------------------------------------------------
local configLocal = { musica = true, sons = true }
local sons = {}
local function criarSom(nome, id, volume, velocidade)
	if id and id ~= "" then
		sons[nome] = criar("Sound", { Name = "Som" .. nome, SoundId = id, Volume = volume, PlaybackSpeed = velocidade or 1, Parent = SoundService })
	end
end
criarSom("clique", Config.Sons.Clique, 0.35, 1.2)
criarSom("notificacao", Config.Sons.Notificacao, 0.4)
criarSom("moeda", Config.Sons.Moeda, 0.45, 1.6)
criarSom("compra", Config.Sons.Compra, 0.55, 1.25)
criarSom("alarme", Config.Sons.Alarme, 0.7, 0.55)
criarSom("erro", Config.Sons.Erro, 0.4, 0.6)

local function tocar(nome)
	local som = sons[nome]
	if som and configLocal.sons then
		SoundService:PlayLocalSound(som)
	end
end

local musica = nil
if Config.Sons.Musica ~= "" then
	musica = criar("Sound", { Name = "MusicaDeFundo", SoundId = Config.Sons.Musica, Looped = true, Volume = Config.Sons.VolumeMusica, Parent = SoundService })
end
local function aplicarMusica()
	if not musica then
		return
	end
	if configLocal.musica then
		if not musica.IsPlaying then
			musica:Play()
		end
	else
		musica:Stop()
	end
end

local function atributo(nome, padrao)
	local valor = jogador:GetAttribute(nome)
	if valor == nil then
		return padrao
	end
	return valor
end

local function invocar(acao, argumento)
	local ok, sucesso, mensagem = pcall(function()
		return Acao:InvokeServer(acao, argumento)
	end)
	if not ok then
		return false, "Erro de conexão. Tente de novo!"
	end
	return sucesso, mensagem
end

--------------------------------------------------------------------------
-- TELA PRINCIPAL
--------------------------------------------------------------------------
local gui = criar("ScreenGui", {
	Name = "InterfaceHerois",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = playerGui,
})

-- Clarão vermelho do alarme (fica atrás de tudo e não bloqueia cliques)
local telaAlarme = criar("Frame", {
	Name = "Alarme",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = COR.vermelho,
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Parent = gui,
})

--------------------------------------------------------------------------
-- NOTIFICAÇÕES (canto direito) E ANÚNCIOS (centro)
--------------------------------------------------------------------------
local CORES_TIPO = { sucesso = COR.verde, erro = COR.vermelho, aviso = COR.amarelo, info = COR.azul, especial = COR.roxo }
local areaNotificacoes = criar("Frame", {
	Name = "Notificacoes",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -12, 0.8, 0),
	Size = UDim2.fromOffset(340, 330),
	BackgroundTransparency = 1,
	ZIndex = 30,
	Parent = gui,
}, {
	criar("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
	}),
})
local contadorNotificacao = 0

local function notificar(mensagem, tipo)
	if not mensagem or mensagem == "" then
		return
	end
	contadorNotificacao += 1
	local cor = CORES_TIPO[tipo] or COR.azul
	local caixa = criar("Frame", {
		LayoutOrder = contadorNotificacao,
		Size = UDim2.fromOffset(340, 48),
		BackgroundColor3 = COR.fundo,
		BackgroundTransparency = 0.05,
		Parent = areaNotificacoes,
	}, { canto(12) })
	local contorno = borda(cor, 2)
	contorno.Parent = caixa
	criar("Frame", { Size = UDim2.new(0, 6, 1, -14), Position = UDim2.fromOffset(7, 7), BackgroundColor3 = cor, BorderSizePixel = 0, Parent = caixa }, { canto(3) })
	local texto = rotulo({
		Text = mensagem,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Size = UDim2.new(1, -28, 1, -10),
		Position = UDim2.fromOffset(20, 5),
		Parent = caixa,
	}, { limiteTexto(17) })
	local escala = criar("UIScale", { Scale = 0.6, Parent = caixa })
	TweenService:Create(escala, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	tocar(tipo == "erro" and "erro" or "notificacao")

	local caixas = {}
	for _, filho in areaNotificacoes:GetChildren() do
		if filho:IsA("Frame") then
			table.insert(caixas, filho)
		end
	end
	table.sort(caixas, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i = 1, #caixas - 5 do
		caixas[i]:Destroy()
	end

	task.delay(4, function()
		if not caixa.Parent then
			return
		end
		local info = TweenInfo.new(0.35)
		TweenService:Create(caixa, info, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(texto, info, { TextTransparency = 1 }):Play()
		TweenService:Create(contorno, info, { Transparency = 1 }):Play()
		task.wait(0.35)
		caixa:Destroy()
	end)
end

local faixaAnuncio = criar("Frame", {
	Name = "Anuncio",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.26),
	Size = UDim2.new(0.62, 0, 0, 62),
	BackgroundColor3 = COR.fundo,
	BackgroundTransparency = 0.08,
	Visible = false,
	ZIndex = 25,
	Parent = gui,
}, { canto(16), criar("UISizeConstraint", { MaxSize = Vector2.new(780, 62) }) })
local bordaAnuncio = borda(COR.amarelo, 3)
bordaAnuncio.Parent = faixaAnuncio
local textoAnuncio = rotulo({
	Font = FONTE_TITULO,
	Size = UDim2.new(1, -24, 1, -14),
	Position = UDim2.fromOffset(12, 7),
	Parent = faixaAnuncio,
}, { contornoTexto(2) })
local escalaAnuncio = criar("UIScale", { Parent = faixaAnuncio })
local idAnuncio = 0

local function anunciar(mensagem, cor, duracao)
	idAnuncio += 1
	local meuId = idAnuncio
	cor = cor or COR.amarelo
	textoAnuncio.Text = mensagem
	textoAnuncio.TextColor3 = cor
	bordaAnuncio.Color = cor
	faixaAnuncio.Visible = true
	escalaAnuncio.Scale = 0.4
	TweenService:Create(escalaAnuncio, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	tocar("notificacao")
	task.delay(duracao or 4.5, function()
		if idAnuncio == meuId then
			faixaAnuncio.Visible = false
		end
	end)
end

--------------------------------------------------------------------------
-- BOTÕES
--------------------------------------------------------------------------
local function animarBotao(botao)
	local escala = criar("UIScale", { Parent = botao })
	local function para(valor, tempo)
		TweenService:Create(escala, TweenInfo.new(tempo), { Scale = valor }):Play()
	end
	botao.MouseEnter:Connect(function()
		para(1.06, 0.12)
	end)
	botao.MouseLeave:Connect(function()
		para(1, 0.12)
	end)
	botao.MouseButton1Down:Connect(function()
		para(0.93, 0.06)
	end)
	botao.MouseButton1Up:Connect(function()
		para(1.06, 0.08)
	end)
end

local function botao(propriedades, aoClicar)
	local cor = propriedades.Cor or COR.azul
	local base = {
		AutoButtonColor = false,
		BackgroundColor3 = cor,
		Font = FONTE_TITULO,
		TextColor3 = COR.texto,
		TextScaled = true,
		Text = "",
		Size = UDim2.fromOffset(120, 44),
	}
	for nome, valor in propriedades do
		if nome ~= "Cor" then
			base[nome] = valor
		end
	end
	local b = criar("TextButton", base, {
		canto(12),
		sombreado(),
		contornoTexto(2),
		criar("UIPadding", {
			PaddingTop = UDim.new(0, 6),
			PaddingBottom = UDim.new(0, 6),
			PaddingLeft = UDim.new(0, 8),
			PaddingRight = UDim.new(0, 8),
		}),
	})
	animarBotao(b)
	if aoClicar then
		b.Activated:Connect(function()
			tocar("clique")
			aoClicar()
		end)
	end
	return b
end

--------------------------------------------------------------------------
-- PAINÉIS (janelas)
--------------------------------------------------------------------------
local paineis = {}
local painelAberto = nil

local fundoEscuro = criar("TextButton", {
	Name = "FundoEscuro",
	Text = "",
	AutoButtonColor = false,
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 1,
	Visible = false,
	ZIndex = 8,
	Parent = gui,
})

local function fecharPainel()
	local nome = painelAberto
	if not nome then
		return
	end
	local painel = paineis[nome]
	painelAberto = nil
	fundoEscuro.Visible = false
	TweenService:Create(painel.escala, TweenInfo.new(0.12), { Scale = 0.8 }):Play()
	task.delay(0.12, function()
		if painelAberto ~= nome then
			painel.quadro.Visible = false
		end
	end)
	if painel.aoFechar then
		painel.aoFechar()
	end
end

local function abrirPainel(nome)
	if painelAberto == nome then
		fecharPainel()
		return
	end
	if painelAberto then
		local anterior = paineis[painelAberto]
		anterior.quadro.Visible = false
		if anterior.aoFechar then
			anterior.aoFechar()
		end
	end
	local painel = paineis[nome]
	painelAberto = nome
	if painel.aoAbrir then
		painel.aoAbrir()
	end
	fundoEscuro.Visible = true
	fundoEscuro.BackgroundTransparency = 1
	TweenService:Create(fundoEscuro, TweenInfo.new(0.2), { BackgroundTransparency = 0.55 }):Play()
	painel.quadro.Visible = true
	painel.escala.Scale = 0.75
	TweenService:Create(painel.escala, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

fundoEscuro.Activated:Connect(fecharPainel)

local function criarPainel(nome, titulo, cor)
	local quadro = criar("Frame", {
		Name = "Painel" .. nome,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.53),
		Size = UDim2.fromScale(0.62, 0.7),
		BackgroundColor3 = COR.fundo,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	}, {
		canto(20),
		borda(cor, 3),
		criar("UISizeConstraint", { MinSize = Vector2.new(330, 280), MaxSize = Vector2.new(720, 520) }),
	})
	local escala = criar("UIScale", { Parent = quadro })

	local faixa = criar("Frame", { Name = "Titulo", Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = cor, Parent = quadro }, {
		canto(20),
		gradiente(Color3.new(1, 1, 1), Color3.fromRGB(160, 160, 170), 90),
	})
	criar("Frame", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		BackgroundColor3 = cor,
		BorderSizePixel = 0,
		Parent = faixa,
	}, { gradiente(Color3.fromRGB(198, 198, 205), Color3.fromRGB(160, 160, 170), 90) })
	rotulo({
		Text = titulo,
		Font = FONTE_TITULO,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, -80, 0, 38),
		Position = UDim2.fromOffset(18, 9),
		ZIndex = 2,
		Parent = faixa,
	}, { contornoTexto(2.5) })
	botao({
		Text = "✕",
		Cor = COR.vermelho,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(42, 42),
		ZIndex = 2,
		Parent = faixa,
	}, fecharPainel)

	local corpo = criar("Frame", {
		Name = "Corpo",
		Position = UDim2.fromOffset(16, 68),
		Size = UDim2.new(1, -32, 1, -82),
		BackgroundTransparency = 1,
		Parent = quadro,
	})
	local painel = { nome = nome, quadro = quadro, escala = escala, corpo = corpo }
	paineis[nome] = painel
	return painel
end

local function listaRolavel(pai, propriedades)
	local base = {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = COR.cinza,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = pai,
	}
	for nome, valor in propriedades or {} do
		base[nome] = valor
	end
	return criar("ScrollingFrame", base, { criar("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 4) }) })
end

local function barraProgresso(pai, posicao, tamanho, cor)
	local fundo = criar("Frame", { Position = posicao, Size = tamanho, BackgroundColor3 = COR.fundo3, Parent = pai }, { canto(8) })
	local preenchimento = criar("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = cor, Parent = fundo }, { canto(8), sombreado() })
	local texto = rotulo({ Text = "", Size = UDim2.new(1, -10, 1, -4), Position = UDim2.fromOffset(5, 2), ZIndex = 2, Parent = fundo }, { contornoTexto(1.5) })
	return function(fracao, rotuloTexto)
		fracao = math.clamp(fracao, 0, 1)
		TweenService:Create(preenchimento, TweenInfo.new(0.25), { Size = UDim2.fromScale(fracao, 1) }):Play()
		texto.Text = rotuloTexto or ""
	end
end

